@app.get("/semantic-status")
def semantic_status(test_live: bool = False):
    """Safe diagnostics; never returns API-key contents. Live testing is opt-in to avoid quota use."""
    key_present = bool(os.getenv("GEMINI_API_KEY") or os.getenv("GOOGLE_API_KEY"))
    status = {
        "enabled": bool(answer_with_context is not None and key_present),
        "ok": bool(answer_with_context is not None and key_present and SEMANTIC_IMPORT_ERROR is None),
        "import_ok": answer_with_context is not None,
        "api_key_present": key_present,
        "key_source": "GEMINI_API_KEY" if os.getenv("GEMINI_API_KEY") else ("GOOGLE_API_KEY" if os.getenv("GOOGLE_API_KEY") else None),
        "models": list(SEMANTIC_MODELS or []),
        "live_test_performed": False,
        "reason": None,
        "error": SEMANTIC_IMPORT_ERROR,
    }
    if answer_with_context is None:
        status["reason"] = "semantic_import_failed"
    elif not key_present:
        status["reason"] = "api_key_missing"
    elif test_live:
        try:
            from services import semantic_query_service as _semantic_module
            _semantic_module._llm("Reply with JSON only.", "Return {\"ok\":true} and nothing else.", True)
            status.update(ok=True, live_test_performed=True, reason=None, error=None)
        except Exception as exc:
            status.update(ok=False, live_test_performed=True, reason="live_gemini_test_failed",
                          error=f"{type(exc).__name__}: {str(exc)[:400]}")
    else:
        status["reason"] = "configured_not_live_tested" if status["ok"] else status["reason"]
    return status

