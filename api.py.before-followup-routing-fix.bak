# DYNAMIC DATASET HISTORY
# ============================================================

@app.get("/datasets")
def list_datasets():
    try:
        result = get_all_uploaded_datasets()

        # The service already returns the complete API response.
        # Return it directly instead of nesting it again.
        if isinstance(result, dict) and isinstance(
            result.get("datasets"), list
        ):
            return result

        # Safe fallback if the service returns a plain list.
        if isinstance(result, list):
            return {
                "success": True,
                "datasets": result,
                "count": len(result),
            }

        return {
            "success": False,
            "datasets": [],
            "count": 0,
            "message": "Unexpected dataset-list response format.",
        }

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

