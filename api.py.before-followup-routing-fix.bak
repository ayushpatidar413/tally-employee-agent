@app.post("/conversations")
def create_new_conversation(
    request: CreateConversationRequest,
):
    try:
        conversation_id = create_conversation(
            title=request.title
        )
        return {
            "success": True,
            "conversation_id": conversation_id,
            "title": request.title,
        }
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )
@app.get("/conversations")
def list_conversations():
    try:
        conversations = get_conversations()
        return {
            "success": True,
            "conversations": conversations,
        }
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )
@app.get("/conversations/{conversation_id}")
def get_conversation_details(
    conversation_id: str,
):
    try:
        conversation = get_conversation(
            conversation_id
        )
        if not conversation:
            raise HTTPException(
                status_code=404,
                detail="Conversation not found.",
            )
        messages = get_messages(
            conversation_id
        )
        return {
            "success": True,
            "conversation": conversation,
            "messages": messages,
        }
    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )
@app.delete("/conversations/{conversation_id}")
def remove_conversation(
    conversation_id: str,
):
    try:
        deleted = delete_conversation(
            conversation_id
        )
        if not deleted:
            raise HTTPException(
                status_code=404,
                detail="Conversation not found.",
            )
        return {
            "success": True,
            "message": "Conversation deleted successfully.",
        }
    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )
# ============================================================
# LEGACY HR AGENT
# ============================================================
@app.post("/ask")
def ask_hr_agent(request: AskRequest):
    try:
        query = request.query.strip()
        if not query:
            raise HTTPException(
                status_code=400,
                detail="Query cannot be empty.",
            )
        result = supervisor_graph.invoke(
            {
                "question": query,
            }
        )
        answer = result.get(
            "answer",
            result.get(
                "final_answer",
                "No answer generated.",
            ),
        )
        # ----------------------------------------------------
        # Save chat message if conversation is supplied
        # ----------------------------------------------------
        if request.conversation_id:
            try:
                save_message(
                    conversation_id=request.conversation_id,
                    role="user",
                    message=query,
                )
                save_message(
                    conversation_id=request.conversation_id,
                    role="assistant",
                    message=str(answer),
                )
            except Exception as conversation_error:
                print(
                    "[WARNING] Could not save conversation:",
                    conversation_error,
                )
        return {
            "success": True,
            "answer": answer,
            "result": result,
        }
    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )
def is_gst_sales_report_request(query: str) -> bool:
    """
    Detect explicit requests for the specialized
    8-sheet GST Sales Excel report.
    """
    text = query.lower().strip()
    gst_terms = [
        "gst sales report",
        "gst report",
        "gst sales excel",
        "gst report excel",
        "gst sales workbook",
        "gst workbook",
    ]
    report_terms = [
        "generate",
        "create",
        "download",
        "export",
        "make",
        "prepare",
        "excel",
        "xlsx",
        "workbook",
    ]
    has_gst = any(
        term in text
        for term in gst_terms
    )
    has_report_action = any(
        term in text
        for term in report_terms
    )
    return has_gst and has_report_action
# ============================================================
# DYNAMIC BUSINESS AGENT
# ============================================================
def _query_requests_employee_data(query: str) -> bool:
    """Return True for employee/staff/attendance/payroll data requests."""
    return bool(__import__("re").search(
        r"\b(employees?|staff|workers?|payroll|salary|salaries|attendance|hr records?)\b",
        str(query or ""),
        flags=__import__("re").IGNORECASE,
    ))


def _employee_data_is_uploaded() -> bool:
    """Check all uploaded datasets so an unrelated previous answer is never reused."""
    try:
        datasets = get_datasets() or []
    except Exception as exc:
        print("[WARNING] Could not inspect uploaded datasets:", exc)
        return True  # fail open; let the normal query pipeline handle it

    markers = (
        "employee", "staff", "worker", "attendance", "payroll", "salary",
        "department", "designation", "check in", "check out", "leave type",
    )
    for ds in datasets:
        dtype = str(ds.get("data_type") or "").lower()
        filename = str(ds.get("original_filename") or "").lower()
        columns = ds.get("columns") or []
        names = []
        for col in columns:
            if isinstance(col, dict):
                names.extend(str(col.get(k) or "") for k in ("name", "column", "source_column", "canonical_column"))
            else:
                names.append(str(col))
        searchable = " ".join([dtype, filename, *names]).lower()
        if any(marker in searchable for marker in markers):
            return True
    return False


@app.post("/ask-business")
def ask_business(request: AskRequest):
    """
    Main endpoint for the Dynamic Business Agent.
    Supports natural-language questions such as:
    - Show ABC Traders data
    - ABC Traders ka data dikhao
    - Show Indore customers
    - Show amount greater than 50000
    - Download ABC Traders data
    - Download ABC Traders data as Excel
    - Export this data as CSV
    - Create PDF report
    """
    try:
        query = request.query.strip()
        if not query:
            raise HTTPException(
                status_code=400,
                detail="Query cannot be empty.",
            )

        # ----------------------------------------------------
        # Strict missing-domain guard. A fresh employee query must not
        # inherit or repeat a previous unrelated answer from chat history.
        # ----------------------------------------------------
        if _query_requests_employee_data(query) and not _employee_data_is_uploaded():
            unavailable = "Information is not available in the uploaded file. Employee data is not present in the uploaded datasets."
            if request.conversation_id:
                try:
                    save_message(conversation_id=request.conversation_id, role="user", message=query)
                    save_message(conversation_id=request.conversation_id, role="assistant", message=unavailable)
                except Exception as conversation_error:
                    print("[WARNING] Could not save unavailable-data response:", conversation_error)
            return {
                "success": True,
                "dataset_id": request.dataset_id,
                "dataset_type": None,
                "dataset": None,
                "answer": unavailable,
                "result": {
                    "operation": "data_not_available",
                    "status": "DATA_NOT_AVAILABLE",
                    "not_available": True,
                    "engine_answer": unavailable,
                    "table": [],
                    "rows": [],
                    "filtered_rows": 0,
                    "scope_notes": ["No employee/staff/attendance/payroll dataset or matching columns were found in uploaded data."],
                },
                "chart": None,
                "export_requested": False,
                "export_format": None,
                "download_url": None,
                "download_filename": None,
            }

        # ----------------------------------------------------
        # Semantic Query Service + Existing Dynamic Agent
        # ----------------------------------------------------
        import time

        agent_start_time = time.perf_counter()

        history = []
        retrieved_memory_context = ""
        if request.conversation_id:
            try:
                history = get_messages(request.conversation_id) or []
            except Exception as exc:
                print("[WARNING] Could not load chat history:", exc)

            # TALLY_AGENT_MEMORY_INTEGRATION_V1: SQLite remains durable source of truth.
            if _memory_hydrate_recent is not None:
                try:
                    history = _memory_hydrate_recent(request.conversation_id, history)
                except Exception as exc:
                    print("[MEMORY] Redis history hydration skipped:", type(exc).__name__)
            if _memory_retrieve_relevant is not None and _memory_format_context is not None:
                try:
                    relevant_turns = _memory_retrieve_relevant(
                        request.conversation_id, query, dataset_id=request.dataset_id, top_k=3
                    )
                    retrieved_memory_context = _memory_format_context(relevant_turns)
                except Exception as exc:
                    print("[MEMORY] Pinecone recall skipped:", type(exc).__name__)


        # GENERIC_MONTHLY_TOPN_FAILURE_ROUTING_V1
        # Route monthly entity ranking/failure queries to the
        # verified analytics_extra handler, not semantic summary logic.
        import re

        _force_dynamic_monthly_rank = bool(
            re.search(
                r"\b(fail(?:ed|ure)?|did\s+not|does\s+not|not\s+reach|miss(?:ed)?|outside\s+the)\b",
                query,
                re.I,
            )
            and re.search(
                r"\btop\s*\d+\b|\btop\s+(?:one|two|three|four|five|six|seven|eight|nine|ten)\b",
                query,
                re.I,
            )
            and re.search(
                r"\bmonths?\b|monthly|month[\s-]*wise",
                query,
                re.I,
            )
            and re.search(
                r"\b(products?|items?|customers?|parties|party|clients?|buyers?|categories|category)\b",
                query,
                re.I,
            )
        )

        # CUSTOMER_GROSS_MARGIN_MIN_SALES_ROUTING_V1
        # Route customer margin ranking with a minimum sales threshold
        # to the verified deterministic analytics_extra handler.
        _force_customer_gross_margin = bool(
            re.search(
                r"\b(highest|greatest|maximum|top|best|maximum)\b",
                query,
                re.I,
            )
            and re.search(
                r"\b(profit\s+margin|gross\s+profit\s+margin|margin\s+percentage)\b",
                query,
                re.I,
            )
            and re.search(
                r"\b(customers?|parties|clients?|buyers?)\b",
                query,
                re.I,
            )
            and re.search(
                r"\b(at\s+least|minimum|no\s+less\s+than|greater\s+than\s+or\s+equal\s+to)\b",
                query,
                re.I,
            )
            and re.search(
                r"\b(sales|revenue|gross\s+sales)\b",
                query,
                re.I,
            )
        )

        # INDEPENDENT_ANALYTICS_DIRECT_ROUTE_V1
        # Fully specified analytical questions must not pass through the
        # conversation-context LLM first. Phrases such as "that specific month"
        # and "its preceding quarter" refer to entities defined INSIDE the new
        # question; a broad pronoun detector can otherwise replace the request
        # with the previous chat's Smart Watch answer. Route these questions
        # directly to dynamic_agent / analytics_extra using the exact new text.
        _has_explicit_analytics_scope = bool(
            re.search(
                r"\b(?:overall|entire\s+dataset|whole\s+dataset|across\s+the\s+entire\s+dataset|"
                r"single\s+calendar\s+month|calendar\s+month|all\s+\d+\s+quarters?|"
                r"all\s+four\s+quarters?|fy\s*20\d{2}(?:\s*[-/]\s*\d{2,4})?|"
                r"financial\s+year|fiscal\s+year)\b",
                query, re.I,
            )
        )
        _has_explicit_analytics_metric = bool(
            re.search(
                r"\b(?:gross\s+sales|sales?|revenue|turnover|spending|revenue\s+percentage|"
                r"revenue\s+share|igst|cgst|sgst|gst|tax|profit|quantity|qty)\b",
                query, re.I,
            )
        )
        _has_explicit_analytics_operation = bool(
            re.search(
                r"\b(?:highest|lowest|top\s+\d+|percentage|percent|share|split|track|qoq|"
                r"quarter[- ]over[- ]quarter|compare|comparison|contribut\w*|recorded|total|exact)\b",
                query, re.I,
            )
        )
        _force_independent_analytics = (
            len(query.split()) >= 10
            and _has_explicit_analytics_scope
            and _has_explicit_analytics_metric
            and _has_explicit_analytics_operation
        )

        _force_dynamic_analytics = (
            _force_dynamic_monthly_rank
            or _force_customer_gross_margin
            or _force_independent_analytics
        )

        if _force_dynamic_analytics:
            semantic = {
                "handled": False,
                "standalone": query,
                "reason": "passthrough",
                "engine": "analytics_extra",
            }
            print("[API ROUTING] Monthly Top-N failure -> analytics_extra")
        else:
            semantic = (
                answer_with_context(
                    query, request.dataset_id, history,
                    memory_context=retrieved_memory_context,
                )
                if answer_with_context is not None
                else {
                    "handled": False,
                    "standalone": query,
                    "reason": "semantic_import_failed",
                    "error": SEMANTIC_IMPORT_ERROR,
                    "engine": "semantic",
                }
            )


        if semantic.get("handled"):
            result = semantic.get("state") or {}
            engine_name = semantic.get("engine") or "semantic"
            engine_diagnostic = None
            print(f"[SEMANTIC] Query handled by {engine_name} engine")
        elif semantic.get("reason") == "passthrough":
            standalone_question = semantic.get("standalone") or query
            result = dynamic_agent.invoke({
                "question": standalone_question,
                "dataset_id": request.dataset_id,
            })

            if _force_dynamic_monthly_rank:
                engine_name = "analytics_extra"
                engine_diagnostic = "Monthly Top-N entity ranking handled by the deterministic analytics engine."
                print("[API ROUTING] Monthly Top-N analytics_extra result returned")
            elif _force_customer_gross_margin:
                engine_name = "analytics_extra"
                engine_diagnostic = "Customer gross profit margin ranking with minimum sales threshold handled by the deterministic analytics engine."
                print("[API ROUTING] Customer gross margin analytics_extra result returned")
            elif _force_independent_analytics:
                engine_name = "analytics_extra"
                engine_diagnostic = "Fully specified independent analytics query routed directly; conversation history was bypassed."
                print("[API ROUTING] Independent analytics query -> direct dynamic_agent; history bypassed")
            else:
                engine_name = "legacy"
                engine_diagnostic = "This request is a raw-row, export, or specialized report operation handled by the existing pipeline."
                print("[SEMANTIC] Legacy pipeline used for passthrough/export request")
        elif semantic.get("reason") in {"api_key_missing", "llm_unavailable", "semantic_exception", "semantic_import_failed", "empty_dataset", "no_datasets"}:
            # Do not silently present a legacy guess as a semantic-engine answer.
            diagnostic = semantic.get("error") or semantic.get("reason") or "unknown semantic engine failure"
            answer = ("AI engine abhi available nahi hai, isliye maine purane engine ka potentially misleading jawab nahi dikhaya. "
                      f"Diagnostic: {diagnostic}")
            result = {
                "dataset_id": request.dataset_id, "intent": "semantic_engine_unavailable",
                "answer": answer, "dataset": None, "dataset_type": None, "chart": None,
                "result": {"operation": "semantic_engine_unavailable", "status": "AI_ENGINE_UNAVAILABLE",
                           "engine_answer": answer, "rows": [], "table": [], "scope_notes": [str(diagnostic)],
                           "suppress_kpis": True},
                "export_requested": False, "export_format": None,
            }
            engine_name = "semantic-unavailable"
            engine_diagnostic = str(diagnostic)
            print("[SEMANTIC-UNAVAILABLE]", diagnostic)
        else:
            standalone_question = semantic.get("standalone") or query
            result = dynamic_agent.invoke({"question": standalone_question, "dataset_id": request.dataset_id})
            engine_name = "legacy"
            engine_diagnostic = f"Semantic service did not handle request: {semantic.get('reason') or 'not handled'}"
            print("[SEMANTIC] Legacy fallback; reason =", semantic.get("reason"))

        agent_end_time = time.perf_counter()

        print(
            f"[TIMING] Dynamic/Semantic Agent: "
            f"{agent_end_time - agent_start_time:.2f} seconds"
        )

        print(
            f"[TIMING] Dynamic Agent: "
            f"{agent_end_time - agent_start_time:.2f} seconds"
        )
        print(
         "[DEBUG API DYNAMIC AGENT]",
          dynamic_agent,
        )
        import graph.dynamic_nodes as dn
        print(
            "[DEBUG API detect_dynamic_intent FILE]",
            dn.__file__,
        )
        print(
           "[DEBUG API detect_dynamic_intent LINE]",
           dn.detect_dynamic_intent.__code__.co_firstlineno,
        )
        # Repair rupee-symbol mojibake using explicit Unicode code points.
        answer_text = result.get("answer")
        if isinstance(answer_text, str):
            bad_currency = "".join(chr(c) for c in (0x00E2, 0x0082, 0x00B9))
            bad_currency_alt = "".join(chr(c) for c in (0x00E2, 0x201A, 0x00B9))
            bad_currency_short = "".join(chr(c) for c in (0x00E2, 0x00B9))

            answer_text = answer_text.replace(bad_currency, chr(0x20B9))
            answer_text = answer_text.replace(bad_currency_alt, chr(0x20B9))
            answer_text = answer_text.replace(bad_currency_short, chr(0x20B9))
            answer_text = answer_text.replace(
                "leading retail customerby month",
                "leading retail customer by month",
            )
            result["answer"] = answer_text

        print("[DEBUG API ANSWER] =", repr(result.get("answer")))
        # API RESPONSE CHART SPEC FIX
        query_result_for_response = result.get("result") or {}
        response_chart_spec = (
            query_result_for_response.get("chart_spec") or {}
        )
        response_chart = result.get("chart")

        if (
            isinstance(response_chart_spec, dict)
            and response_chart_spec.get("data")
            and response_chart_spec.get("series")
        ):
            if not isinstance(response_chart, dict):
                response_chart = {}

            if (
                not response_chart.get("enabled")
                or not response_chart.get("series")
                or not response_chart.get("data")
            ):
                response_chart = {
                    **response_chart,
                    "type": response_chart_spec.get("type", "line"),
                    "title": response_chart_spec.get("title") or "Query result",
                    "enabled": True,
                    "x_field": response_chart_spec.get("x", "period"),
                    "series": response_chart_spec["series"],
                    "data": response_chart_spec["data"],
                    "row_count": len(response_chart_spec["data"]),
                    "interactive": response_chart_spec.get(
                        "interactive", True
                    ),
                }

        # ----------------------------------------------------
        # Base response
        # ----------------------------------------------------
        response = {
            "success": True,
            "engine": engine_name,
            "engine_diagnostic": engine_diagnostic,
            "dataset_id": result.get(
                "dataset_id"
            ),
            "intent": result.get(
                "intent"
            ),
            "dataset_type": result.get(
                "dataset_type"
            ),
            "dataset": result.get(
                "dataset"
            ),
            "answer": result.get(
                "answer"
            ),
            "result": result.get(
                "result"
            ),
            "chart": response_chart if response_chart is not None else result.get("chart"),
            "export_requested": result.get(
                "export_requested",
                False,
            ),
            "export_format": result.get(
                "export_format"
            ),
            "download_url": None,
            "download_filename": None,
        }
        
        response["confidence"] = score_confidence(
            engine=engine_name, question=query,
            standalone=semantic.get("standalone"),
            answer=response.get("answer"), result=response.get("result"))
        # ----------------------------------------------------
        # Save conversation
        # ----------------------------------------------------
        if request.conversation_id:
            try:
                save_message(
                    conversation_id=request.conversation_id,
                    role="user",
                    message=query,
                )
                # Save structured assistant result after report/export processing below.
                # TALLY_AGENT_MEMORY_INTEGRATION_V1: best-effort writes after SQLite.
                if _memory_remember_turn is not None:
                    import threading
                    _ans = str(result.get("answer") or "")
                    _skip = (
                        "not available" in _ans.casefold()
                        or engine_name in ("semantic-unavailable", "legacy")
                    )

                    def _bg_memory(cid=request.conversation_id, ds=request.dataset_id, q=query, a=_ans, skip=_skip):
                        try:
                            _memory_remember_turn(cid, "user", q, dataset_id=ds)
                            if not skip:
                                _memory_remember_turn(cid, "assistant", a, dataset_id=ds)
                        except Exception as exc:
                            print("[MEMORY] background write skipped:", type(exc).__name__)

                    threading.Thread(target=_bg_memory, daemon=True).start()
            except Exception as conversation_error:
                print(
                    "[WARNING] Could not save business conversation:",
                    conversation_error,
                )
        # ----------------------------------------------------
        # SPECIALIZED GST SALES REPORT
        # ----------------------------------------------------
        if is_gst_sales_report_request(query):
            query_result = result.get(
                "result",
                {},
            )
            if not isinstance(
                query_result,
                dict,
            ):
                query_result = {}
            gst_rows = query_result.get(
                "rows",
                [],
            )
            print(
               "[GST DEBUG] gst_rows =",
               gst_rows,
            )
            if not isinstance(
                gst_rows,
                list,
            ):
                gst_rows = []
            if gst_rows:
                # ---------------------------------------------
                # Generate specialized 8-sheet GST workbook
                # ---------------------------------------------
                gst_filename = (
                    "GST_Sales_Report.xlsx"
                )
                gst_result = generate_gst_sales_report(
                    rows=gst_rows,
                    filename=gst_filename,
                )
                if gst_result.get(
                    "success"
                ):
                    filename = gst_result.get(
                        "filename"
                    )
                    if filename:
                        response[
                            "download_url"
                        ] = (
                            f"/download/{filename}"
                        )
                        response[
                            "download_filename"
                        ] = filename
                        response[
                            "export"
                        ] = gst_result
                        response[
                            "export_requested"
                        ] = True
                        response[
                            "export_format"
                        ] = "xlsx"
                        response[
                            "answer"
                        ] = (
                            "GST Sales Report generated "
                            "successfully with 8 sheets."
                            "\n\n"
                            "Download ready: "
                            + filename
                        )
                else:
                    response[
                        "export_error"
                    ] = gst_result.get(
                        "message",
                        "GST Sales Report generation failed.",
                    )
            else:
                response[
                    "export_error"
                ] = (
                    "There are no matching sales rows "
                    "to generate the GST Sales Report."
                )
        # ----------------------------------------------------
        # EXISTING GENERIC EXPORT
        # ----------------------------------------------------
        # ----------------------------------------------------
        # GENERIC REPORT EXPORT
        # ----------------------------------------------------
        else:
            query_result = result.get(
                "result",
                {},
            )
            if not isinstance(
                query_result,
                dict,
            ):
                query_result = {}
            export_rows_data = (
                query_result.get("rows")
                or query_result.get("table")
                or query_result.get("chart_spec", {}).get("data")
                or []
            )
            if not isinstance(export_rows_data, list):
                export_rows_data = []
            print("\n========== EXPORT DEBUG ==========")
            print("EXPORT ROWS TYPE:", type(export_rows_data).__name__)
            print("EXPORT ROWS COUNT:", len(export_rows_data))
            print("EXPORT REQUESTED:", result.get("export_requested"))
            print("EXPORT FORMAT:", result.get("export_format"))
            print("RESULT OPERATION:", (result.get("result") or {}).get("operation"))
            print("==================================\n")
            # -----------------------------------------------
            # Generate downloadable report when rows exist
            # -----------------------------------------------
            if export_rows_data:
                dataset = result.get(
                    "dataset",
                    {},
                )
                if not isinstance(
                    dataset,
                    dict,
                ):
                    dataset = {}
                original_filename = (
                    dataset.get(
                        "original_filename"
                    )
                    or "dataset"
                )
                dataset_stem = Path(
                    original_filename
                ).stem
                # -------------------------------------------
                # Keep requested export format when supplied
                # Otherwise default to XLSX
                # -------------------------------------------
                export_requested = bool(
                    result.get(
                        "export_requested",
                        False,
                    )
                )
                export_format = (
                    result.get(
                        "export_format"
                    )
                    or "xlsx"
                )
                export_format = str(
                    export_format
                ).lower().replace(
                    ".",
                    "",
                )
                if export_format not in {
                    "xlsx",
                    "csv",
                    "pdf",
                }:
                    export_format = "xlsx"
                # -------------------------------------------
                # Filename
                # -------------------------------------------
                generated_filename = (
                    f"{dataset_stem}_report"
                )
                if export_format == "csv":
                    generated_filename += ".csv"
                elif export_format == "pdf":
                    generated_filename += ".pdf"
                else:
                    generated_filename += ".xlsx"
                # -------------------------------------------
                # Generate file
                # -------------------------------------------
                chart_config = result.get("chart")
                query_result_for_chart = result.get("result") or {}
                chart_spec = query_result_for_chart.get("chart_spec") or {}
                # Prefer a usable chart_spec when the direct chart
                # config is missing, disabled, or incomplete.
                if (
                    isinstance(chart_spec, dict)
                    and chart_spec.get("data")
                    and (
                        not isinstance(chart_config, dict)
                        or not chart_config.get("enabled")
                        or not chart_config.get("series")
                        or not chart_config.get("data")
                    )
                ):
                    existing_chart = (
                        chart_config
                        if isinstance(chart_config, dict)
                        else {}
                    )
                    chart_config = {
                        **existing_chart,
                        **chart_spec,
                        "enabled": True,
                    }
                    chart_config["group_by"] = (
                        chart_config.get("x")
                        or chart_config.get("group_by")
                        or chart_config.get("group_key")
                        or ""
                    )
                print("\n========== CHART DEBUG ==========")
                print("CHART ENABLED:", (chart_config or {}).get("enabled"))
                print("CHART TYPE:", (chart_config or {}).get("type"))
                print("CHART GROUP:", (chart_config or {}).get("group_by"))
                print(
                    "CHART DATA COUNT:",
                    len((chart_config or {}).get("data") or [])
                )
                print("=================================\n")
                export_result = export_rows(
                    rows=export_rows_data,
                    file_format=export_format,
                    filename=generated_filename,
                    columns=(
                        result.get(
                            "requested_columns"
                        )
                        or None
                    ),
                    title=(
                        f"{dataset_stem} — Query: {query.strip()[:100]}"
                    ),
                    chart=chart_config,
                )
                print("\n========== FILE GENERATION DEBUG ==========")
                print("EXPORT RESULT:", export_result)
                print("GENERATED DIR:", GENERATED_DIR)
                print("============================================\n")
                # -------------------------------------------
                # Attach download information
                # -------------------------------------------
                if export_result.get(
                    "success"
                ):
                    filename = (
                        export_result.get(
                            "filename"
                        )
                    )
                    if filename:
                        response[
                            "download_url"
                        ] = (
                            f"/download/{filename}"
                        )
                        response[
                            "download_filename"
                        ] = filename
                        response[
                            "export"
                        ] = export_result
                        response[
                            "export_requested"
                        ] = export_requested
                        response[
                            "export_format"
                        ] = export_format
                else:
                    response[
                        "export_error"
                    ] = export_result.get(
                        "error",
                        export_result.get(
                            "message",
                            "Report generation failed.",
                        ),
                    )
            else:
                # No rows means there is nothing
                # useful to download.
                response[
                    "download_url"
                ] = None
                response[
                    "download_filename"
                ] = None
        

        # DEBUG: Save the final assistant answer and full result.
        if request.conversation_id:
            print(
                "[CHAT SAVE DEBUG] Assistant save started:",
                request.conversation_id,
            )

            try:
                save_message(
                    conversation_id=request.conversation_id,
                    role="assistant",
                    message=str(response.get("answer") or ""),
                    metadata=response,
                )

                print(
                    "[CHAT SAVE DEBUG] Assistant save SUCCESS:",
                    request.conversation_id,
                )

            except Exception as conversation_error:
                print(
                    "[CHAT SAVE DEBUG] Assistant save FAILED:",
                    repr(conversation_error),
                )

        print(
            "[DEBUG FINAL RESPONSE HEADING] =",
            repr((response.get("answer") or "").splitlines()[0:2]),
        )
        print(
            "[DEBUG FINAL RESPONSE HEADING] =",
            repr((response.get("answer") or "").splitlines()[0:2]),
        )
        return response

    except HTTPException:
        raise

    except Exception as exc:
        print(
            "[ERROR] /ask-business:",
            exc,
        )
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )

# ============================================================
# GENERATED FILE DOWNLOAD
# ============================================================
@app.get("/download/{filename}")
def download_generated_file(
    filename: str,
):
    """
    Download a generated CSV/XLSX/PDF file.
    Only files inside the generated directory
    are allowed.
    """
    # --------------------------------------------------------
    # Prevent path traversal
    # --------------------------------------------------------
    safe_name = Path(
        filename
    ).name
    if safe_name != filename:
        raise HTTPException(
            status_code=400,
            detail="Invalid filename.",
        )
    file_path = (
        GENERATED_DIR / safe_name
    )
    # --------------------------------------------------------
    # File existence
    # --------------------------------------------------------
    if not file_path.exists():
        raise HTTPException(
            status_code=404,
            detail="Generated file not found.",
        )
    if not file_path.is_file():
        raise HTTPException(
            status_code=404,
            detail="Generated file not found.",
        )
    # --------------------------------------------------------
    # Allowed extensions
    # --------------------------------------------------------
    allowed_extensions = {
        ".csv": "text/csv",
        ".xlsx": (
            "application/"
            "vnd.openxmlformats-officedocument."
            "spreadsheetml.sheet"
        ),
        ".pdf": "application/pdf",
    }
    media_type = allowed_extensions.get(
        file_path.suffix.lower()
    )
    if not media_type:
        raise HTTPException(
            status_code=400,
            detail="Unsupported file type.",
        )
    return FileResponse(
        path=str(file_path),
        filename=file_path.name,
        media_type=media_type,
    )
