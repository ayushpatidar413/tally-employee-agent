# ============================================================
# GET DATASET ROWS
# ============================================================
@app.get("/datasets/{dataset_id}/rows")
def dataset_rows(dataset_id: int):
    try:
        dataset = get_uploaded_dataset(dataset_id)
        if not dataset or not dataset.get("success"):
            raise HTTPException(
                status_code=404,
                detail="Dataset not found.",
            )
        stored_rows = get_dataset_rows(dataset_id)
        # Database rows contain the actual record inside "data".
        rows = [
            row.get("data", {})
            for row in stored_rows
            if isinstance(row, dict)
            and isinstance(row.get("data"), dict)
        ]
        return {
            "success": True,
            "dataset_id": dataset_id,
            "rows": rows,
            "count": len(rows),
        }
    except HTTPException:
        raise
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        )
