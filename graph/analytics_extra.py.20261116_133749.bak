"""analytics_extra v3 - deterministic handlers that run BEFORE the LLM planner / older pipeline.
Everything is derived from the loaded dataframe (columns + real values). Returns None when a question
is not recognised, so the older pipeline keeps working unchanged."""
import re
import calendar
import difflib
import pandas as pd
from services.semantic_query_service import _to_dt
RS = "\u20b9"
MN = ["january","february","march","april","may","june","july","august","september","october","november","december"]
MRX = "|".join(MN)
STOP = set("the a an of for in on at to by and or with from between during is are was were what which who whom how much many "
           "show give me my our us list find tell get did do does we i you it this that these those total overall all each every any "
           "latest previous last recent prior first month months year years quarter quarters day days daily monthly yearly annual "
           "wise sales sale revenue turnover billing business amount value profit gst tax discount quantity qty units customer customers "
           "party parties product products category categories state states payment mode modes invoice invoices highest lowest top bottom "
           "best worst most least higher lower than compare comparison growth change trend rank ranking above below under over sold sell "
           "comes come coming contribute contributes contribution percent percentage share average correlated correlation summary rolling cumulative running "
           "available current this next both ytd mtd qtd date breakdown distribution where greater less equal having had has have generated generate "
           "but also only per across which whose year-to-date".split())

METRICS = [
    ("count", r"invoice[\s-]*counts?|number of invoices|count of invoices|invoices? count|total invoices", ["__invcount__"], "Invoice Count"),
    ("margin", r"profit[\s-]*margin|\bmargins?\b", ["__derived__"], "Profit Margin %"),
    ("invoice_total", r"(?:invoice\s*(?:value|amount|total)\b(?:\s+with\s+gst)?|total\s+invoice\b(?:\s+(?:value|amount))?(?:\s+with\s+gst)?)", ["InvoiceTotal", "Invoice Total", "Invoice Value"], "Invoice Value"),
    ("profit", r"\bprofit", ["Profit"], "Profit"),
    ("igst", r"\b(?:igst|integrated\s+gst)\b", ["IGST"], "IGST"),
    ("sgst", r"\b(?:sgst|state\s+gst)\b", ["SGST"], "SGST"),
    ("cgst", r"\b(?:cgst|central\s+gst)\b", ["CGST"], "CGST"),
    ("gst", r"\bgst\b|\btax\b", ["TotalGST", "Total GST", "GST"], "GST"),
    ("discount", r"discount", ["DiscountAmt", "Discount Amount", "Discount"], "Discount"),
    ("unit_price",
     r"\b(?:unit[\s_-]*price|selling[\s_-]*price|price[\s_-]*per[\s_-]*unit)\b",
     ["UnitPrice", "Unit Price", "Selling Price", "Rate"],
     "Unit Price"),
    ("qty", r"quantit|\bqty\b|\bunits\b", ["Qty", "Quantity"], "Quantity"),
    ("sales", r"\bsales?\b|revenue|turnover|billing|business|\bsell\b|\bselling\b|\bsold\b", ["GrossAmount", "Gross Amount", "Sales Amount", "SalesAmount"], "Sales"),
]
CATS = [("PartyName", ["PartyName", "Party Name", "Customer Name"]), ("Product", ["Product", "Item Name"]),
        ("Category", ["Category"]), ("PartyState", ["PartyState", "State"]),
        ("PaymentMode", ["PaymentMode", "Payment Mode"]), ("PartyType", ["PartyType", "Party Type"])]
DIMS = [
    ("party type", r"party[\s-]*types?|customer[\s-]*types?", ["PartyType", "Party Type"]),
    ("customer", r"\bcustomers?\b|\bparty(?:[\s_-]*name|[\s-]*ies?)?\b|\bparties\b|\bclients?\b|\bwho\b|\bbuyers?\b", ["PartyName", "Party Name", "Customer Name"]),
    ("category", r"\bcategor(?:y|ies)\b|\b(?:type\s*of|typeof|kind\s*of|kindof)\s+(?:the\s+)?(?:products?|items?)\b|\b(?:product|item)\s+types?\b", ["Category"]),
    ("product", r"\bproducts?\b|\bitems?\b", ["Product", "Item Name"]),
    ("state", r"\bstates?\b", ["PartyState", "State"]),
    ("payment mode", r"payment[\s-]*modes?|payment[\s-]*methods?", ["PaymentMode", "Payment Mode"]),
]
NA_WORDS = {
    "purchase": (r"\bpurchas\w*", ["purchase"]),
    "supplier": (r"\bsuppliers?\b|\bvendors?\b", ["supplier", "vendor"]),
    "stock": (r"\bstock\b|\binventory\b", ["stock", "inventory"]),
    "outstanding": (r"\boutstanding\b|\boverdue\b|\breceivables?\b|\bunpaid\b", ["outstanding", "balance", "overdue"]),
    "employee": (r"\bemployees?\b|\battendance\b", ["employee", "attendance"]),
    "student": (r"\bstudents?\b|\bmarks\b|\bcgpa\b", ["student", "marks", "cgpa"]),
}
UP = r"highest|most|best|top|maximum|largest|biggest|higher|greatest"
DOWN = r"lowest|least|worst|bottom|minimum|smallest|lower|fewest"


def _n(s):
    return re.sub(r"[^a-z0-9]", "", str(s).lower())


def _col(cols, cands):
    idx = {_n(c): c for c in cols}
    for c in cands:
        if _n(c) in idx:
            return idx[_n(c)]
    return None


def _fmt(key, v):
    if v is None or (isinstance(v, float) and pd.isna(v)):
        return "-"
    if key in ("qty", "count"):
        return "{:,.0f}".format(v)
    if key == "qty2":
        return "{:,.2f}".format(v)
    if key == "pct":
        return "{:+,.2f}%".format(v)
    if key in ("margin", "share"):
        return "{:,.2f}%".format(v)
    amount = "{:,.2f}".format(abs(v) if v < 0 else v)
    sign = "-" if v < 0 else ""
    return sign + RS + amount


def _table(title, head, rows):
    out = [title, "", "| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
    out += ["| " + " | ".join(str(x) for x in r) + " |" for r in rows]
    return "\n".join(out)


def _out(txt, **extra):
    res = {"operation": "engine", "engine_answer": txt}
    res.update(extra)
    return {"answer": txt, "result": res}


def _na(msg):
    return {"answer": "DATA_NOT_AVAILABLE: " + msg,
            "result": {"operation": "engine", "status": "DATA_NOT_AVAILABLE", "engine_answer": "DATA_NOT_AVAILABLE: " + msg}}


def _metric(q):
    t = re.sub(r"(?:quantity|qty|units)\s+sold", "quantity", q)

    # "sales before discount" means gross sales only, not two metrics.
    if re.search(r"\bsales?\s+before\s+discount\b", t):
        t = re.sub(r"\bdiscount\b", " " * len("discount"), t)

    if re.search(r"quantit|\bqty\b|\bunits\b", t):
        t = re.sub(r"\bsold\b|\bselling\b|\bsell\b", " ", t)
    found = []
    for key, rx, cands, label in METRICS:
        m = re.search(rx, t)
        if m:
            found.append((m.start(), key, cands, label))
            t = t[:m.start()] + " " * (m.end() - m.start()) + t[m.end():]
    found.sort()
    return found


def _money(q):
    c = _conditions(q)
    return (c[0]["op"], c[0]["val"]) if c else None


_THR = re.compile(r"\b(above|over|greater than|more than|exceed\w*|higher than|below|under|less than|lower than)\s+(?:rs\.?\s*|inr\s*|\u20b9\s*)?(\d[\d,]*(?:\.\d+)?)\s*(k|lakhs?|lacs?|crores?|cr|million|m)?\b(?!\s*(?:months?|days?|years?|quarters?|invoices?|customers?|products?|categories|states|transactions?|records?|rows?))")

_NUM_PATTERN = r"\d[\d,]*(?:\.\d+)?"
_UNIT_PATTERN = r"(?:k|lakhs?|lacs?|crores?|cr|million|m)?"

_BETWEEN = re.compile(
    r"\bbetween\s+"
    r"(?:rs\.?\s*|inr\s*|\u20b9\s*)?"
    r"(" + _NUM_PATTERN + r")\s*(" + _UNIT_PATTERN + r")"
    r"\s+and\s+"
    r"(?:rs\.?\s*|inr\s*|\u20b9\s*)?"
    r"(" + _NUM_PATTERN + r")\s*(" + _UNIT_PATTERN + r")\b",
    re.IGNORECASE,
)

_MULT = {"k": 1e3, "lakh": 1e5, "lakhs": 1e5, "lac": 1e5, "lacs": 1e5, "crore": 1e7, "crores": 1e7, "cr": 1e7, "million": 1e6, "m": 1e6}


def _metric_at(s):
    for key, rx, _c, _l in METRICS:
        m = re.match(rx, s)
        if m:
            return key, m.end()
    return None



def _conditions(q):
    """Parse greater-than, less-than and between conditions."""

    def parse_number(number, unit):
        return float(number.replace(",", "")) * _MULT.get(
            (unit or "").lower(), 1
        )

    matches = []

    for m in _BETWEEN.finditer(q):
        matches.append({
            "match": m,
            "op": "between",
            "val": parse_number(m.group(1), m.group(2)),
            "high": parse_number(m.group(3), m.group(4)),
        })

    for m in _THR.finditer(q):
        word = m.group(1).lower()
        is_greater = (
            word in (
                "above", "over", "greater than",
                "more than", "higher than"
            )
            or word.startswith("exceed")
        )

        matches.append({
            "match": m,
            "op": ">" if is_greater else "<",
            "val": parse_number(m.group(2), m.group(3)),
        })

    matches.sort(key=lambda x: x["match"].start())

    out = []
    prev_end = 0

    for item in matches:
        m = item["match"]
        key = None
        s0 = m.start()
        e0 = m.end()

        after = q[m.end():m.end() + 40]

        mm = re.match(
            r"\s*(?:in|of|on|for|as)\s+(?:the\s+)?(?:total\s+)?",
            after,
            flags=re.IGNORECASE,
        )

        if mm:
            hit = _metric_at(after[mm.end():])
            if hit:
                key, ln = hit
                e0 = m.end() + mm.end() + ln

        if key is None:
            before = q[prev_end:m.start()]
            best = None

            for k_, rx, _c, _l in METRICS:
                for mt in re.finditer(rx, before):
                    if best is None or mt.start() > best[0]:
                        best = (mt.start(), k_)

            if best:
                key = best[1]
                s0 = prev_end + best[0]

        condition = {
            "op": item["op"],
            "val": item["val"],
            "key": key,
            "span": (s0, e0),
        }

        if item["op"] == "between":
            condition["high"] = item["high"]

        out.append(condition)
        prev_end = e0

    return out


def _blank(q, conds):
    t = q
    for c in conds:
        a, b = c["span"]
        t = t[:a] + " " * (b - a) + t[b:]
    return t


MON_ABBR = {"jan": "january", "feb": "february", "mar": "march", "apr": "april", "jun": "june", "jul": "july",
            "aug": "august", "sept": "september", "sep": "september", "oct": "october", "nov": "november", "dec": "december"}



_NUM_WORDS = {
    "one": 1, "two": 2, "three": 3, "four": 4, "five": 5,
    "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10,
    "eleven": 11, "twelve": 12
}
_UNITS_RX = (
    r"months?|quarters?|years?|days?|weeks?|invoices?|"
    r"transactions?|customers?|products?|categories|states?|records?"
)

def _normalize_numbers(q):
    words = "|".join(sorted(_NUM_WORDS, key=len, reverse=True))
    q = re.sub(
        r"\b(last|first|top|bottom|previous|latest|recent|next|past)\s+("
        + words + r")\b",
        lambda m: "%s %d" % (m.group(1), _NUM_WORDS[m.group(2)]),
        q,
    )
    q = re.sub(
        r"\b(" + words + r")(" + _UNITS_RX + r")\b",
        lambda m: "%d %s" % (_NUM_WORDS[m.group(1)], m.group(2)),
        q,
    )
    q = re.sub(
        r"\b(" + words + r")\s+(" + _UNITS_RX + r")\b",
        lambda m: "%d %s" % (_NUM_WORDS[m.group(1)], m.group(2)),
        q,
    )
    q = re.sub(r"\b(\d+)(" + _UNITS_RX + r")\b", r"\1 \2", q)
    return q

def _norm_months(q):
    return re.sub(r"\b(jan|feb|mar|apr|jun|jul|aug|sept|sep|oct|nov|dec)\b\.?", lambda m: MON_ABBR[m.group(1)], q)


def _invalid_date(q):
    """returns a label like '30 February' when the text contains an impossible calendar date, else None."""
    for m in re.finditer(r"\b(\d{1,2})[-/.](\d{1,2})[-/.](20\d\d)\b", q):
        d_, mo_, y_ = int(m.group(1)), int(m.group(2)), int(m.group(3))
        if not 1 <= mo_ <= 12 or not 1 <= d_ <= calendar.monthrange(y_, mo_)[1]:
            return m.group(0)
    for m in re.finditer(r"\b(20\d\d)[-/.](\d{1,2})[-/.](\d{1,2})\b", q):
        y_, mo_, d_ = int(m.group(1)), int(m.group(2)), int(m.group(3))
        if not 1 <= mo_ <= 12 or not 1 <= d_ <= calendar.monthrange(y_, mo_)[1]:
            return m.group(0)
    for m in re.finditer(r"\b(\d{1,2})(?:st|nd|rd|th)?\s+(%s)(?:,?\s+(20\d\d))?\b" % MRX, q):
        d_, mo_ = int(m.group(1)), MN.index(m.group(2)) + 1
        y_ = int(m.group(3)) if m.group(3) else 2024
        if not 1 <= d_ <= calendar.monthrange(y_, mo_)[1]:
            return "%d %s%s" % (d_, m.group(2).title(), (" " + m.group(3)) if m.group(3) else "")
    for m in re.finditer(r"\b(%s)\s+(\d{1,2})(?:st|nd|rd|th)?(?:,?\s+(20\d\d))?\b" % MRX, q):
        d_, mo_ = int(m.group(2)), MN.index(m.group(1)) + 1
        y_ = int(m.group(3)) if m.group(3) else 2024
        if not 1 <= d_ <= calendar.monthrange(y_, mo_)[1]:
            return "%s %d%s" % (m.group(1).title(), d_, (" " + m.group(3)) if m.group(3) else "")
    return None


def _year_picker(d, dc):
    """function(month_number) -> latest year in the data that has rows in that month (else latest data year)."""
    s_ = d[dc].dropna()
    if s_.empty:
        return lambda month: None
    pairs = set(zip(s_.dt.year.astype(int), s_.dt.month.astype(int)))
    latest = int(s_.dt.year.max())

    def pick(month):
        ys = [y for (y, m) in pairs if m == month]
        return max(ys) if ys else latest
    return pick


def _dy(default_year, month):
    return default_year(month) if callable(default_year) else default_year


def _dl(label, agg):
    return {"mean": "Avg " + label, "median": "Median " + label}.get(agg, label)


def _plural(w):
    return {"category": "categories"}.get(w, w + "s")


def _dates(q, default_year=None):
    """explicit dates found in text -> list of (pos, Timestamp). Handles dd-mm-yyyy, dd/mm/yyyy, yyyy-mm-dd, '15 august 2026', 'august 15, 2026', '1 august' (+year later)."""
    q = q.lower()
    q = re.sub(r"\b(twenty|thirty)\s+(first|second|third|fourth|fifth|sixth|seventh|eighth|ninth)\b", r"\1-\2", q)
    found = []
    for m in re.finditer(r"\b(\d{1,2})[-/.](\d{1,2})[-/.](20\d\d)\b", q):
        try:
            found.append((m.start(), pd.Timestamp(int(m.group(3)), int(m.group(2)), int(m.group(1)))))
        except ValueError:
            pass
    for m in re.finditer(r"\b(20\d\d)[-/.](\d{1,2})[-/.](\d{1,2})\b", q):
        try:
            found.append((m.start(), pd.Timestamp(int(m.group(1)), int(m.group(2)), int(m.group(3)))))
        except ValueError:
            pass
    yr = re.findall(r"\b(20\d\d)\b", q)
    for m in re.finditer(r"\b(\d{1,2})(?:st|nd|rd|th)?\s+(%s)(?:,?\s+(20\d\d))?\b" % MRX, q):
        y = m.group(3) or (yr[-1] if yr else _dy(default_year, MN.index(m.group(2)) + 1))
        if y:
            try:
                found.append((m.start(), pd.Timestamp(int(y), MN.index(m.group(2)) + 1, int(m.group(1)))))
            except ValueError:
                pass
    for m in re.finditer(r"\b(%s)\s+(\d{1,2})(?:st|nd|rd|th)?,?\s+(20\d\d)\b" % MRX, q):
        try:
            found.append((m.start(), pd.Timestamp(int(m.group(3)), MN.index(m.group(1)) + 1, int(m.group(2)))))
        except ValueError:
            pass

    # English ordinal day words: third August 2026, August fifteenth 2026
    day_words = {
        "first": 1, "second": 2, "third": 3, "fourth": 4,
        "fifth": 5, "sixth": 6, "seventh": 7, "eighth": 8,
        "ninth": 9, "tenth": 10, "eleventh": 11, "twelfth": 12,
        "thirteenth": 13, "fourteenth": 14, "fifteenth": 15,
        "sixteenth": 16, "seventeenth": 17, "eighteenth": 18,
        "nineteenth": 19, "twentieth": 20, "twenty-first": 21,
        "twenty-second": 22, "twenty-third": 23, "twenty-fourth": 24,
        "twenty-fifth": 25, "twenty-sixth": 26, "twenty-seventh": 27,
        "twenty-eighth": 28, "twenty-ninth": 29, "thirtieth": 30,
        "thirty-first": 31,
        "one": 1, "two": 2, "three": 3, "four": 4,
        "five": 5, "six": 6, "seven": 7, "eight": 8,
        "nine": 9, "ten": 10, "eleven": 11, "twelve": 12,
        "thirteen": 13, "fourteen": 14, "fifteen": 15,
        "sixteen": 16, "seventeen": 17, "eighteen": 18,
        "nineteen": 19,
        "twenty one": 21, "twenty two": 22, "twenty three": 23,
        "twenty four": 24, "twenty five": 25, "twenty six": 26,
        "twenty seven": 27, "twenty eight": 28, "twenty nine": 29,
        "thirty one": 31,
    }
    word_pattern = "|".join(re.escape(word) for word in sorted(day_words, key=len, reverse=True))
    for m in re.finditer(r"\b(" + word_pattern + r")\s+(" + MRX + r")(?:,?\s+(20\d{2}))?\b", q):
        y = m.group(3) or (yr[-1] if yr else _dy(default_year, MN.index(m.group(2)) + 1))
        if y:
            try:
                found.append((m.start(), pd.Timestamp(int(y), MN.index(m.group(2)) + 1, day_words[m.group(1)])))
            except ValueError:
                pass
    for m in re.finditer(r"\b(" + MRX + r")\s+(" + word_pattern + r"),?\s+(20\d{2})\b", q):
        try:
            found.append((m.start(), pd.Timestamp(int(m.group(3)), MN.index(m.group(1)) + 1, day_words[m.group(2)])))
        except ValueError:
            pass

    # Handle ranges where the month/year appear only after the second day:
    # "from 15 to 17 July 2026" / "15th-17th July 2026".
    for m in re.finditer(
        r"\b(\d{1,2})(?:st|nd|rd|th)?\s*"
        r"(?:to|till|until|through|-)\s*"
        r"(\d{1,2})(?:st|nd|rd|th)?\s+"
        r"(%s)\s+(20\d\d)\b" % MRX,
        q,
    ):
        month_num = MN.index(m.group(3)) + 1
        year_num = int(m.group(4))
        for day, pos in ((int(m.group(1)), m.start(1)),
                         (int(m.group(2)), m.start(2))):
            try:
                stamp = pd.Timestamp(year_num, month_num, day)
                if not any(existing == stamp for _, existing in found):
                    found.append((pos, stamp))
            except ValueError:
                pass

    found.sort()
    return found


def _scope(q, d, dc):
    """returns (df, notes, error_msg)"""
    notes = []
    if not dc:
        return d, notes, None
    pick = _year_picker(d, dc)
    ly = int(d[dc].dt.year.max()) if d[dc].notna().any() else None
    ds = _dates(q, pick)

    # Resolve calendar-based first/last N days before generic month/year
    # filtering, otherwise "last 15 days of July 2026" becomes all of July.
    day_span_early = re.search(
        r"\b(first|last)\s+(\d+)\s+days?\b.*?"
        r"\b(?:of|in|during)\s+(%s)\s+(20\d{2})\b" % MRX,
        q,
    )
    if day_span_early:
        side = day_span_early.group(1)
        n_days = int(day_span_early.group(2))
        month_num = MN.index(day_span_early.group(3)) + 1
        year_num = int(day_span_early.group(4))

        if n_days < 1:
            return d, notes, "day count must be at least 1"

        month_start = pd.Timestamp(year_num, month_num, 1)
        month_end = month_start + pd.offsets.MonthEnd(0)
        if side == "first":
            a = month_start
            b = pd.Timestamp(
                year_num, month_num, min(n_days, month_end.day)
            )
        else:
            a = pd.Timestamp(
                year_num, month_num, max(1, month_end.day - n_days + 1)
            )
            b = month_end

        d = d[(d[dc] >= a) & (d[dc] < b + pd.Timedelta(days=1))]
        notes.append("Date range: %s to %s" % (a.date(), b.date()))
        if d.empty:
            return d, notes, "no rows for the requested date range"
        return d, notes, None
    SEP = r"(?:and|to|till|until|through|-)"
    to_ytd = re.search(r"\bytd\b|year[\s-]*to[\s-]*date", q)
    to_mtd = re.search(r"\bmtd\b|month[\s-]*to[\s-]*date", q)
    to_qtd = re.search(r"\bqtd\b|quarter[\s-]*to[\s-]*date", q)
    mrange = re.search(
        r"\b(?:between|from)?\s*(%s)(?:\s+(20\d\d))?\s+%s\s+(%s)(?:\s+(20\d\d))?\b"
        % (MRX, SEP, MRX),
        q,
        re.IGNORECASE
    )
    qrange = re.search(r"\b(?:between|from)\s+q([1-4])(?:\s+(20\d\d))?\s+%s\s+q([1-4])(?:\s+(20\d\d))?\b" % SEP, q)
    yrange = re.search(r"\b(?:between|from)\s+(20\d\d)\s+%s\s+(20\d\d)\b" % SEP, q)

    # Explicit calendar year: CY2026 / CY 2026 / Calendar Year 2026
    cy_match = re.search(
        r"\b(?:CY\s*|calendar\s+year\s+)(20\d{2})\b",
        q,
        re.IGNORECASE,
    )

    if mrange:
        m1 = MN.index(mrange.group(1)) + 1
        m2 = MN.index(mrange.group(3)) + 1

        g1, g2 = mrange.group(2), mrange.group(4)

        if g1 or g2:
            y1 = int(g1 or g2)
            y2 = int(g2 or g1)

            if not g2 and (y1, m1) > (y2, m2):
                y2 += 1
        else:
            y2 = ly if re.search(r"\b(current|this)\s+year\b", q) else pick(m2)
            y1 = y2 if m1 <= m2 else y2 - 1

        a = pd.Timestamp(y1, m1, 1)
        b = pd.Timestamp(y2, m2, 1) + pd.offsets.MonthEnd(0)

        d = d[(d[dc] >= a) & (d[dc] < b + pd.Timedelta(days=1))]

        notes.append(
            "Scope: %s %d to %s %d"
            % (MN[m1 - 1].title(), y1, MN[m2 - 1].title(), y2)
        )

    elif cy_match:
        year = int(cy_match.group(1))
        a = pd.Timestamp(year, 1, 1)
        b = pd.Timestamp(year + 1, 1, 1)

        d = d[(d[dc] >= a) & (d[dc] < b)]

        notes.append(
            "Scope: Calendar Year %d (%s to %s)"
            % (year, a.date(), (b - pd.Timedelta(days=1)).date())
        )

    elif to_ytd or to_mtd or to_qtd:
        mx = d[dc].max()
        ym = re.search(r"\b(20\d\d)\b", q)
        y = int(ym.group(1)) if ym else int(mx.year)
        sub = d[d[dc].dt.year == y]
        name = "YTD"
        if to_mtd and not to_ytd:
            sub = sub[sub[dc].dt.month == (sub[dc].max().month if len(sub) else mx.month)]; name = "MTD"
        elif to_qtd and not to_ytd:
            sub = sub[sub[dc].dt.quarter == (sub[dc].max().quarter if len(sub) else mx.quarter)]; name = "QTD"
        d = sub
        if not d.empty:
            notes.append("Scope: %s (%s to %s)" % (name, d[dc].min().date(), d[dc].max().date()))
    elif mrange:
        m1 = MN.index(mrange.group(1)) + 1
        m2 = MN.index(mrange.group(3)) + 1

        g1, g2 = mrange.group(2), mrange.group(4)

        if g1 or g2:
            y1 = int(g1 or g2)
            y2 = int(g2 or g1)

            if not g2 and (y1, m1) > (y2, m2):
                y2 += 1
        else:
            y2 = ly if re.search(r"\b(current|this)\s+year\b", q) else pick(m2)
            y1 = y2 if m1 <= m2 else y2 - 1
            notes.append("Year taken from the data: %d (add a year to change)" % y2)

        a = pd.Timestamp(y1, m1, 1)
        b = pd.Timestamp(y2, m2, 1) + pd.offsets.MonthEnd(0)

        d = d[(d[dc] >= a) & (d[dc] < b + pd.Timedelta(days=1))]

        notes.append(
            "Scope: %s %d to %s %d"
            % (MN[m1 - 1].title(), y1, MN[m2 - 1].title(), y2)
        )

    elif len(ds) >= 2 and re.search(r"between|from|\bto\b|\band\b|till|until", q):
        a, b = ds[0][1], ds[1][1]

        if a > b:
            a, b = b, a

        d = d[
            (d[dc] >= a) &
            (d[dc] <= b + pd.Timedelta(days=1) - pd.Timedelta(seconds=1))
        ]

        notes.append("Date range: %s to %s" % (a.date(), b.date()))

    elif len(ds) == 1:
        d = d[d[dc].dt.normalize() == ds[0][1]]
        notes.append("Date: %s" % ds[0][1].date())
        m1, m2 = MN.index(mrange.group(1)) + 1, MN.index(mrange.group(3)) + 1
        g1, g2 = mrange.group(2), mrange.group(4)
        if g1 or g2:
            y1 = int(g1 or g2); y2 = int(g2 or g1)
            if not g2 and (y1, m1) > (y2, m2):
                y2 += 1
        else:
            y2 = ly if re.search(r"\b(current|this)\s+year\b", q) else pick(m2)
            y1 = y2 if m1 <= m2 else y2 - 1
            notes.append("Year taken from the data: %d (add a year to change)" % y2)
        a = pd.Timestamp(y1, m1, 1)
        b = pd.Timestamp(y2, m2, 1) + pd.offsets.MonthEnd(0)
        d = d[(d[dc] >= a) & (d[dc] < b + pd.Timedelta(days=1))]
        notes.append("Scope: %s %d to %s %d" % (MN[m1 - 1].title(), y1, MN[m2 - 1].title(), y2))
    elif qrange:
        q1, q2 = int(qrange.group(1)), int(qrange.group(3))
        g = qrange.group(2) or qrange.group(4)
        if not g and re.search(r"\b(current|this)\s+year\b", q):
            g = str(ly)
        if q1 > q2:
            q1, q2 = q2, q1
        if g:
            a = pd.Timestamp(int(g), (q1 - 1) * 3 + 1, 1)
            b = pd.Timestamp(int(g), q2 * 3, 1) + pd.offsets.MonthEnd(0)
            d = d[(d[dc] >= a) & (d[dc] < b + pd.Timedelta(days=1))]
            notes.append("Scope: Q%d to Q%d %s" % (q1, q2, g))
        else:
            d = d[(d[dc].dt.quarter >= q1) & (d[dc].dt.quarter <= q2)]
            notes.append("Scope: Q%d to Q%d" % (q1, q2))
            yrs_ = sorted(set(d[dc].dt.year.dropna().astype(int)))
            if len(yrs_) > 1:
                notes.append("Combined across years %s (add a year for one)" % ", ".join(map(str, yrs_)))
    elif yrange:
        y1, y2 = sorted((int(yrange.group(1)), int(yrange.group(2))))
        d = d[(d[dc].dt.year >= y1) & (d[dc].dt.year <= y2)]
        notes.append("Scope: %d to %d" % (y1, y2))
    else:
        q_scope = q.lower()
        numeric_month_year = re.search(
            r"(?<![\d./-])(?:(0?[1-9]|1[0-2])[-/.](20\d{2})|(20\d{2})[-/.](0?[1-9]|1[0-2]))(?![\d./-])", q_scope)
        yr = re.search(r"\b(20\d\d)\b", q_scope)

        # A year-like number used as a numeric comparison value
        # must not become a date/year filter.
        if yr:
            year_prefix = q_scope[max(0, yr.start() - 100):yr.start()]

            numeric_operand = re.search(
                r"(?:"
                r"\b(?:greater\s+than|more\s+than|higher\s+than|above|over|"
                r"at\s+least|less\s+than|lower\s+than|below|under|at\s+most)"
                r"\s*"
                r"|(?:>=|<=|>|<)\s*"
                r"|\bbetween\s+\d+(?:\.\d+)?\s+and\s*"
                r")$",
                year_prefix,
                flags=re.IGNORECASE,
            )

            if numeric_operand:
                yr = None
        mo = re.search(r"\b(%s)\b" % MRX, q_scope)
        qq = re.search(r"\bq([1-4])\b", q_scope)
        lab = []
        if numeric_month_year:
            if numeric_month_year.group(1):
                numeric_month, numeric_year = int(numeric_month_year.group(1)), int(numeric_month_year.group(2))
            else:
                numeric_year, numeric_month = int(numeric_month_year.group(3)), int(numeric_month_year.group(4))
            d = d[(d[dc].dt.month == numeric_month) & (d[dc].dt.year == numeric_year)]
            lab.extend([MN[numeric_month - 1].title(), str(numeric_year)])
            yr = None
            mo = None
            qq = None
        if mo:
            d = d[d[dc].dt.month == MN.index(mo.group(1)) + 1]; lab.append(mo.group(1).title())
        if qq:
            d = d[d[dc].dt.quarter == int(qq.group(1))]; lab.append("Q" + qq.group(1))
        if yr:
            d = d[d[dc].dt.year == int(yr.group(1))]; lab.append(yr.group(1))
        if lab:
            notes.append("Scope: " + " ".join(lab))
            if (mo or qq) and not yr:
                yrs = sorted(set(d[dc].dt.year.dropna().astype(int)))
                if len(yrs) > 1:
                    notes.append("Combined across years %s (add a year for one)" % ", ".join(map(str, yrs)))
        # Calendar-based first/last N days of a named month and year.
        day_span = re.search(
            r"\b(first|last)\s+(\d+)\s+days?\s+"
            r"(?:of|in|during)\s+(%s)\s+(20\d{2})\b" % MRX,
            q,
        )
        day_span_applied = False

        if day_span:
            side = day_span.group(1)
            n_days = int(day_span.group(2))
            month_num = MN.index(day_span.group(3)) + 1
            year_num = int(day_span.group(4))

            if n_days < 1:
                return d, notes, "day count must be at least 1"

            month_start = pd.Timestamp(year_num, month_num, 1)
            month_end = month_start + pd.offsets.MonthEnd(0)
            days_in_month = month_end.day

            if side == "first":
                start_day = 1
                end_day = min(n_days, days_in_month)
            else:
                start_day = max(1, days_in_month - n_days + 1)
                end_day = days_in_month

            a = pd.Timestamp(year_num, month_num, start_day)
            b = pd.Timestamp(year_num, month_num, end_day)

            d = d[
                (d[dc] >= a) &
                (d[dc] < b + pd.Timedelta(days=1))
            ]
            notes.append("Date range: %s to %s" % (a.date(), b.date()))
            day_span_applied = True

        fst = re.search(r"\b(first|earliest|oldest|initial|starting|opening)\s+(?:(\d+)\s+)?(?:available\s+)?(month|year|quarter|day)s?\b", q)
        if fst and not day_span_applied and not re.search(r"\bfirst\s+\d+\s+(invoices?|transactions?|records?|rows?)", q):
            fr_ = {"month": "M", "year": "Y", "quarter": "Q", "day": "D"}[fst.group(3)]
            n_ = int(fst.group(2)) if fst.group(2) else 1
            ps = d[dc].dt.strftime("%Y-%m-%d") if fr_ == "D" else d[dc].dt.to_period(fr_).astype(str)
            uq = sorted(ps.dropna().unique())
            sel_ = uq[:n_]
            d = d[ps.isin(sel_)]
            notes.append("First %d %s%s: %s" % (n_, fst.group(3), "s" if n_ > 1 else "", ", ".join(sel_)))
        rel = re.search(r"\b(latest|last|previous|prior|current|this)\s+(?:available\s+)?(month|year|quarter)\b", q) if not (mo or qq or yr) else None
        if rel and not re.search(r"\b(latest|previous|prior|last)\s+\d+\b", q):
            fr = {"month": "M", "year": "Y", "quarter": "Q"}[rel.group(2)]
            full = d[dc].dt.to_period(fr)
            u = sorted(full.dropna().unique())
            if u:
                word = rel.group(1)
                has_cur = re.search(r"\b(current|this)\s+(month|year|quarter)\b", q)
                want_prev = word in ("previous", "prior", "last")
                sel = (u[-2] if len(u) > 1 else None) if want_prev else u[-1]
                if sel is None:
                    return d, notes, "no previous %s in data" % rel.group(2)
                d = d[full == sel]
                tail = (" (the %s before the latest one in the data, %s)" % (rel.group(2), u[-1])) if want_prev else \
                    (" (most recent %s in the data)" % rel.group(2) if word in ("current", "this") else "")
                notes.append("Scope: %s %s = %s%s" % (word.title(), rel.group(2), sel, tail))
    if d.empty:
        return d, notes, "no rows for the requested date range"
    return d, notes, None


def _entities(q, d, cols):
    """returns (df, notes, unknown_phrase). exact full-value match first, then name tokens, else unknown 'for X'."""
    notes = []
    qq = re.sub(r"'s\b", "", q)
    applied = False
    for cname, cands in CATS:
        c = _col(cols, cands)
        if not c:
            continue
        vals = sorted({str(v) for v in d[c].dropna().unique()}, key=len, reverse=True)
        hits, rest = [], qq
        for v in vals:
            rx = r"(?<![a-z0-9])%s(?![a-z0-9])" % re.escape(v.lower())
            if len(v) >= 3 and re.search(rx, rest):
                hits.append(v)
                rest = re.sub(rx, " ", rest)
        if hits:
            d = d[d[c].astype(str).isin(hits)]
            notes.append("%s: %s" % (c, ", ".join(hits))); applied = True
    pc = _col(cols, ["PartyName", "Party Name", "Customer Name"])
    if pc and not any(n.startswith(pc + ":") for n in notes):
        toks = set()
        for name in d[pc].dropna().unique():
            toks.update(w for w in re.findall(r"[a-z]+", str(name).lower()) if len(w) >= 3)
        words = [w for w in re.findall(r"[a-z]+", qq) if w in toks and w not in STOP]
        if words:
            low = d[pc].astype(str).str.lower()
            allm = low.apply(lambda s: all(w in s.split() for w in words))
            mask = allm if allm.any() else low.apply(lambda s: any(w in s.split() for w in words))
            if mask.any():
                d = d[mask]; applied = True
                names = sorted(d[pc].astype(str).unique())
                notes.append("Customers matched: " + ", ".join(names[:8]) + (" ..." if len(names) > 8 else ""))
    unknown = None
    if not applied:
        m = re.search(r"\b(?:for|of|from|to)\s+([a-z][a-z .&'-]{2,40}?)(?:\s+(?:in|during|on|from|between|by|and)\b|$|\?|\.|,)", qq)
        if m:
            entity_phrase = m.group(1)
            if _dates(qq):
                entity_phrase = re.sub(
                    r"\b(?:first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth|eleventh|twelfth|thirteenth|"
                    r"fourteenth|fifteenth|sixteenth|seventeenth|eighteenth|nineteenth|twentieth|thirtieth|"
                    r"one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|"
                    r"sixteen|seventeen|eighteen|nineteen|twenty(?:\s+(?:one|two|three|four|five|six|seven|eight|nine))?|"
                    r"thirty(?:\s+one)?|\d{1,4})\b", " ", entity_phrase, flags=re.I)
            words = [w for w in re.findall(r"[a-z]+", entity_phrase) if w not in STOP and w not in MN and w not in DOMAIN_WORDS]
            if words and not re.search(r"\b(20\d\d|q[1-4])\b", m.group(1)):
                unknown = " ".join(words)
    return d, notes, unknown


def _agg_of(q):
    if re.search(r"\bmedian\b", q):
        return "median"
    if re.search(r"average|\bavg\b|\bmean\b", q):
        return "mean"
    return "sum"


def _aggregate(s, agg):
    return float(getattr(s, agg)())


def _scalar_val(d, col, agg):
    if col == "__invcount__":
        return float(d["__inv__"].nunique())
    if col == "__margin__":
        g = d["__gross__"].sum()
        return float(d["__profit__"].sum() / g * 100) if g else float("nan")
    return _aggregate(d[col], agg)


def _period_series(d, dc, per):
    if per == "D":
        return d[dc].dt.strftime("%Y-%m-%d")
    return d[dc].dt.to_period(per).astype(str)


def _group(d, keys, mets, aggs=None):
    """mets: list of (key,col,label). aggs: {label: sum|mean|median}. returns DataFrame indexed by group, one column per metric label."""
    aggs = aggs or {}
    g = d.groupby(keys)
    def one(col, lab):
        if col == "__margin__":
            return (g["__profit__"].sum() / g["__gross__"].sum().where(g["__gross__"].sum() != 0)) * 100
        if col == "__invcount__":
            return g["__inv__"].nunique()
        return getattr(g[col], aggs.get(lab, "sum"))()
    out = pd.DataFrame({lab: one(col, lab) for _k, col, lab in mets})
    return out


def _span(d, dc):
    """Human-readable period actually covered by the (already filtered) rows, e.g. 'Apr 2025 - Jun 2025'."""
    if not dc or d is None or d.empty:
        return None
    a, b = d[dc].min(), d[dc].max()
    if pd.isna(a) or pd.isna(b):
        return None
    if a.date() == b.date():
        return a.strftime("%d %b %Y")
    fa, fb = a.strftime("%b %Y"), b.strftime("%b %Y")
    return fa if fa == fb else "%s - %s" % (fa, fb)


def _find_dim(q, cols):
    best = None
    for name, rx, cands in DIMS:
        m = re.search(rx, q)
        if m and (best is None or m.start() < best[0] or (m.start() == best[0] and len(m.group(0)) > best[3])):
            best = (m.start(), name, _col(cols, cands), len(m.group(0)))
    return best



# ------------------------------------------------------------------ spelling tolerance
import difflib

DOMAIN_WORDS = set("""sales sale revenue turnover billing business profit profits margin margins gst tax discount discounts quantity qty units
customer customers party parties client clients buyer buyers product products item items category categories state states payment mode modes method methods
invoice invoices transaction transactions record records month months monthly year years yearly annual annually quarter quarters quarterly day days daily week weekly
highest lowest top bottom best worst most least maximum minimum average mean median total sum count number growth change compare comparison versus difference
increase decrease percentage percent share contribution trend ranking rank winner winners winning champion champions correlation correlated summary rolling cumulative running above below between
latest previous last first recent current wise show give list tell find what which who whom whose how much many where when does have has did are were was is the and for with from
during within without while which whose where when why what who whom will would could should being been does done using used each every per across over under than their there them these those this that selling sold sell bought buy purchase supplier stock employee attendance
cash upi cheque credit card bank transfer retail wholesale dealer online marketplace buyer name names date dates amount value values all any only also not but
january february march april may june july august september october november december
second third fourth fifth sixth seventh eighth ninth tenth eleventh twelfth thirteenth fourteenth fifteenth sixteenth seventeenth eighteenth nineteenth
twentieth thirtieth thirty twenty one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen
rate rates paid pay percent report reports data available current both next ytd mtd qtd greater less equal breakdown distribution where having generated generate""".split())


def _vocab(df):
    v = set(DOMAIN_WORDS)
    for _n_, cands in CATS:
        c = _col(list(df.columns), cands)
        if c:
            for val in df[c].dropna().astype(str).unique():
                v.update(w for w in re.findall(r"[a-z]+", val.lower()) if len(w) >= 3)
    return v


def _fix_typos(q, df):
    """Repairs misspelt words by matching them to the domain vocabulary + real values in the data.
    Only unknown words are touched; known words, numbers and dates are left alone."""
    vocab = _vocab(df)
    # Protect "unit" as a valid business term.
    # Prevent fuzzy correction: unit -> units.
    vocab.add("unit")
    by_first = {}
    for w in vocab:
        if len(w) >= 4:
            by_first.setdefault(w[0], []).append(w)
    fixes = []

    def sub(m):
        w = m.group(0)
        if len(w) < 4 or w in vocab:
            return w

        # Preserve common grammatical inflections when their base word is
        # already known. E.g. recorded -> record was a false typo correction.
        if (
            (w.endswith("ed") and (w[:-2] in vocab or w[:-1] in vocab))
            or (w.endswith("s") and w[:-1] in vocab)
            or (w.endswith("ies") and (w[:-3] + "y") in vocab)
        ):
            return w

        pool = by_first.get(w[0], []) + [x for x in vocab if len(x) >= 4 and x[0] != w[0] and len(w) >= 6 and abs(len(x) - len(w)) <= 1]
        best = difflib.get_close_matches(w, pool, n=1, cutoff=0.8)
        if best:
            fixes.append((w, best[0]))
            return best[0]
        return w
    fixed = re.sub(r"[a-z]+", sub, q)
    return fixed, fixes

def handle(question, df, skip_entity=False):
    q = str(question or "").lower().strip()
    q = q.replace("\u2019", "'")
    if not q or df is None or df.empty:
        return None
    cols = list(df.columns)
    q = _normalize_numbers(_norm_months(q))
    q, _typo_fixes = _fix_typos(q, df)

    for name, (rx, hints) in NA_WORDS.items():
        if re.search(rx, q) and not any(h in _n(c) for c in cols for h in hints):
            return _na("'%s' is not present in this dataset's columns" % name)

    dc = _col(cols, ["Date", "Bill Date", "Invoice Date"])
    d = df.copy()
    if dc:
        d[dc] = pd.to_datetime(d[dc], errors="coerce")

    bad_date = _invalid_date(q)
    if bad_date:
        return _na("'%s' is not a valid calendar date" % bad_date)
    if dc and re.search(r"\bnext\s+(?:month|quarter|year|week)\b|\bupcoming\b|\btomorrow\b", q) and d[dc].notna().any():
        return _na("a future period was requested, but the uploaded data only covers %s to %s" % (d[dc].min().date(), d[dc].max().date()))

    # --------------------------------------------------------------

    # --------------------------------------------------------------
    
    # --------------------------------------------------------------
    # GENERIC_ENTITY_MONTHLY_TOPN_FAILURE_V1
    # Supports Product, Customer/Party and Category from real values.
    # Ranking always compares against all entities in the selected scope.
    # --------------------------------------------------------------
    failure_cue = bool(re.search(
        r"\b(fail(?:ed|ure)?|did\s+not|does\s+not|not\s+reach|"
        r"miss(?:ed)?|outside\s+the)\b",
        q
    ))
    top_cue = bool(re.search(
        r"\btop\s*\d+\b|\btop\s+(?:one|two|three|four|five|six|seven|eight|nine|ten)\b",
        q
    ))
    monthly_cue = bool(re.search(
        r"\bmonths?\b|monthly|month[\s-]*wise",
        q
    ))

    if failure_cue and top_cue and monthly_cue and dc and d[dc].notna().any():
        # Resolve which dataset dimension the user is asking about.
        if re.search(r"\b(categories|category)\b", q):
            entity_col = _col(cols, ["Category"])
            entity_label = "Category"
        elif re.search(
            r"\b(customers?|parties|party|clients?|buyers?)\b", q
        ):
            entity_col = _col(
                cols, ["PartyName", "Party Name", "Customer Name"]
            )
            entity_label = "Customer/Party"
        else:
            entity_col = _col(cols, ["Product", "Item Name"])
            entity_label = "Product"

        if not entity_col:
            return _na(
                "%s column is missing from the uploaded dataset."
                % entity_label
            )

        # Resolve Top N; default to 3 only when the question says "top"
        # without specifying a number.
        number_words = {
            "one": 1, "two": 2, "three": 3, "four": 4, "five": 5,
            "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10,
        }
        top_match = re.search(
            r"\btop\s*(\d+)\b|\btop\s+(one|two|three|four|five|six|seven|eight|nine|ten)\b",
            q
        )
        top_n = 3
        if top_match:
            top_n = (
                int(top_match.group(1))
                if top_match.group(1)
                else number_words[top_match.group(2)]
            )
        if top_n < 1 or top_n > 100:
            return _na("Top N must be between 1 and 100.")

        # Metric requested by the user.
        if re.search(r"\b(profit|gross\s+profit)\b", q):
            metric_col = _col(cols, ["Profit"])
            metric_key = "sales"
            metric_label = "Profit"
        elif re.search(r"\b(quantity|qty|units)\b", q):
            metric_col = _col(cols, ["Qty", "Quantity", "Quantity Sold"])
            metric_key = "qty"
            metric_label = "Quantity"
        else:
            metric_col = _col(
                cols,
                ["GrossAmount", "Gross Amount", "Sales Amount", "SalesAmount"]
            )
            metric_key = "sales"
            metric_label = "Revenue"

        if not metric_col:
            return _na(
                "%s metric column is missing from the uploaded dataset."
                % metric_label
            )

        # Resolve the exact entity from values present in the dataset.
        def _entity_norm(value):
            return re.sub(r"[^a-z0-9]+", " ", str(value).casefold()).strip()

        question_norm = " " + _entity_norm(q) + " "
        entity_values = sorted(
            {
                str(value).strip()
                for value in d[entity_col].dropna().unique()
                if str(value).strip()
            },
            key=lambda value: len(_entity_norm(value)),
            reverse=True
        )

        matched_entities = [
            value for value in entity_values
            if _entity_norm(value)
            and (" " + _entity_norm(value) + " ") in question_norm
        ]

        if not matched_entities:
            return _na(
                "Could not identify the requested %s from actual dataset values."
                % entity_label.lower()
            )

        target_entity = matched_entities[0]

        # Apply requested date scope, but do NOT filter to the target entity:
        # all entities must remain available for a valid ranking.
        work, scope_notes, scope_error = _scope(q, d.copy(), dc)
        if scope_error:
            return _na(scope_error)

        work = work[[dc, entity_col, metric_col]].copy()
        work["__metric__"] = pd.to_numeric(
            work[metric_col], errors="coerce"
        )
        work["__entity__"] = (
            work[entity_col].fillna("").astype(str).str.strip()
        )
        work = work[
            work[dc].notna()
            & (work["__entity__"] != "")
            & work["__metric__"].notna()
        ].copy()

        if work.empty:
            return _na("No dated rows are available for this ranking.")

        work["__period__"] = work[dc].dt.to_period("M")

        grouped = (
            work.groupby(["__period__", "__entity__"], as_index=False)
            .agg(Value=("__metric__", "sum"))
        )

        grouped["Rank"] = (
            grouped.groupby("__period__")["Value"]
            .rank(method="min", ascending=False)
            .astype(int)
        )

        target_norm = _entity_norm(target_entity)
        target_rows = grouped[
            grouped["__entity__"].map(_entity_norm) == target_norm
        ].set_index("__period__")

        periods = sorted(work["__period__"].dropna().unique())
        display_rows = []
        failed_periods = []

        for period in periods:
            if period in target_rows.index:
                target_row = target_rows.loc[period]
                rank = int(target_row["Rank"])
                value = float(target_row["Value"])
                reached = rank <= top_n
                rank_text = str(rank)
                value_text = _fmt(metric_key, value)
            else:
                rank = None
                value = None
                reached = False
                rank_text = "Not present"
                value_text = "-"

            if not reached:
                failed_periods.append(str(period))

            display_rows.append({
                "Month": str(period),
                "Entity": target_entity,
                "Rank": rank_text,
                metric_label: value_text,
                "Reached Top N": "Yes" if reached else "No",
            })

        failed_count = len(failed_periods)
        total_periods = len(periods)

        answer = (
            f"{target_entity} failed to reach the top {top_n} "
            f"by {metric_label.lower()} in {failed_count} "
            f"out of {total_periods} months."
        )

        display_table = [
            [
                row["Month"], row["Entity"], row["Rank"],
                row[metric_label], row["Reached Top N"]
            ]
            for row in display_rows
        ]

        answer += "\n\n" + _table(
            f"{entity_label} monthly {metric_label.lower()} ranking",
            ["Month", entity_label, "Rank", metric_label, "Reached Top N"],
            display_table
        )

        notes = list(scope_notes) + [
            f"Entity type: {entity_label}",
            f"Target entity: {target_entity}",
            f"Monthly metric: sum of {metric_col}",
            f"Ranking: all {entity_label.lower()} values compared each month",
            "Tied values use competition ranking.",
            "Months with no target-entity rows count as failures.",
        ]
        answer += "".join("\n- " + note for note in notes)

        return _out(
            answer,
            table=display_rows,
            target_entity=target_entity,
            entity_type=entity_label,
            top_n=top_n,
            failed_months=failed_count,
            total_months=total_periods,
            filtered_rows=int(len(work)),
            source_rows=int(len(df)),
            scope_notes=notes,
        )

    # --------------------------------------------------------------
# LOW_QUANTITY_HIGH_REVENUE_V1
    # Separate quantity from revenue; calculate from actual uploaded rows.
    low_high_cue = (
        bool(re.search(r"\bproducts?\b|\bitems?\b", q))
        and bool(re.search(
            r"low(?:est|er)?|least|fewest|smallest|quantity|\bqty\b|units",
            q,
        ))
        and bool(re.search(
            r"highest revenue|high revenue|generate.*revenue|"
            r"revenue.*highest|sales.*revenue|\bturnover\b",
            q,
        ))
    )

    if low_high_cue:
        # Apply the same customer/entity and period filters as normal queries.
        comparison_notes = []

        comparison_df = d.copy()

        if not skip_entity:
            comparison_df, entity_notes, unknown_entity = _entities(
                q, comparison_df, cols
            )
            if unknown_entity:
                return _na(
                    "'%s' not found in this dataset" % unknown_entity.title()
                )
            comparison_notes.extend(entity_notes)

        comparison_df, date_notes, date_error = _scope(
            q, comparison_df, dc
        )
        if date_error:
            return _na(date_error)

        comparison_notes.extend(date_notes)
        d = comparison_df

        product_col = _col(cols, ["Product", "Item Name"])
        qty_col = _col(cols, ["Qty", "Quantity", "Quantity Sold"])
        revenue_col = _col(
            cols, ["GrossAmount", "Gross Amount", "Sales Amount", "SalesAmount"]
        )

        if not product_col or not qty_col or not revenue_col:
            return _na(
                "Product, quantity (Qty), or revenue (GrossAmount) "
                "column is missing from the uploaded dataset."
            )

        work = d[[product_col, qty_col, revenue_col]].copy()
        work[product_col] = work[product_col].astype("string").str.strip()
        work["__qty__"] = pd.to_numeric(work[qty_col], errors="coerce")
        work["__revenue__"] = pd.to_numeric(work[revenue_col], errors="coerce")
        work = work.dropna(subset=[product_col])
        work = work[work[product_col] != ""]

        if work.empty:
            return _na("No product rows are available for this comparison.")

        summary = (
            work.groupby(product_col, as_index=False)
            .agg(
                **{
                    "Quantity Sold": ("__qty__", "sum"),
                    "Revenue": ("__revenue__", "sum"),
                }
            )
            .dropna(subset=["Quantity Sold", "Revenue"])
        )

        if summary.empty:
            return _na("No numeric quantity and revenue values were found.")

        # Rank independently. Do not describe low quantity as low revenue.
        lowest_qty = summary.sort_values(
            ["Quantity Sold", "Revenue", product_col],
            ascending=[True, False, True],
            kind="stable",
        ).head(5)

        highest_revenue = summary.sort_values(
            ["Revenue", "Quantity Sold", product_col],
            ascending=[False, True, True],
            kind="stable",
        ).head(5)

        # Transparent definition: bottom 25% by quantity and top 25% by revenue.
        qty_cutoff = summary["Quantity Sold"].quantile(0.25)
        revenue_cutoff = summary["Revenue"].quantile(0.75)
        matching = summary[
            (summary["Quantity Sold"] <= qty_cutoff)
            & (summary["Revenue"] >= revenue_cutoff)
        ].sort_values(
            ["Revenue", "Quantity Sold", product_col],
            ascending=[False, True, True],
            kind="stable",
        )

        display_rows = []
        for label, frame in (
            ("Lowest quantity", lowest_qty),
            ("Highest revenue", highest_revenue),
            ("Low quantity + high revenue", matching),
        ):
            if frame.empty:
                display_rows.append([label, "No matching products", "-", "-"])
            else:
                for _, row in frame.iterrows():
                    display_rows.append([
                        label,
                        str(row[product_col]),
                        _fmt("qty", float(row["Quantity Sold"])),
                        _fmt("sales", float(row["Revenue"])),
                    ])

        answer = _table(
            "Product quantity vs revenue analysis",
            ["Finding", "Product", "Quantity Sold", "Revenue"],
            display_rows,
        )
        answer += "".join("\n- " + note for note in comparison_notes)
        answer += (
            "\n- Revenue is calculated as the sum of GrossAmount per product."
            "\n- Low quantity + high revenue means bottom 25% by quantity "
            "and top 25% by revenue."
            "\n- Results are calculated from the uploaded dataset."
        )

        return _out(
            answer,
            table=[
                {
                    "Finding": label,
                    "Product": str(row[product_col]),
                    "Quantity Sold": float(row["Quantity Sold"]),
                    "Revenue": float(row["Revenue"]),
                }
                for label, frame in (
                    ("Lowest quantity", lowest_qty),
                    ("Highest revenue", highest_revenue),
                    ("Low quantity + high revenue", matching),
                )
                for _, row in frame.iterrows()
            ],
            filtered_rows=int(len(work)),
            scope_notes=list(comparison_notes) + [
                "Quantity ranked independently from revenue",
                "Revenue uses summed GrossAmount",
                "Low quantity + high revenue uses bottom 25% quantity and top 25% revenue",
            ],
        )

    # GENERIC RELATIVE-MONTH QUERY: "N months before the latest month"
    # Resolve the offset against periods actually present in the uploaded data.
    # This is deliberately data-driven rather than based on today's calendar.
    # --------------------------------------------------------------
    relative_month = re.search(
        r"\b(\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\s+months?\s+before\s+(?:the\s+)?(?:latest|most recent|current)\s+month\b",
        q,
    )
    if dc and relative_month and d[dc].notna().any():
        number_words = {"one": 1, "two": 2, "three": 3, "four": 4, "five": 5,
                        "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10,
                        "eleven": 11, "twelve": 12}
        offset = int(relative_month.group(1)) if relative_month.group(1).isdigit() else number_words[relative_month.group(1)]
        available_periods = d.loc[d[dc].notna(), dc].dt.to_period("M")
        target_period = available_periods.max() - offset
        selected = d[available_periods == target_period].copy()
        metric_hits = _metric(q)
        # "gross amount" / "gross sales" are explicit sales-metric aliases.
        if re.search(r"\bgross[\s_-]*(?:amount|sales)\b", q) and not any(m[1] == "sales" for m in metric_hits):
            metric_hits.append((0, "sales", ["GrossAmount", "Gross Amount", "Sales Amount", "SalesAmount"], "Gross Amount"))
        if not metric_hits:
            return None
        output_metrics = []
        for _pos, key, candidates, label in metric_hits:
            col = _col(cols, candidates)
            if col:
                output_metrics.append((key, col, label))
        if not output_metrics:
            return None
        if selected.empty:
            return _na("the requested month %s is outside the uploaded data range" % target_period)
        totals = {}
        for key, col, label in output_metrics:
            values = pd.to_numeric(selected[col], errors="coerce")
            totals[label] = float(values.sum()) if key not in ("margin",) else None
        shown = [[label, _fmt(key, totals[label]) if totals[label] is not None else "-"]
                 for key, _colname, label in output_metrics]
        txt = _table("Results for %s (%d month(s) before latest available month)" % (target_period, offset), ["Metric", "Value"], shown)
        txt += "\n- Latest available month: %s\n- Selected month: %s" % (available_periods.max(), target_period)
        return _out(txt, table=[{"period": str(target_period), **totals}], totals=totals,
                    filtered_rows=int(len(selected)), period_label=str(target_period),
                    scope_notes=["Latest available month: %s" % available_periods.max(), "Offset: %d months" % offset])

    # --------------------------------------------------------------


    # RETAIL_CUSTOMER_MONTHLY_PRODUCT_WINNER_V1
    # Option B:
    # 1) Find the top product by monthly retail-customer GrossAmount.
    # 2) For that product, find the retail customer with highest sales.

    retail_monthly_pair_cue = (
        bool(re.search(r"\bretail\b", q))
        and bool(re.search(r"\bcustomers?\b|\bclients?\b", q))
        and bool(re.search(r"\bproducts?\b|\bitems?\b", q))
        and bool(re.search(r"\bmonths?\b|monthly|month[\s-]*wise", q))
        and bool(re.search(
            r"\b(highest|highestest|maximum|max|most|top|largest|biggest)\b",
            q,
        ))
        and bool(re.search(
            r"\b(sales|revenue|turnover|selling|sold)\b", q
        ))
    )

    if retail_monthly_pair_cue and dc and d[dc].notna().any():
        retail_type_col = _col(cols, ["PartyType", "Party Type"])
        retail_customer_col = _col(
            cols, ["PartyName", "Party Name", "Customer Name"]
        )
        retail_product_col = _col(cols, ["Product", "Item Name"])
        retail_sales_col = _col(
            cols,
            ["GrossAmount", "Gross Amount", "Sales Amount", "SalesAmount"],
        )
        retail_qty_col = _col(cols, ["Qty", "Quantity", "Quantity Sold"])

        required = (
            retail_type_col,
            retail_customer_col,
            retail_product_col,
            retail_sales_col,
        )

        if not all(required):
            return _na(
                "Retail customer, product, sales, or party-type columns "
                "are missing from the uploaded dataset."
            )

        retail_df = d[
            d[retail_type_col]
            .fillna("")
            .astype(str)
            .str.strip()
            .str.casefold()
            .isin({"retail customer", "retail customers"})
        ].copy()

        if retail_df.empty:
            return _na(
                "No rows with PartyType = Retail Customer were found."
            )

        retail_df = retail_df[
            retail_df[dc].notna()
            & retail_df[retail_customer_col].notna()
            & retail_df[retail_product_col].notna()
        ].copy()

        retail_df["__retail_sales__"] = pd.to_numeric(
            retail_df[retail_sales_col], errors="coerce"
        ).fillna(0)

        if retail_qty_col:
            retail_df["__retail_qty__"] = pd.to_numeric(
                retail_df[retail_qty_col], errors="coerce"
            ).fillna(0)
        else:
            retail_df["__retail_qty__"] = 0

        retail_df["__month__"] = (
            retail_df[dc].dt.to_period("M").astype(str)
        )
        retail_df["__customer_key__"] = (
            retail_df[retail_customer_col].astype(str).str.strip()
        )
        retail_df["__product_key__"] = (
            retail_df[retail_product_col].astype(str).str.strip()
        )

        # Stage 1: rank products by total retail sales in each month.
        product_totals = (
            retail_df.groupby(
                ["__month__", "__product_key__"],
                as_index=False,
                dropna=False,
            )
            .agg(
                **{
                    "Product Total Sales": ("__retail_sales__", "sum"),
                }
            )
        )

        if product_totals.empty:
            return _na(
                "No retail customer-product sales rows were available."
            )

        product_totals = product_totals.sort_values(
            ["__month__", "Product Total Sales", "__product_key__"],
            ascending=[True, False, True],
            kind="stable",
        )

        top_products = product_totals.drop_duplicates(
            subset=["__month__"], keep="first"
        )

        # Stage 2: for each month's winning product, rank its customers.
        records = []
        display_rows = []

        for _, product_row in top_products.iterrows():
            month_value = str(product_row["__month__"])
            product_value = str(product_row["__product_key__"])

            matching = retail_df[
                (retail_df["__month__"] == month_value)
                & (retail_df["__product_key__"] == product_value)
            ]

            customer_totals = (
                matching.groupby(
                    "__customer_key__",
                    as_index=False,
                    dropna=False,
                )
                .agg(
                    **{
                        "Customer Sales": ("__retail_sales__", "sum"),
                        "Quantity Sold": ("__retail_qty__", "sum"),
                    }
                )
            )

            if customer_totals.empty:
                continue

            customer_totals = customer_totals.sort_values(
                ["Customer Sales", "__customer_key__"],
                ascending=[False, True],
                kind="stable",
            )
            customer_winner = customer_totals.iloc[0]

            record = {
                "Month": month_value,
                "Top Product": product_value,
                "Product Total Sales": round(
                    float(product_row["Product Total Sales"]), 2
                ),
                "Retail Customer": str(customer_winner["__customer_key__"]),
                "Customer Sales": round(
                    float(customer_winner["Customer Sales"]), 2
                ),
                "Quantity Sold": float(customer_winner["Quantity Sold"]),
            }
            records.append(record)
            display_rows.append([
                record["Month"],
                record["Top Product"],
                _fmt("sales", record["Product Total Sales"]),
                record["Retail Customer"],
                _fmt("sales", record["Customer Sales"]),
                _fmt("qty", record["Quantity Sold"]),
            ])

        if not records:
            return _na(
                "No monthly top-product retail customer results were found."
            )

        answer = _table(
            "Top-selling product and leading retail customer by month",
            [
                "Month",
                "Top Product",
                "Product Total Sales",
                "Retail Customer",
                "Customer Sales",
                "Quantity Sold",
            ],
            display_rows,
        )
        answer += (
            "\n- Filter: PartyType = Retail Customer"
            "\n- Top product: highest monthly sum of GrossAmount"
            "\n- Customer: highest summed sales for that product in that month"
        )

        return _out(
            answer,
            table=records,
            filtered_rows=int(len(retail_df)),
            period_label=_span(retail_df, dc),
            scope_notes=[
                "PartyType filtered to Retail Customer",
                "Selected the top product by monthly summed GrossAmount",
                "Selected the highest-selling retail customer for that product",
            ],
            chart_spec={
                "type": "bar",
                "x": "Month",
                "series": ["Product Total Sales"],
                "interactive": True,
                "data": records,
            },
        )

    # MONTHLY_PEAK_SALES_AND_PRODUCT_V1
    # Report every month's sales and its best-selling product.
    monthly_peak_cue = (
        bool(re.search(r"month[\s-]*wise|monthly|by month|each month|every month|per month", q))
        and bool(re.search(r"\b(highest|highestest|maximum|max|largest|biggest|most)\b", q))
        and bool(re.search(r"\b(sales|revenue|turnover|gross amount|gross sales)\b", q))
        and bool(re.search(r"\b(which|what|and)\b", q))
    )

    if monthly_peak_cue and dc and _col(cols, ["Product", "Item Name"]) and d[dc].notna().any():
        product_col = _col(cols, ["Product", "Item Name"])
        sales_col = _col(
            cols,
            ["GrossAmount", "Gross Amount", "Sales Amount", "SalesAmount", "Sales"]
        )
        qty_col = _col(cols, ["Qty", "Quantity", "Quantity Sold"])

        if sales_col:
            peak_df, peak_entities, peak_unknown = _entities(q, d, cols)

            if peak_unknown:
                return None

            peak_df, peak_scope_notes, peak_scope_error = _scope(
                q, peak_df, dc
            )

            if peak_scope_error:
                return _na(peak_scope_error)

            if peak_df.empty:
                return _na("No rows match the requested customer and period.")

            peak_df = peak_df.copy()
            peak_df["__month__"] = (
                peak_df[dc].dt.to_period("M").astype(str)
            )
            peak_df["__sales__"] = pd.to_numeric(
                peak_df[sales_col], errors="coerce"
            ).fillna(0)

            if qty_col:
                peak_df["__qty__"] = pd.to_numeric(
                    peak_df[qty_col], errors="coerce"
                ).fillna(0)
            else:
                peak_df["__qty__"] = 0

            monthly_sales = peak_df.groupby("__month__")["__sales__"].sum()
            if monthly_sales.empty:
                return _na("No monthly sales values are available.")

            peak_month = str(monthly_sales.idxmax())
            records = []

            for month_name, month_df in peak_df.groupby("__month__", sort=True):
                product_sales = (
                    month_df.groupby(
                        month_df[product_col].fillna("Unknown").astype(str).str.strip()
                    )["__sales__"]
                    .sum()
                    .sort_values(ascending=False, kind="stable")
                )

                if product_sales.empty:
                    continue

                best_product = str(product_sales.index[0])
                best_rows = month_df[
                    month_df[product_col].fillna("Unknown").astype(str).str.strip()
                    == best_product
                ]

                records.append({
                    "Month": str(month_name),
                    "Total Sales": float(monthly_sales.loc[month_name]),
                    "Highest-selling Product": best_product,
                    "Product Sales": float(product_sales.iloc[0]),
                    "Quantity Sold": float(best_rows["__qty__"].sum()),
                })

            if records:
                display_rows = [
                    [
                        row["Month"],
                        _fmt("sales", row["Total Sales"]),
                        row["Highest-selling Product"],
                        _fmt("sales", row["Product Sales"]),
                        _fmt("qty", row["Quantity Sold"]),
                    ]
                    for row in records
                ]

                answer = _table(
                    "Monthly sales and highest-selling product",
                    ["Month", "Total Sales", "Highest-selling Product",
                     "Product Sales", "Quantity Sold"],
                    display_rows,
                )

                peak_record = next(
                    (row for row in records if row["Month"] == peak_month),
                    None,
                )

                if peak_record:
                    answer += (
                        "\n\nHighest-sales month: %s (%s)"
                        "\nBest-selling product in that month: %s"
                        "\nProduct sales: %s | Quantity sold: %s"
                    ) % (
                        peak_month,
                        _fmt("sales", peak_record["Total Sales"]),
                        peak_record["Highest-selling Product"],
                        _fmt("sales", peak_record["Product Sales"]),
                        _fmt("qty", peak_record["Quantity Sold"]),
                    )

                notes = list(peak_entities) + list(peak_scope_notes)
                answer += "".join("\n- " + note for note in notes)

                return _out(
                    answer,
                    table=records,
                    filtered_rows=int(len(peak_df)),
                    period_label=_span(peak_df, dc),
                    scope_notes=notes,
                )

    # GENERIC PERIOD-WISE WINNER: rank each category/product independently
    # inside every requested period. Never accept an LLM-invented entity filter.
    # --------------------------------------------------------------
    winner_cue = bool(re.search(r"\b(?:winner|winners|winning|best[- ]selling|highest[- ]selling|top[- ]selling|most popular)\b", q))
    period_wise_cue = bool(re.search(r"month[\s-]*wise|monthly|by month|each month|every month|per month", q))
    product_col = _col(cols, ["Product", "Item Name"])
    if dc and product_col and winner_cue and period_wise_cue and d[dc].notna().any():
        metric_hits = _metric(q)
        if re.search(r"\bgross[\s_-]*(?:amount|sales)\b", q) and not any(m[1] == "sales" for m in metric_hits):
            metric_hits.append((0, "sales", ["GrossAmount", "Gross Amount", "Sales Amount", "SalesAmount"], "Gross Amount"))
        if not metric_hits:
            # A bare "winner" defaults to sales only when a sales column exists.
            sales_col = _col(cols, ["GrossAmount", "Gross Amount", "Sales Amount", "SalesAmount"])
            if sales_col:
                metric_hits = [(0, "sales", [sales_col], "Sales")]
        metric_info = []
        for _pos, key, candidates, label in metric_hits:
            col = _col(cols, candidates)
            if col:
                metric_info.append((key, col, label))
        if metric_info:
            winner_df, entity_notes, unknown_entity = _entities(q, d, cols)
            if unknown_entity:
                return None
            winner_df, scope_notes, scope_error = _scope(q, winner_df, dc)
            if scope_error:
                return _na(scope_error)
            if winner_df.empty:
                return _na("no rows match the requested entity and period filters")
            period_keys = winner_df[dc].dt.to_period("M").astype(str)
            result_rows = []
            for period_value, period_df in winner_df.assign(__period_key__=period_keys).groupby("__period_key__", sort=True):
                for key, metric_col, label in metric_info:
                    vals = pd.to_numeric(period_df[metric_col], errors="coerce")
                    totals_by_product = vals.groupby(period_df[product_col].astype(str).str.strip()).sum(min_count=1).dropna()
                    if totals_by_product.empty:
                        continue
                    best_product = str(totals_by_product.idxmax())
                    result_rows.append({"period": str(period_value), "metric": label, "product": best_product,
                                        "value": float(totals_by_product.loc[best_product])})
            if result_rows:
                metric_key_by_label = {label: key for key, _metric_col, label in metric_info}
                display_rows = [[r["period"], r["metric"], r["product"], _fmt(metric_key_by_label.get(r["metric"], "sales"), r["value"])] for r in result_rows]
                answer = _table("Product winner by month", ["Month", "Metric", "Winning product", "Value"], display_rows)
                all_notes = list(entity_notes) + list(scope_notes) + ["Winner selected by highest summed metric within each month"]
                answer += "".join("\n- " + note for note in all_notes)
                return _out(answer, table=result_rows, filtered_rows=int(len(winner_df)), period_label=_span(winner_df, dc),
                            scope_notes=all_notes)

    conds = _conditions(q)
    th = (conds[0]["op"], conds[0]["val"]) if conds else None
    metl = _metric(_blank(q, conds))
    if not metl and re.search(r"\bbought the (?:most|least)\b|\bwho bought\b|\bbiggest buyer\b", q):
        metl = [(0, 'sales', METRICS[-1][2], 'Sales')]
    unit_words = re.search(r"\b(month|quarter|year|day)\b", q)
    dim = _find_dim(q, cols)
    per_hint = bool(re.search(r"month[\s-]*wise|monthly|quarter[\s-]*wise|quarterly|year[\s-]*wise|yearly|day[\s-]*wise|daily|\bmonths\b|\bquarters\b|\byears\b|\b(?:by|each|every|per)\s+(?:month|quarter|year|day)", q))
    row_level = bool(conds) and not (dim and dim[2]) and not per_hint
    if conds and (not row_level or not metl):
        have = {m_[1] for m_ in metl}
        for c_ in conds:
            ent = next((e for e in METRICS if e[0] == c_["key"]), None) if c_["key"] else None
            if ent and ent[0] not in have:
                metl.append((0, ent[0], ent[2], ent[3])); have.add(ent[0])
    pc = _col(cols, ["PartyName", "Party Name", "Customer Name"])
    ic = _col(cols, ["InvoiceNo", "Invoice No", "Invoice Number"])

    # ---------- counts / lists ----------
    if re.search(r"how many|number of|count (?:of )?(?:all )?(?:invoices|customers|products|categories)", q) and (not metl or re.search(r"transactions?", q)):
        dcount, en2, unk2 = (d, [], None) if skip_entity else _entities(q, d, cols)
        if unk2:
            return _na("'%s' not found in this dataset" % unk2.title())
        dsc, sn2, err2 = _scope(q, dcount, dc)
        if err2:
            return _na(err2)
        extra = "".join("\n- " + n_ for n_ in en2 + sn2)
        if dim and dim[2] and not re.search(r"\binvoices?\b|transactions?", q):
            v = dsc[dim[2]].nunique()
            plural = {"category": "categories", "party type": "party types"}.get(dim[1], dim[1] + ("s" if not dim[1].endswith("s") else ""))
            return _out("Number of %s: {:,}".format(v) % plural + extra, value=int(v))
        if re.search(r"\binvoices?\b", q) and ic:
            v = dsc[ic].nunique()
            return _out("Number of invoices: {:,}".format(v) + extra, value=int(v))
        if re.search(r"transactions?", q):
            if ic and ic in dsc.columns:
                v = int(dsc[ic].nunique())

                return _out(
                    "Number of distinct sales transactions: {:,}".format(v) + extra,
                    value=v
                )

            return _out(
                "Number of sales transactions (rows): {:,}".format(len(dsc)) + extra,
                value=int(len(dsc))
            )
        return None
    ls = re.match(r"^(?:show|list)\s+(?:all|unique|distinct)\s+(customers?|products?|categories|states|parties|payment modes?)\W*$", q)
    if ls and dim and dim[2]:
        vals = sorted(d[dim[2]].dropna().astype(str).unique())
        txt = "%d unique %s: %s" % (len(vals), dim[1], ", ".join(vals))
        return _out(txt)
    if not metl and not re.search(r"\binvoices?\b|\btransactions?\b", q):
        return None

    # ---------- resolve metric columns ----------
    mets = []
    missing = []
    for _p, key, cands, label in metl:
        if key == "margin":
            pcol_, gcol_ = _col(cols, ["Profit"]), _col(cols, ["GrossAmount", "Gross Amount", "Sales Amount"])
            if pcol_ and gcol_:
                d["__profit__"] = pd.to_numeric(d[pcol_], errors="coerce")
                d["__gross__"] = pd.to_numeric(d[gcol_], errors="coerce")
                mets.append(("margin", "__margin__", label))
            else:
                missing.append(label)
            continue
        if key == "count":
            if ic:
                d["__inv__"] = d[ic]
                mets.append(("count", "__invcount__", label))
            else:
                missing.append(label)
            continue
        c = _col(cols, cands)
        if c:
            d[c] = pd.to_numeric(d[c], errors="coerce")
            mets.append((key, c, label))
        else:
            missing.append(label)
    if metl and not mets:
        return _na("no column for %s" % ", ".join(missing))
    notes = []
    if missing:
        notes.append("Not available in this dataset (not calculated): " + ", ".join(missing))
    aggs = {}
    for k_, c_, l_ in mets:
        a_ = None
        ent = next((e for e in METRICS if e[0] == k_), None)
        if ent and k_ not in ("count", "margin"):
            mm_ = re.search(r"\b(average|avg|mean|median|total|sum|overall)\s+(?:of\s+)?(?:the\s+)?(?:%s)" % ent[1], q)
            if mm_:
                a_ = {"average": "mean", "avg": "mean", "mean": "mean", "median": "median"}.get(mm_.group(1), "sum")
        aggs[l_] = a_ or (_agg_of(q) if k_ not in ("count", "margin") else "sum")

    if re.search(r"pareto|80/20|anomal|unusual|outlier", q):
        return None
    has_margin = any(m[1] == "__margin__" for m in mets)
    has_invcount = any(m[1] == "__invcount__" for m in mets)
    if (has_margin and re.search(r"compar|growth|change|invoice|trend|correlat|rolling|cumulative", q)) or \
            (has_invcount and re.search(r"compar|growth|change|trend|correlat|rolling|cumulative|percent|share|contribution", q)):
        return None

    # ---------- entity filters ----------
    if not skip_entity:
        d, en, unknown = _entities(q, d, cols)
        notes += en
        if unknown:
            return _na("'%s' not found in this dataset" % unknown.title())

    # ---------- row-level conditions ("transactions where tax is above 500") ----------
    if conds and row_level:
        for c_ in conds:
            key_ = c_["key"] or (mets[0][0] if mets else None)
            ent = next((e for e in METRICS if e[0] == key_), None) if key_ else None
            if not ent or key_ in ("count", "margin"):
                continue
            cc_ = _col(cols, ent[2])
            if not cc_:
                return _na("no column for %s" % ent[3])
            d[cc_] = pd.to_numeric(d[cc_], errors="coerce")
            if c_["op"] == "between":
                d = d[d[cc_].between(
                    c_["val"], c_["high"], inclusive="both"
                )]
                notes.append(
                    "%s per row between %s and %s"
                    % (
                        ent[3],
                        "{:,.2f}".format(c_["val"]),
                        "{:,.2f}".format(c_["high"]),
                    )
                )
            elif c_["op"] == ">":
                d = d[d[cc_] > c_["val"]]
                notes.append(
                    "%s per row > %s"
                    % (ent[3], "{:,.2f}".format(c_["val"]))
                )
            else:
                d = d[d[cc_] < c_["val"]]
                notes.append(
                    "%s per row < %s"
                    % (ent[3], "{:,.2f}".format(c_["val"]))
                )
        if d.empty:
            return _na("no transactions match the condition (%s)" % "; ".join(n_ for n_ in notes if " per row " in n_))

    # ---------- explicit comparisons between two named periods ----------
    yrs = list(dict.fromkeys(re.findall(r"\b(20\d\d)\b", q)))
    mons = list(dict.fromkeys(re.findall(r"\b(%s)\b" % MRX, q)))
    qs = list(dict.fromkeys(re.findall(r"\bq([1-4])\b", q)))
    cue = re.search(r"\bcompar|\bchange\b|growth|difference|\bhigher\b|\blower\b|\bvs\b|versus|increase|decrease", q)
    nd = _dates(q)
    if dc and cue and mets and not nd and ((len(yrs) >= 2 and not mons and not qs) or len(mons) >= 2 or len(qs) >= 2 or (len(mons) == 1 and len(yrs) >= 2)):
        plist = []
        if len(yrs) >= 2 and not mons and not qs:
            plist = [(y, d[d[dc].dt.year == int(y)]) for y in yrs[:2]]
        elif len(mons) == 1 and len(yrs) >= 2:
            mi = MN.index(mons[0]) + 1
            plist = [("%s %s" % (mons[0].title(), y), d[(d[dc].dt.month == mi) & (d[dc].dt.year == int(y))]) for y in yrs[:2]]
        elif len(mons) >= 2:
            y = yrs[0] if yrs else None
            if not y:
                cand = sorted({yy for yy in d[dc].dt.year.dropna().astype(int)}, reverse=True)
                for yy in cand:
                    if all(((d[dc].dt.year == yy) & (d[dc].dt.month == MN.index(m_) + 1)).any() for m_ in mons[:2]):
                        y = str(yy); break
            for m_ in mons[:2]:
                sub = d[d[dc].dt.month == MN.index(m_) + 1]
                if y:
                    sub = sub[sub[dc].dt.year == int(y)]
                plist.append((m_.title() + (" " + y if y else ""), sub))
        elif len(qs) >= 2:
            y = yrs[0] if yrs else None
            if not y:
                y = str(int(d[dc].dt.year.max()))
            for qn in qs[:2]:
                plist.append(("Q%s %s" % (qn, y), d[(d[dc].dt.quarter == int(qn)) & (d[dc].dt.year == int(y))]))
        if len(plist) == 2:
            empty = [n_ for n_, s_ in plist if s_.empty]

            # If one requested period has no rows after applying filters,
            # report that period explicitly instead of cancelling comparison.
            # Keep the existing grouped-comparison path unchanged.
            if empty and not (dim and dim[2] and mets[0][1] not in ("__margin__", "__invcount__")):
                rows_, recs = [], []
                missing = set(empty)

                for k_, c_, l_ in mets:
                    a_ = None if plist[0][0] in missing else float(plist[0][1][c_].sum())
                    b_ = None if plist[1][0] in missing else float(plist[1][1][c_].sum())

                    a_text = "No matching records" if a_ is None else _fmt(k_, a_)
                    b_text = "No matching records" if b_ is None else _fmt(k_, b_)

                    rows_.append([l_, a_text, b_text, "N/A", "N/A"])
                    recs.append({
                        "metric": l_,
                        plist[0][0]: a_,
                        plist[1][0]: b_,
                        "abs_change": None,
                        "pct_change": None,
                    })

                txt = _table(
                    "Comparison: %s vs %s" % (plist[0][0], plist[1][0]),
                    ["Metric", plist[0][0], plist[1][0], "Abs change", "% change"],
                    rows_,
                )
                txt += "\n\n- No matching records for %s after applying the requested filters." % ", ".join(empty)

                if len(empty) == 1:
                    available_period = plist[1][0] if plist[0][0] in missing else plist[0][0]
                    txt += "\n- Matching data found only in: %s" % available_period

                txt += "".join("\n- " + n_ for n_ in notes)

                return _out(
                    txt,
                    table=recs,
                    chart_spec={
                        "type": "bar",
                        "x": "metric",
                        "series": [plist[0][0], plist[1][0]],
                        "interactive": True,
                        "data": recs,
                    },
                )

            if dim and dim[2] and mets[0][1] not in ("__margin__", "__invcount__"):
                k_, c_, l_ = mets[0]
                ga = plist[0][1].groupby(plist[0][1][dim[2]].astype(str))[c_].sum()
                gb = plist[1][1].groupby(plist[1][1][dim[2]].astype(str))[c_].sum()
                tt = pd.DataFrame({"a": ga, "b": gb}).fillna(0)
                tt["diff"] = tt["b"] - tt["a"]
                tt["pct"] = tt["diff"] / tt["a"].where(tt["a"] != 0) * 100
                tt = tt.sort_values("b", ascending=False)
                rows_ = [[i, _fmt(k_, r_["a"]), _fmt(k_, r_["b"]), ("+" if r_["diff"] >= 0 else "-") + _fmt(k_, abs(r_["diff"])), _fmt("pct", r_["pct"])] for i, r_ in tt.iterrows()]
                txt = _table("%s by %s: %s vs %s" % (l_, dim[1], plist[0][0], plist[1][0]), [dim[1].title(), plist[0][0], plist[1][0], "Abs change", "% change"], rows_)
                txt += "".join("\n- " + n_ for n_ in notes)
                return _out(txt, table=[{dim[2]: i, plist[0][0]: float(r_["a"]), plist[1][0]: float(r_["b"])} for i, r_ in tt.iterrows()])
            rows_, recs = [], []
            winner = None
            for k_, c_, l_ in mets:
                a_, b_ = float(plist[0][1][c_].sum()), float(plist[1][1][c_].sum())
                diff = b_ - a_
                pct = diff / a_ * 100 if a_ else float("nan")
                rows_.append([l_, _fmt(k_, a_), _fmt(k_, b_), ("+" if diff >= 0 else "-") + _fmt(k_, abs(diff)), _fmt("pct", pct)])
                recs.append({"metric": l_, plist[0][0]: a_, plist[1][0]: b_, "abs_change": diff, "pct_change": None if pd.isna(pct) else pct})
                if winner is None:
                    winner = plist[1][0] if b_ > a_ else plist[0][0]
            txt = _table("Comparison: %s vs %s" % (plist[0][0], plist[1][0]), ["Metric", plist[0][0], plist[1][0], "Abs change", "% change"], rows_)
            txt += "\n\n- Higher %s: %s" % (mets[0][2].lower(), winner)
            txt += "".join("\n- " + n_ for n_ in notes)
            return _out(txt, table=recs, chart_spec={"type": "bar", "x": "metric", "series": [plist[0][0], plist[1][0]], "interactive": True, "data": recs})

    # ---------- latest vs previous period change ----------
    change_cue = bool(re.search(
        r"(change|increase\w*|decrease\w*|difference|growth|drop|rise|up|down|compar\w*|\bvs\b|versus)",
        q,
    ))
    explicit_period_cue = bool(re.search(
        r"\b(last|previous|prior)\s+(month|year|quarter)\b"
        r"|\blatest\s+(month|year|quarter)\b.*\b(previous|prior|last)"
        r"|\b(previous|prior|last)\b.*\blatest\b",
        q,
    ))

    # If the user asks how much a metric went down but gives no date,
    # use the latest two available periods in this dataset.
    has_named_period = bool(re.search(
        r"\b(?:january|february|march|april|may|june|july|august|"
        r"september|october|november|december|jan|feb|mar|apr|jun|"
        r"jul|aug|sep|sept|oct|nov|dec)\b|\b20\d\d\b|\b\d{4}-\d{2}\b",
        q,
    ))
    implicit_latest_change = bool(
        re.search(
            r"\b(?:down|drop\w*|decreas\w*|declin\w*|fall\w*|lower)\b",
            q,
        )
        and re.search(
            r"\b(?:sales?|revenue|profit|quantity|qty|product|products|"
            r"item|items|customer|customers)\b",
            q,
        )
        and not has_named_period
    )

    chg = (
        change_cue and explicit_period_cue
    ) or implicit_latest_change

    if dc and mets and chg and not re.search(r"\b(last|latest|previous)\s+\d+\b", q) and not re.search(r"\b(?:by|each|every|per)\s+products?\b", q):
        um = re.search(r"\b(month|year|quarter)\b", q)
        unit = um.group(1) if um else "month"
        fr = {"month": "M", "year": "Y", "quarter": "Q"}[unit]
        # Keep the comparison scoped to an entity explicitly named in the
        # question. Do not accidentally compare company-wide totals.
        cmp_df = d.copy()
        matched_entity = False
        q_compact = re.sub(r"[^a-z0-9]+", "", q.casefold())

        for col in cmp_df.columns:
            if col == dc:
                continue
            series = cmp_df[col]
            if not (
                series.dtype == object
                or pd.api.types.is_string_dtype(series.dtype)
            ):
                continue

            hits = []
            for value in series.dropna().astype(str).unique():
                value_compact = re.sub(
                    r"[^a-z0-9]+", "", value.casefold()
                )
                if len(value_compact) >= 5 and value_compact in q_compact:
                    hits.append(value)

            if hits:
                chosen = max(
                    hits,
                    key=lambda value: len(re.sub(
                        r"[^a-z0-9]+", "", value.casefold()
                    )),
                )
                cmp_df = cmp_df[cmp_df[col].astype(str) == chosen]
                matched_entity = True
                break

        if cmp_df.empty:
            cmp_df = d.copy()
            matched_entity = False

        per_all = cmp_df[dc].dt.to_period(fr)
        u = sorted(per_all.dropna().unique())
        if len(u) >= 2:
            pa, pb = u[-2], u[-1]

            group_col = None
            if not matched_entity:
                if dim and len(dim) > 2 and dim[2] in cmp_df.columns:
                    group_col = dim[2]

                # Resolve common dimensions from the actual uploaded schema.
                if not group_col:
                    dimension_options = [
                        (r"\b(?:categories|category)\b|\b(?:type\s*of|typeof|kind\s*of|kindof)\s+(?:the\s+)?(?:products?|items?)\b|\b(?:product|item)\s+types?\b",
                         ("category", "categories")),
                        (r"\b(?:products?|items?)\b",
                         ("product", "products", "productname", "item", "items", "itemname")),
                        (r"\b(?:customers?|parties|party|clients?)\b",
                         ("partyname", "customer", "customers", "customername", "party", "client")),
                        (r"\b(?:states?|regions?)\b",
                         ("partystate", "state", "region")),
                    ]
                    compact_columns = {
                        re.sub(r"[^a-z0-9]+", "", str(col).casefold()): col
                        for col in cmp_df.columns
                    }
                    for cue_pattern, aliases in dimension_options:
                        if re.search(cue_pattern, q, re.IGNORECASE):
                            group_col = next(
                                (compact_columns[x] for x in aliases
                                 if x in compact_columns),
                                None,
                            )
                            if group_col:
                                break

            if group_col and group_col in cmp_df.columns and mets:
                k_, c_, l_ = mets[0]
                if c_ in cmp_df.columns:
                    mask_a = per_all == pa
                    mask_b = per_all == pb
                    ga = cmp_df.loc[mask_a].groupby(
                        cmp_df.loc[mask_a, group_col].astype(str)
                    )[c_].sum()
                    gb = cmp_df.loc[mask_b].groupby(
                        cmp_df.loc[mask_b, group_col].astype(str)
                    )[c_].sum()

                    tt = pd.DataFrame({"a": ga, "b": gb}).fillna(0)
                    tt["diff"] = tt["b"] - tt["a"]
                    tt["pct"] = (
                        tt["diff"] / tt["a"].where(tt["a"] != 0) * 100
                    )

                    asks_down = bool(re.search(
                        r"\b(?:down|drop\w*|decreas\w*|declin\w*|fall\w*|lower)\b",
                        q,
                    ))
                    if asks_down:
                        tt = tt[tt["diff"] < 0].sort_values("diff")
                    else:
                        tt = tt.sort_values("b", ascending=False)

                    rows_, recs = [], []
                    for name, row in tt.iterrows():
                        rows_.append([
                            name,
                            _fmt(k_, row["a"]),
                            _fmt(k_, row["b"]),
                            ("+" if row["diff"] >= 0 else "-")
                            + _fmt(k_, abs(row["diff"])),
                            _fmt("pct", row["pct"]),
                        ])
                        recs.append({
                            group_col: str(name),
                            str(pa): float(row["a"]),
                            str(pb): float(row["b"]),
                            "abs_change": float(row["diff"]),
                            "pct_change": (
                                None if pd.isna(row["pct"])
                                else float(row["pct"])
                            ),
                        })

                    title = (
                        f"Latest {unit} change by {group_col}: {pa} vs {pb}"
                    )
                    if not rows_ and asks_down:
                        txt = (
                            f"No {group_col} had lower {l_} in {pb} "
                            f"compared with {pa}."
                        )
                    else:
                        txt = _table(
                            title,
                            [group_col, str(pa), str(pb),
                             "Abs change", "% change"],
                            rows_,
                        )
                    txt += "".join("\n- " + n_ for n_ in notes)
                    return _out(
                        txt,
                        table=recs,
                        filtered_rows=int(len(cmp_df)),
                        period_label=f"{pa} vs {pb}",
                        scope_notes=list(notes),
                        comparison_rows={
                            str(pa): int((per_all == pa).sum()),
                            str(pb): int((per_all == pb).sum()),
                        },
                        chart_spec={
                            "type": "bar",
                            "x": group_col,
                            "series": [str(pa), str(pb)],
                            "interactive": True,
                            "data": recs,
                        },
                    )

            rows_, recs = [], []
            for k_, c_, l_ in mets:
                a_, b_ = float(cmp_df[per_all == pa][c_].sum()), float(cmp_df[per_all == pb][c_].sum())
                diff = b_ - a_
                pct = diff / a_ * 100 if a_ else float("nan")
                rows_.append([l_, _fmt(k_, a_), _fmt(k_, b_), ("+" if diff >= 0 else "-") + _fmt(k_, abs(diff)), _fmt("pct", pct)])
                recs.append({"metric": l_, str(pa): a_, str(pb): b_, "abs_change": diff, "pct_change": None if pd.isna(pct) else pct})
            txt = _table("Latest %s %s vs previous %s %s" % (unit, pb, unit, pa), ["Metric", str(pa), str(pb), "Abs change", "% change"], rows_)
            txt += "".join("\n- " + n_ for n_ in notes)
            txt += "\n- Current/last %s are taken relative to the latest %s in the data (%s)" % (unit, unit, pb)
            return _out(txt, table=recs, filtered_rows=int(len(cmp_df)), period_label="%s vs %s" % (pa, pb), scope_notes=list(notes), comparison_rows={str(pa): int((per_all == pa).sum()), str(pb): int((per_all == pb).sum())},
                        chart_spec={"type": "bar", "x": "metric", "series": [str(pa), str(pb)], "interactive": True, "data": recs})

    # ---------- growth over periods ----------
    gro = re.search(r"growth|grew|month[\s-]*over[\s-]*month|year[\s-]*over[\s-]*year|quarter[\s-]*over[\s-]*quarter|percentage change in (?:monthly|yearly|quarterly|annual)|\bmom\b|\byoy\b", q)
    if dc and mets and gro:
        if re.search(r"year|yearly|annual|yoy", q) and not re.search(r"month", q):
            fr = "Y"
        elif re.search(r"quarter", q):
            fr = "Q"
        else:
            fr = "M"
        sub_full = d
        key_, col_, lab_ = mets[0]
        ser = sub_full.groupby(_period_series(sub_full, dc, fr))[col_].sum().sort_index()
        pct = ser.pct_change() * 100
        scope_y = re.search(r"\b(20\d\d)\b", q)
        if scope_y:
            keep = [i for i in ser.index if str(i).startswith(scope_y.group(1))]
            ser, pct = ser.loc[keep], pct.loc[keep]
        rows_ = [[i, _fmt(key_, ser[i]), _fmt("pct", pct[i]) if not pd.isna(pct[i]) else "-"] for i in ser.index]
        title = "%s growth by %s" % (lab_, {"M": "month", "Y": "year", "Q": "quarter"}[fr])
        pick = pct.dropna()
        lines = []
        if len(pick):
            lines.append("Highest growth: %s (%s)" % (pick.idxmax(), _fmt("pct", pick.max())))
            lines.append("Lowest growth: %s (%s)" % (pick.idxmin(), _fmt("pct", pick.min())))
        if re.search(r"which|highest|lowest|best|worst|most|least", q) and len(pick):
            want_low = re.search(r"\b(%s)\b" % DOWN, q) and not re.search(r"\b(%s)\b" % UP, q)
            i = pick.idxmin() if want_low else pick.idxmax()
            txt = "%s %s growth: %s (%s; value %s)" % ("Lowest" if want_low else "Highest", lab_, i, _fmt("pct", pick[i]), _fmt(key_, ser[i]))
            txt += "\n\n" + _table(title, [fr == "Y" and "Year" or "Period", lab_, "Growth %"], rows_)
        else:
            txt = _table(title, ["Period", lab_, "Growth %"], rows_) + "\n\n" + "\n".join("- " + l for l in lines)
        txt += "".join("\n- " + n_ for n_ in notes)
        recs = [{"period": i, lab_: float(ser[i]), "growth_pct": None if pd.isna(pct[i]) else float(pct[i])} for i in ser.index]
        return _out(txt, table=recs, chart_spec={"type": "line", "x": "period", "series": [lab_, "growth_pct"], "interactive": True, "data": recs})

    # ---------- invoice / transaction detail rows ----------
    inv = re.search(r"\binvoices?\b|\btransactions?\b", q) and not any(m[0] == "count" for m in mets) and not re.search(r"how many|count|unique|distinct|duplicate|missing|\b(average|avg|mean|median|total|sum|maximum|minimum)\b", q)
    if inv and not (dim and dim[1] != "customer") and not re.search(r"\b(monthly|yearly|month[\s-]*wise|year[\s-]*wise|quarterly|daily)\b", q):
        sc, sn, err = _scope(q, d, dc)
        if err:
            return _na(err)
        d2 = sc
        notes += sn
        mcol = mets[0][1] if mets else _col(cols, ["InvoiceTotal", "Invoice Total"])
        mlab = mets[0][2] if mets else "Invoice Value"
        if th and mcol and not (row_level and conds[0]["key"]):
            d2 = d2[d2[mcol] > th[1]] if th[0] == ">" else d2[d2[mcol] < th[1]]
            notes.append("%s %s %s" % (mlab, th[0], "{:,.2f}".format(th[1])))
        tn = re.search(r"\b(top|bottom|first|last|latest|recent|oldest)\s+(\d+)\b", q)
        which = re.search(r"\b(%s|%s)\b" % (UP, DOWN), q)
        n = int(tn.group(2)) if tn else (1 if re.search(r"\bwhich invoice|\bwhat is the (?:highest|lowest)", q) else 20)
        if tn and tn.group(1) in ("top", "bottom") or (which and not tn and mcol):
            asc = bool(tn and tn.group(1) == "bottom") or bool(re.search(r"\b(%s)\b" % DOWN, q) and not tn)
            d2 = d2.sort_values(mcol, ascending=asc)
        elif tn and tn.group(1) in ("first", "oldest"):
            d2 = d2.sort_values(dc, ascending=True)
        elif th and mcol:
            d2 = d2.sort_values(mcol, ascending=False)
        else:
            d2 = d2.sort_values(dc, ascending=False) if dc else d2
        total_rows = len(d2)
        show = [c for c in [ic, dc, pc, _col(cols, ["Product"])] if c]
        for _k, c_, _l in mets:
            if c_ not in show:
                show.append(c_)
        for c_ in ([_col(cols, ["Qty"]), _col(cols, ["GrossAmount"]), _col(cols, ["InvoiceTotal"])] if not mets else []):
            if c_ and c_ not in show:
                show.append(c_)
        t = d2.head(n)[show].copy()
        if dc in t:
            t[dc] = pd.to_datetime(t[dc]).dt.strftime("%Y-%m-%d")
        for c_ in t.columns:
            if pd.api.types.is_float_dtype(t[c_]):
                t[c_] = t[c_].map(lambda v: "{:,.2f}".format(v) if pd.notna(v) else "-")
        txt = _table("%d matching invoices (showing %d)" % (total_rows, len(t)), list(t.columns), t.astype(str).values.tolist())
        txt += "".join("\n- " + n_ for n_ in notes)
        return _out(txt, filtered_rows=int(total_rows), table=t.to_dict("records"))

    if not mets:
        return None

    # ---------- scope (dates etc.) ----------
    rate_applied = False
    rm = re.search(r"(\d+(?:\.\d+)?)\s*(?:%|percent|per cent)\s*(?:of\s+)?(?:gst|tax)|(?:gst|tax)\s*(?:rate\s*)?(?:of|at|is|=|@)?\s*(\d+(?:\.\d+)?)\s*(?:%|percent|per cent)", q)
    if rm:
        rcol = _col(cols, ["GST_Rate", "GSTRate", "GST Rate", "Tax Rate", "TaxRate"])
        rv = float(rm.group(1) or rm.group(2))
        if not rcol:
            return _na("no GST rate column in this dataset")
        dd = d[pd.to_numeric(d[rcol], errors="coerce") == rv]
        if dd.empty:
            avail = ", ".join("%g%%" % x for x in sorted(pd.to_numeric(d[rcol], errors="coerce").dropna().unique()))
            return _na("no rows with GST rate %g%% (available rates: %s)" % (rv, avail))
        d = dd
        rate_applied = True
        notes.append("GST rate: %g%%" % rv)
    d, sn, err = _scope(q, d, dc)
    if err:
        return _na(err + " (data covers %s to %s)" % (pd.to_datetime(df[dc], errors="coerce").min().date() if dc else "?", pd.to_datetime(df[dc], errors="coerce").max().date() if dc else "?"))
    notes += sn

    # GST_RATE_PRODUCT_LIST_V1:
    # List distinct products for GST-rate queries instead of aggregating GST.
    wants_product_list = (
        rate_applied
        and bool(re.search(
            r"\b(products?|items?)\b", q
        ))
        and bool(re.search(
            r"\b(show|list|give|find|which|what|display|get)\b", q
        ))
        and not bool(re.search(
            r"\b(total|sum|average|avg|mean|median|count|how many|"
            r"sales|revenue|profit|quantity|qty|units|"
            r"gst amount|total gst|gst total|tax amount)\b", q
        ))
    )

    if wants_product_list:
        product_col = _col(cols, ["Product", "Item Name", "ItemName"])

        if not product_col:
            return _na("no product column in this dataset")

        products = sorted(
            d[product_col]
            .dropna()
            .astype(str)
            .str.strip()
        )
        products = sorted(set(x for x in products if x))

        if not products:
            return _na("no products found for the requested GST rate")

        records = [{product_col: name} for name in products]
        table_rows = [[name] for name in products]
        title = "%d products matching the requested GST rate" % len(products)

        txt = _table(title, ["Product"], table_rows)
        txt += "".join("\n- " + note for note in notes)

        return _out(
            txt,
            table=records,
            filtered_rows=int(len(d)),
            unique_products=int(len(products)),
            scope_notes=list(notes),
        )

    latest_n = re.search(r"\b(latest|last|previous|recent)\s+(\d+)\s+(month|quarter|year)s?\b", q)
    per = next((f for f, rx in [("D", r"day[\s-]*wise|daily|by day|each day|every day|per day"),
                                ("M", r"month[\s-]*wise|monthly|by month|each month|every month|per month|\bmonths\b"),
                                ("Q", r"quarter[\s-]*wise|quarterly|by quarter|each quarter|\bquarters\b"),
                                ("Y", r"year[\s-]*wise|yearly|annual|annually|by year|each year|\byears\b")] if re.search(rx, q)), None)
    rank_up = bool(re.search(r"\b(%s)\b" % UP, q))
    rank_dn = bool(re.search(r"\b(%s)\b" % DOWN, q))
    sell_rank = re.search(r"\b(best|top)[\s-]*selling\b|\b(worst|least)[\s-]*selling\b|bought the most|bought the least", q)
    if sell_rank:
        rank_up = bool(re.search(r"best|top|most", sell_rank.group(0)))
        rank_dn = not rank_up
    if sell_rank and re.search(r"bought", q) and not dim:
        dim = (0, "customer", pc, 8)
    dim_rank = bool(dim and dim[2] and (re.search(r"\b(top|bottom|best|worst|highest|lowest|most|least)\b|wise|\bby\b|\beach\b|\bper\b|\bacross\b|ranking|\brank\b", q)
                                         or re.search(r"\b(customer|product|category|state|party|payment mode)s?\s+(?:sales|revenue|profit|gst|discount|quantity)", q)))
    explicit_per = re.search(r"month[\s-]*wise|monthly|quarter[\s-]*wise|quarterly|year[\s-]*wise|yearly|annual|day[\s-]*wise|daily|\b(?:by|each|every|per)\s+(?:month|quarter|year|day)", q)
    if dim_rank and per and not explicit_per:
        per = None   # "top 3 customers ... in the last/first 3 months": months only scope the rows
    if per is None and unit_words and (rank_up or rank_dn) and not dim and not latest_n:
        if re.search(r"\b(month|quarter|year|day)\b", q):
            per = {"month": "M", "quarter": "Q", "year": "Y", "day": "D"}[unit_words.group(1)]
    if latest_n:
        fr = {"month": "M", "quarter": "Q", "year": "Y"}[latest_n.group(3)]
        n = int(latest_n.group(2))
        p = d[dc].dt.to_period(fr)
        u = sorted(p.dropna().unique())
        sel = u[-n:] if latest_n.group(1) != "previous" else u[-2 * n:-n]
        d = d[p.isin(sel)]
        if not dim_rank:
            per = per or fr
        notes.append("Periods: " + ", ".join(map(str, sel)))
    topn = re.search(r"\b(top|bottom|best|worst)\s+(\d+)\b", q)
    conds_group = conds if (conds and not row_level) else []
    avg_cond = re.search(r"\b(above|below)\s+(?:the\s+)?average\b", q)
    avg_pairs = [(m_.group(1), m_.group(2)) for m_ in re.finditer(r"\b(sales?|revenue|profit|gst|discount|quantity|qty|margin)\b(?:(?!\b(?:sales?|revenue|profit|gst|discount|quantity|qty|margin)\b)[^,.])*?\b(above|below)\s+(?:the\s+)?average", q)]
    corr = re.search(r"correlat|relationship between|\brelation\b", q)
    summ = re.search(r"\b(sales|profit|business|performance|overall)\s+summary\b|\bsummary of (sales|profit|business)\b", q)
    roll = re.search(r"rolling\s+(\d+)[\s-]*(month|quarter|year)|cumulative|running total", q)
    share = re.search(r"percent(?:age)?(?:\s+of)?|contribut\w*|\bshare\b|comes from|proportion|\bdistribution\b", q)



    # PRODUCT_UNITS_AND_AVERAGE_SELLING_PRICE_V1
    # Calculate both requested metrics after entity and date filters.
    wants_units_and_avg_price = (
        bool(re.search(r"\b(?:units?|quantity|qty)\b", q))
        and bool(re.search(
            r"\b(?:average|avg)\s+selling\s+price\b"
            r"|\bprice\s+per\s+unit\b",
            q,
        ))
    )

    if wants_units_and_avg_price:
        qty_col = _col(cols, ["Qty", "Quantity", "Units"])
        gross_col = _col(
            cols,
            ["GrossAmount", "Gross Amount", "Sales Amount"],
        )

        if not qty_col or not gross_col:
            return _na(
                "quantity or gross amount column is unavailable "
                "in the uploaded dataset"
            )

        if d.empty:
            return _na("no rows match the requested product and period")

        qty_values = pd.to_numeric(d[qty_col], errors="coerce").fillna(0)
        gross_values = pd.to_numeric(
            d[gross_col], errors="coerce"
        ).fillna(0)

        total_units = float(qty_values.sum())
        total_gross = float(gross_values.sum())

        if total_units == 0:
            return _na(
                "average selling price cannot be calculated because "
                "total quantity is zero"
            )

        average_price = total_gross / total_units

        record = {
            "Total Units Sold": total_units,
            "Total Gross Revenue": total_gross,
            "Average Selling Price Per Unit": average_price,
        }

        rows = [
            ["Total units sold", _fmt("qty", total_units)],
            ["Total gross revenue", _fmt("sales", total_gross)],
            ["Average selling price per unit", _fmt("sales", average_price)],
        ]

        txt = _table(
            "Quantity and average selling price",
            ["Metric", "Value"],
            rows,
        )
        txt += "".join("\n- " + note for note in notes)

        return _out(
            txt,
            table=[record],
            table_rows=1,
            filtered_rows=int(len(d)),
            aggregate_function="multi",
            scope_notes=list(notes),
        )

    # ---------- summary ----------
    if summ:
        def cs(*c):
            return _col(cols, list(c))
        sc_, pc_, qc_, gc_, dcnt = cs("GrossAmount"), cs("Profit"), cs("Qty"), cs("TotalGST"), cs("DiscountAmt")
        rws = []
        if sc_: rws.append(["Total sales", _fmt("s", pd.to_numeric(d[sc_], errors="coerce").sum())])
        if pc_: rws.append(["Total profit", _fmt("s", pd.to_numeric(d[pc_], errors="coerce").sum())])
        if sc_ and pc_ and pd.to_numeric(d[sc_], errors="coerce").sum():
            rws.append(["Profit margin", _fmt("margin", pd.to_numeric(d[pc_], errors="coerce").sum() / pd.to_numeric(d[sc_], errors="coerce").sum() * 100)])
        if qc_: rws.append(["Total quantity", _fmt("qty", pd.to_numeric(d[qc_], errors="coerce").sum())])
        if gc_: rws.append(["Total GST", _fmt("s", pd.to_numeric(d[gc_], errors="coerce").sum())])
        if dcnt: rws.append(["Total discount", _fmt("s", pd.to_numeric(d[dcnt], errors="coerce").sum())])
        if ic: rws.append(["Invoices", "{:,}".format(d[ic].nunique())])
        if pc: rws.append(["Customers", "{:,}".format(d[pc].nunique())])
        if sc_:
            for nm_, cands_ in (("Top customer", ["PartyName"]), ("Top product", ["Product"]), ("Top category", ["Category"]), ("Top state", ["PartyState"])):
                c0 = _col(cols, cands_)
                if c0:
                    g0 = pd.to_numeric(d[sc_], errors="coerce").groupby(d[c0].astype(str)).sum()
                    rws.append([nm_, "%s (%s)" % (g0.idxmax(), _fmt("s", g0.max()))])
            if dc:
                gm = pd.to_numeric(d[sc_], errors="coerce").groupby(d[dc].dt.to_period("M").astype(str)).sum()
                rws.append(["Best month", "%s (%s)" % (gm.idxmax(), _fmt("s", gm.max()))])
                rws.append(["Weakest month", "%s (%s)" % (gm.idxmin(), _fmt("s", gm.min()))])
                rws.append(["Data covers", "%s to %s" % (d[dc].min().date(), d[dc].max().date())])
        txt = _table("Summary (%d rows)" % len(d), ["Metric", "Value"], rws) + "".join("\n- " + n_ for n_ in notes)
        return _out(txt, filtered_rows=int(len(d)))

    # ---------- correlation ----------
    if corr and len(mets) >= 2 and all(m[1] not in ("__margin__", "__invcount__") for m in mets[:2]):
        a_, b_ = mets[0], mets[1]
        r_ = d[a_[1]].corr(d[b_[1]])
        strength = "very strong" if abs(r_) >= 0.9 else "strong" if abs(r_) >= 0.7 else "moderate" if abs(r_) >= 0.4 else "weak" if abs(r_) >= 0.2 else "negligible"
        txt = "Correlation between %s and %s (row level, %d rows): %.4f (%s %s relationship)" % (a_[2], b_[2], len(d), r_, strength, "positive" if r_ >= 0 else "negative")
        return _out(txt, value=float(r_))

    # ---------- rolling / cumulative ----------
    if roll and dc and mets and mets[0][1] not in ("__margin__", "__invcount__"):
        mfr = {"month": "M", "quarter": "Q", "year": "Y"}.get(roll.group(2) if roll.group(1) else "month", "M")
        ser = d.groupby(_period_series(d, dc, mfr))[mets[0][1]].sum().sort_index()
        k_, l_ = mets[0][0], mets[0][2]
        if roll.group(1):
            n_ = int(roll.group(1))
            rv = ser.rolling(n_).sum()
            rows_ = [[i, _fmt(k_, ser[i]), _fmt(k_, rv[i]) if not pd.isna(rv[i]) else "-"] for i in ser.index]
            txt = _table("Rolling %d-%s %s" % (n_, roll.group(2), l_.lower()), ["Period", l_, "Rolling %d" % n_], rows_)
        else:
            cv = ser.cumsum()
            rows_ = [[i, _fmt(k_, ser[i]), _fmt(k_, cv[i])] for i in ser.index]
            txt = _table("Cumulative %s" % l_.lower(), ["Period", l_, "Cumulative"], rows_)
        return _out(txt + "".join("\n- " + n_ for n_ in notes))

    # ---------- above / below average (per dimension) ----------
    if avg_pairs and dim and dim[2]:
        specs = []
        for w_, dirn in avg_pairs:
            m0 = _metric(w_)
            if m0:
                c0 = _col(cols, m0[0][2])
                if c0:
                    d[c0] = pd.to_numeric(d[c0], errors="coerce")
                    specs.append((m0[0][1], c0, m0[0][3], dirn))
        if specs:
            keys = [(k_, c_, l_) for k_, c_, l_, _d in specs]
            tab = _group(d, d[dim[2]].astype(str), keys)
            conds = []
            avgs = {l_: tab[l_].mean() for _k, _c, l_, _d in specs}  # averages over ALL groups, before any filtering
            for k_, c_, l_, dirn in specs:
                av = avgs[l_]
                tab = tab[tab[l_] > av] if dirn == "above" else tab[tab[l_] < av]
                conds.append("%s %s average (%s)" % (l_, dirn, _fmt(k_, av)))
            tab = tab.sort_values(specs[0][2], ascending=False)
            rows_ = [[i + 1, n_] + [_fmt(k_, tab.loc[n_, l_]) for k_, _c, l_ in keys] for i, n_ in enumerate(tab.index)]
            txt = _table("%d %s with %s" % (len(tab), dim[1], " and ".join(conds)), ["#", dim[1].title()] + [l_ for _k, _c, l_ in keys], rows_)
            return _out(txt + "".join("\n- " + n_ for n_ in notes), table=[{dim[2]: n_} for n_ in tab.index])
    if avg_pairs:
        return None

    # ---------- share / contribution ----------
    if share and mets[0][1] not in ("__margin__", "__invcount__") and ((dim and dim[2]) or per):
        if per and dc and not (dim and dim[2]):
            keyser, nm_ = _period_series(d, dc, per), "Period"
        else:
            keyser, nm_ = d[dim[2]].astype(str), dim[1].title()
        ser = d.groupby(keyser)[mets[0][1]].sum()
        tot = float(ser.sum())
        ser = ser.sort_values(ascending=False) if nm_ != "Period" else ser.sort_index()

        # Ranking words in a share query mean "show the leading entity", not
        # the full distribution. Keep the denominator BEFORE limiting so the
        # displayed share remains a percentage of the complete filtered scope.
        rank_words_up = bool(re.search(
            r"\b(highest|most|best|top|maximum|largest|biggest|greatest)\b", q
        ))
        rank_words_down = bool(re.search(
            r"\b(lowest|least|worst|bottom|minimum|smallest|fewest)\b", q
        ))
        rank_match = re.search(
            r"\b(top|bottom|best|worst)\s+(\d+)\b|"
            r"\b(top|bottom|best|worst)\s+(one|two|three|four|five|six|seven|eight|nine|ten)\b",
            q,
        )
        ranking_requested = (rank_words_up or rank_words_down or rank_match is not None)
        requested_n = 1
        if rank_match:
            word_numbers = {
                "one": 1, "two": 2, "three": 3, "four": 4,
                "five": 5, "six": 6, "seven": 7, "eight": 8,
                "nine": 9, "ten": 10,
            }
            requested_n = int(rank_match.group(2)) if rank_match.group(2) else word_numbers[rank_match.group(4)]
            rank_words_down = rank_match.group(1) == "bottom" or rank_match.group(3) == "bottom" or rank_match.group(1) == "worst" or rank_match.group(3) == "worst"
            rank_words_up = not rank_words_down
        if ranking_requested and nm_ != "Period":
            ser = ser.sort_values(ascending=rank_words_down).head(requested_n)

        rows_ = [[i, _fmt(mets[0][0], v), _fmt("share", v / tot * 100 if tot else float("nan"))] for i, v in ser.items()]
        heading = "%s share by %s" % (mets[0][2], nm_.lower())
        if ranking_requested and nm_ != "Period":
            heading = "%s %s %s by %s" % (
                "Top" if not rank_words_down else "Bottom", requested_n,
                nm_.lower(), mets[0][2].lower(),
            )
        txt = _table(heading, [nm_, mets[0][2], "Share %"], rows_)
        txt += "\n\n- Total %s: %s" % (mets[0][2].lower(), _fmt(mets[0][0], tot))
        xkey = "period" if nm_ == "Period" else dim[2]
        recs = [{xkey: i, mets[0][2]: float(v), "share_pct": (float(v / tot * 100) if tot else None)} for i, v in ser.items()]
        return _out(txt + "".join("\n- " + n_ for n_ in notes), table=recs, filtered_rows=int(len(d)),
                    period_label=_span(d, dc), scope_notes=list(notes), total_value=float(tot),
                    ranking_requested=ranking_requested, ranking_limit=(requested_n if ranking_requested else None),
                    chart_spec={"type": "line" if nm_ == "Period" else ("bar" if ranking_requested else "pie"), "x": xkey, "series": [mets[0][2]], "interactive": True, "data": recs})

    # highest and lowest side by side
    if re.search(r"\bcompar\w*\b.*\b(highest|best)\b.*\b(and|vs|versus)\b.*\b(lowest|worst)\b", q) and (dim or per or unit_words):
        if dim and dim[2]:
            s = d.groupby(d[dim[2]].astype(str))[mets[0][1]].sum()
            lab = dim[1].title()
        else:
            fr = per or {"month": "M", "quarter": "Q", "year": "Y", "day": "D"}.get(unit_words.group(1) if unit_words else "month", "M")
            s = d.groupby(_period_series(d, dc, fr))[mets[0][1]].sum(); lab = "Period"
        hi, lo = s.idxmax(), s.idxmin()
        txt = _table("Highest vs lowest %s by %s" % (lab.lower(), mets[0][2]), ["", lab, mets[0][2]],
                     [["Highest", hi, _fmt(mets[0][0], s[hi])], ["Lowest", lo, _fmt(mets[0][0], s[lo])]])
        txt += "\n\n- Difference: " + _fmt(mets[0][0], s[hi] - s[lo])
        return _out(txt)


    # MULTI_PRODUCT_MONTHLY_COMPARE_V1
    # Compare named products independently across months.
    if (
        dc
        and re.search(r"monthly|month[\s-]*wise|by month|each month|every month", q)
        and re.search(r"compar|\bvs\b|versus|\beach product\b", q)
        and mets
        and mets[0][1] not in ("__margin__", "__invcount__")
    ):
        product_col = _col(cols, ["Product", "Item Name"])
        if product_col:
            available = (
                df[product_col]
                .dropna()
                .astype(str)
                .str.strip()
                .unique()
            )

            requested = [
                str(name)
                for name in available
                if re.search(
                    r"(?<!\w)" + re.escape(str(name).lower()) + r"(?!\w)",
                    q,
                )
            ]

            if len(requested) >= 2:
                selected = d[
                    d[product_col].astype(str).str.strip().isin(requested)
                ].copy()

                if selected.empty:
                    return _na("No rows found for the requested products")

                metric_key, metric_col, metric_label = mets[0]

                selected["__compare_period__"] = (
                    selected[dc].dt.to_period("M").astype(str)
                )

                grouped_products = (
                    selected.groupby(
                        ["__compare_period__", product_col]
                    )[metric_col]
                    .sum()
                    .unstack(product_col)
                    .sort_index()
                )

                grouped_products = grouped_products.reindex(
                    columns=requested
                )

                chart_rows = []
                answer_rows = []

                for period_value, values in grouped_products.iterrows():
                    record = {"period": str(period_value)}
                    display = [str(period_value)]

                    for product_name in requested:
                        value = values[product_name]
                        number = (
                            float(value)
                            if pd.notna(value)
                            else None
                        )
                        record[product_name] = number
                        display.append(
                            _fmt(metric_key, number)
                            if number is not None
                            else "-"
                        )

                    chart_rows.append(record)
                    answer_rows.append(display)

                title = "%s by month and product" % metric_label

                answer = _table(
                    title,
                    ["Period"] + requested,
                    answer_rows,
                )

                for product_name in requested:
                    values = grouped_products[product_name].dropna()
                    if values.empty:
                        continue

                    highest_month = str(values.idxmax())
                    highest_value = float(values.max())

                    answer += (
                        "\n- Highest %s for %s: %s (%s)"
                        % (
                            metric_label.lower(),
                            product_name,
                            highest_month,
                            _fmt(metric_key, highest_value),
                        )
                    )

                answer += "".join("\n- " + note for note in notes)

                return _out(
                    answer,
                    table=chart_rows,
                    filtered_rows=int(len(selected)),
                    period_label=_span(selected, dc),
                    scope_notes=list(notes),
                    chart_spec={
                        "type": "line",
                        "x": "period",
                        "series": requested,
                        "interactive": True,
                        "data": chart_rows,
                    },
                )


    # CUSTOMER_GROSS_MARGIN_WITH_MIN_SALES_V1
    # Rank customers by weighted gross profit margin after a minimum
    # total-sales eligibility threshold.
    margin_rank_request = (
        re.search(
            r"\b(highest|greatest|maximum|top|best)\b",
            q,
        )
        and re.search(r"\bprofit[\s-]*margin\b|\bmargins?\b", q)
        and re.search(r"\bcustomer|customers|party\b", q)
        and re.search(r"\b(at least|minimum of|no less than)\b", q)
    )

    if margin_rank_request:
        threshold_match = re.search(
            r"\b(?:at least|minimum of|no less than)\s+"
            r"(?:rs\.?\s*|inr\s*|\u20b9\s*)?"
            r"([\d,]+(?:\.\d+)?)\s*"
            r"(k|lakhs?|lacs?|crores?|cr|million|m)?"
            r"\s+(?:in\s+)?(?:total\s+)?(?:sales|revenue)\b",
            q,
        )

        if threshold_match:
            threshold = (
                float(threshold_match.group(1).replace(",", ""))
                * _MULT.get((threshold_match.group(2) or "").lower(), 1)
            )

            customer_col = (
                dim[2]
                if dim and dim[2]
                else _col(cols, ["PartyName", "Party Name", "Customer Name"])
            )
            sales_col = _col(
                cols,
                ["GrossAmount", "Gross Amount", "Sales Amount", "SalesAmount"],
            )
            profit_col = _col(cols, ["Profit"])

            if not customer_col or not sales_col or not profit_col:
                return _na(
                    "Customer, Gross Sales or Profit column is missing "
                    "from the uploaded dataset."
                )

            margin_data = d[
                [customer_col, sales_col, profit_col]
            ].copy()

            margin_data[sales_col] = pd.to_numeric(
                margin_data[sales_col], errors="coerce"
            )
            margin_data[profit_col] = pd.to_numeric(
                margin_data[profit_col], errors="coerce"
            )

            margin_data = margin_data.dropna(
                subset=[customer_col, sales_col, profit_col]
            )

            customer_totals = (
                margin_data.groupby(customer_col, dropna=True)
                .agg(
                    Sales=(sales_col, "sum"),
                    Profit=(profit_col, "sum"),
                )
            )

            eligible = customer_totals[
                customer_totals["Sales"] >= threshold
            ].copy()

            if eligible.empty:
                return _out(
                    "No customers generated at least %s in total sales."
                    % _fmt("s", threshold),
                    table=[],
                    filtered_rows=0,
                    scope_notes=[
                        "Minimum customer sales: %s" % _fmt("s", threshold)
                    ],
                )

            eligible["Profit Margin %"] = (
                eligible["Profit"] / eligible["Sales"] * 100
            )

            eligible = eligible.replace(
                [float("inf"), float("-inf")], float("nan")
            ).dropna(subset=["Profit Margin %"])

            eligible = eligible.sort_values(
                "Profit Margin %", ascending=False
            )

            if eligible.empty:
                return _na(
                    "Profit margin could not be calculated for eligible customers."
                )

            winner_name = str(eligible.index[0])
            winner = eligible.iloc[0]

            display_rows = [
                [
                    rank,
                    str(name),
                    _fmt("s", row["Sales"]),
                    _fmt("s", row["Profit"]),
                    _fmt("margin", row["Profit Margin %"]),
                ]
                for rank, (name, row) in enumerate(
                    eligible.iterrows(), start=1
                )
            ]

            txt = (
                "Customer with the highest Gross Profit Margin: "
                "%s (%s)\n\n"
                % (
                    winner_name,
                    _fmt("margin", winner["Profit Margin %"]),
                )
            )
            txt += _table(
                "Customers with total sales of at least %s"
                % _fmt("s", threshold),
                ["Rank", "Customer", "Gross Sales", "Profit", "Profit Margin %"],
                display_rows,
            )
            txt += (
                "\n- Eligibility: total customer sales >= %s"
                % _fmt("s", threshold)
            )
            txt += (
                "\n- Margin formula: SUM(Profit) / SUM(GrossAmount) * 100"
            )

            span = _span(d, dc)
            if span:
                txt += "\n- Period covered: " + span

            records = [
                {
                    customer_col: str(name),
                    "Sales": float(row["Sales"]),
                    "Profit": float(row["Profit"]),
                    "Profit Margin %": float(row["Profit Margin %"]),
                }
                for name, row in eligible.iterrows()
            ]

            return _out(
                txt,
                table=records,
                filtered_rows=int(len(eligible)),
                period_label=span,
                scope_notes=[
                    "Minimum customer sales: %s" % _fmt("s", threshold),
                    "Ranking metric: Gross Profit Margin %",
                ],
                chart_spec={
                    "type": "bar",
                    "x": customer_col,
                    "series": ["Profit Margin %"],
                    "interactive": True,
                    "data": records[:20],
                },
            )

    # ---------- grouped tables (dimension or period) ----------
    gmets = [(("qty2" if (k_ == "qty" and aggs[l_] != "sum") else k_), c_, _dl(l_, aggs[l_])) for k_, c_, l_ in mets]
    gaggs = {_dl(l_, aggs[l_]): aggs[l_] for _k, _c, l_ in mets}
    lab_of = {k_: _dl(l_, aggs[l_]) for k_, _c, l_ in mets}

    def _cond_filter(tab):
        txts = []
        for c_ in conds_group:
            lab_ = lab_of.get(c_["key"]) if c_["key"] else gmets[0][2]
            if lab_ is None or lab_ not in tab.columns:
                continue
            if c_["op"] == "between":
                tab = tab[tab[lab_].between(
                    c_["val"], c_["high"], inclusive="both"
                )]
                txts.append(
                    "%s between %s and %s"
                    % (
                        lab_,
                        "{:,.2f}".format(c_["val"]),
                        "{:,.2f}".format(c_["high"]),
                    )
                )
                notes.append(
                    "%s between %s and %s"
                    % (
                        lab_,
                        "{:,.2f}".format(c_["val"]),
                        "{:,.2f}".format(c_["high"]),
                    )
                )
            elif c_["op"] == ">":
                tab = tab[tab[lab_] > c_["val"]]
                txts.append(
                    "%s above %s" % (
                        lab_, "{:,.2f}".format(c_["val"])
                    )
                )
                notes.append(
                    "%s > %s" % (
                        lab_, "{:,.2f}".format(c_["val"])
                    )
                )
            else:
                tab = tab[tab[lab_] < c_["val"]]
                txts.append(
                    "%s below %s" % (
                        lab_, "{:,.2f}".format(c_["val"])
                    )
                )
                notes.append(
                    "%s < %s" % (
                        lab_, "{:,.2f}".format(c_["val"])
                    )
                )
        return tab, txts

    wise = re.search(r"wise|\bby\b|\beach\b|\bevery\b|\bper\b|\bacross\b|ranking|\brank\b|\bcompar", q) or \
        (rate_applied and dim and dim[2] and re.search(r"\b(which|who|list|show)\b", q)) or \
        (dim and not any(n_.split(":")[0] in ("PartyName", "Category", "Product", "PartyState", "PaymentMode", "PartyType", "Customers matched") for n_ in notes)
         and re.search(r"\b(customer|product|category|state|party|payment mode|party type)s?\s+(?:sales|revenue|profit|gst|discount|quantity|qty)\b", q))
    # Combined period + dimension grouping, e.g. "partyname monthwise sales"
    if per and dc and dim and dim[2] and re.search(
        r"party[\s_-]*name|\bcustomer\b|\bcustomers\b|\bparties\b|\bclients?\b",
        q,
    ):
        period_keys = _period_series(d, dc, per)
        dimension_keys = d[dim[2]].fillna("Unknown").astype(str)
        grouped = _group(d, [period_keys, dimension_keys], gmets, gaggs)
        label = {"D": "day", "M": "month", "Q": "quarter", "Y": "year"}[per]

        if grouped.empty:
            return _out("No data available for the requested period and dimension.", table=[])

        rows_combined = []
        records_combined = []
        for idx, values in grouped.iterrows():
            period_value, dimension_value = idx
            rows_combined.append(
                [period_value, dimension_value]
                + [_fmt(k_, values[l_]) for k_, _c, l_ in gmets]
            )
            record = {"period": str(period_value), dim[2]: str(dimension_value)}
            record.update({l_: float(values[l_]) for _k, _c, l_ in gmets})
            records_combined.append(record)

        title = "%s by %s and %s" % (
            " & ".join(m[2] for m in gmets), label, dim[1]
        )
        headers = ["Period", dim[1].title()] + [m[2] for m in gmets]
        txt = _table(title, headers, rows_combined)
        txt += "".join("\n- " + n_ for n_ in notes)
        return _out(
            txt,
            table=records_combined,
            filtered_rows=int(len(d)),
            period_label=_span(d, dc),
            scope_notes=list(notes),
        )

    if per and dc:
        keys = _period_series(d, dc, per)
        tab = _group(d, keys, gmets, gaggs)
        label = {"D": "day", "M": "month", "Q": "quarter", "Y": "year"}[per]
        if conds_group:
            tab, ctxt = _cond_filter(tab)
            tab = tab.sort_index()
            title = "%d %ss with %s" % (len(tab), label, " and ".join(ctxt))
        elif topn or rank_up or rank_dn:
            asc = bool(topn and topn.group(1) in ("bottom", "worst")) or (rank_dn and not rank_up and not topn)
            asc = asc or bool(re.search(r"\b(worst|lowest|least|minimum|lower)\b", q) and not topn)
            n = int(topn.group(2)) if topn else 1
            tab = tab.sort_values(gmets[0][2], ascending=asc).head(n)
            title = "%s %d %s by %s" % ("Bottom" if asc else "Top", len(tab), label if len(tab) == 1 else label + "s", gmets[0][2])
        else:
            tab = tab.sort_index()
            title = "%s by %s" % (" & ".join(m[2] for m in gmets), label)
        if tab.empty:
            return _out("No %s matches the condition.%s" % (label, "".join("\n- " + n_ for n_ in notes)), table=[], filtered_rows=int(len(d)))
        rows_ = [[i] + [_fmt(k_, tab.loc[i, l_]) for k_, _c, l_ in gmets] for i in tab.index]
        txt = _table(title, ["Period"] + [m[2] for m in gmets], rows_) + "".join("\n- " + n_ for n_ in notes)
        recs = [dict({"period": i}, **{l_: float(tab.loc[i, l_]) for _k, _c, l_ in gmets}) for i in tab.index]
        res = _out(txt, table=recs, filtered_rows=int(len(d)), period_label=_span(d, dc), scope_notes=list(notes))
        if re.search(r"chart|plot|visuali|graph|trend", q) or len(tab) > 3 or len(gmets) >= 2:
            res["result"]["chart_spec"] = {"type": "line", "x": "period", "series": [m[2] for m in gmets], "interactive": True, "data": recs}
            if len(gmets) >= 2:
                res["result"]["chart_spec"]["dual_axis"] = True
        return res

    if dim and dim[2] and (wise or topn or rank_up or rank_dn or conds_group):
        tab = _group(d, d[dim[2]].astype(str), gmets, gaggs)
        first = gmets[0][2]
        dn = dim[1]
        if conds_group:
            tab, ctxt = _cond_filter(tab)
            title = "%d %s with %s" % (len(tab), dn if len(tab) == 1 else _plural(dn), " and ".join(ctxt))
            tab = tab.sort_values(first, ascending=conds_group[0]["op"] == "<")
        elif topn or rank_up or rank_dn:
            asc = bool(topn and topn.group(1) in ("bottom", "worst")) or (rank_dn and not rank_up and not topn)
            if topn:
                n = int(topn.group(2))
            elif re.search(r"\b(which|who|what)\b", q) or sell_rank or re.search(r"\bmy\b|\bhas the\b|\bis the\b", q):
                n = 1
            else:
                n = 5
            tab = tab.sort_values(first, ascending=asc).head(n)
            title = "%s %d %s by %s" % ("Bottom" if asc else "Top", len(tab), dn if len(tab) == 1 else _plural(dn), first)
        else:
            tab = tab.sort_values(first, ascending=False)
            title = "%s by %s (%d)" % (" & ".join(m[2] for m in gmets), dn, len(tab))
        if tab.empty:
            cn_ = [n_ for n_ in notes if re.search(r" [<>] ", n_)]
            return _out("No %s matches the condition: %s" % (dn, "; ".join(cn_)) + "".join("\n- " + n_ for n_ in notes if n_ not in cn_), table=[], filtered_rows=int(len(d)))
        shown = tab if len(tab) <= 200 else tab.head(200)
        span = _span(d, dc)
        rows_ = [[k + 1, i] + [_fmt(k_, shown.loc[i, l_]) for k_, _c, l_ in gmets] for k, i in enumerate(shown.index)]
        txt = _table(title, ["#", dn.title()] + [m[2] for m in gmets], rows_) + "".join("\n- " + n_ for n_ in notes)
        if span:
            txt += "\n- Period covered: " + span
        recs = [dict({dim[2]: i}, **{l_: float(shown.loc[i, l_]) for _k, _c, l_ in gmets}) for i in shown.index]
        res = _out(txt, table=recs, filtered_rows=int(len(d)), period_label=span, scope_notes=list(notes))
        if len(recs) > 1:
            res["result"]["chart_spec"] = {"type": "bar", "x": dim[2], "series": [m[2] for m in gmets], "interactive": True, "data": recs}
            if len(gmets) >= 2:
                res["result"]["chart_spec"]["dual_axis"] = True
        return res

    # ---------- scalar (only when scope/entity/multi-metric/median/synonym asks for it) ----------
    syn = re.search(r"\bturnover\b|\bsell\b|\bsold\b|\bselling\b", q) and not re.search(r"quantity|qty|units", q)
    maxmin = re.search(r"\b(maximum|highest|largest|biggest|max)\b", q), re.search(r"\b(minimum|lowest|smallest|min)\b", q)
    ov = "max" if (maxmin[0] and not maxmin[1]) else "min" if (maxmin[1] and not maxmin[0]) else None
    if notes or len(mets) >= 2 or syn or ov or any(a_ != "sum" for a_ in aggs.values()) or mets[0][0] in ("invoice_total", "margin", "count"):
        wordmap = {"sum": "Total", "mean": "Average", "median": "Median", "max": "Maximum", "min": "Minimum"}
        per_agg = {l_: (ov or aggs[l_]) for _k, _c, l_ in mets}
        span = _span(d, dc)
        date_scoped = any(n_.startswith(("Date", "Scope")) for n_ in notes)
        table, extra = None, {}
        if dc and date_scoped and len(d) and d[dc].dt.normalize().nunique() > 1 and all(a_ == "sum" for a_ in per_agg.values()):
            fr_ = "D" if d[dc].dt.normalize().nunique() <= 62 else "M"
            s_ = _group(d, _period_series(d, dc, fr_), mets)
            table = [dict({"period": i}, **{l_: float(s_.loc[i, l_]) for _k, _c, l_ in mets}) for i in sorted(s_.index)]
            extra["chart_spec"] = {"type": "bar", "x": "period", "series": [m_[2] for m_ in mets], "interactive": True, "data": table}
            if len(mets) >= 2:
                extra["chart_spec"]["dual_axis"] = True
        vals = [(("qty2" if (k_ == "qty" and per_agg[l_] != "sum") else k_), l_, _scalar_val(d, c_, per_agg[l_]), per_agg[l_]) for k_, c_, l_ in mets]
        totals = {l_: float(v) for _k, l_, v, _a in vals}
        if len(vals) == 1:
            k_, l_, v, a_ = vals[0]
            txt = "%s %s: %s  (%d rows)" % (wordmap[a_], l_.lower(), _fmt(k_, v), len(d)) + "".join("\n- " + n_ for n_ in notes)
            # Preserve daily summary separately from individual transactions.
            detail_table = []
            if len(d):
                detail_df = d.copy()

                # Convert date-like values into JSON-friendly strings.
                for col in detail_df.columns:
                    if hasattr(detail_df[col].dtype, "tz"):
                        detail_df[col] = detail_df[col].astype(str)

                if dc and dc in detail_df.columns:
                    detail_df[dc] = detail_df[dc].apply(
                        lambda x: x.strftime("%Y-%m-%d")
                        if hasattr(x, "strftime") else x
                    )

                detail_df = detail_df.astype(object).where(
                    detail_df.notna(), None
                )
                detail_table = detail_df.to_dict(orient="records")

            return _out(txt, value=v, total_value=float(v), filtered_rows=int(len(d)), table=table or [{l_: float(v)}],
                        detail_table=detail_table,
                        period_label=span, scope_notes=list(notes), **extra)
        words = {a_ for _k, _l, _v, a_ in vals}
        title = "%s (%d rows)" % (wordmap[words.pop()] if len(words) == 1 else "Summary", len(d))
        rows_ = [["%s %s" % (wordmap[a_], l_) if len(words) != 0 or True else l_, _fmt(k_, v)] for k_, l_, v, a_ in vals]
        txt = _table(title, ["Metric", "Value"], rows_) + "".join("\n- " + n_ for n_ in notes)
        return _out(txt, value=float(vals[0][2]), total_value=float(vals[0][2]), filtered_rows=int(len(d)),
                    table=table or [totals], totals=totals, period_label=span, scope_notes=list(notes), **extra)
    return None


def _handle_targeted_sales_gst_fy_queries(question, df):
    """Deterministic handlers for five verified dataset query failures."""
    q = str(question or "").strip().lower()
    if df is None or df.empty:
        return None

    def col(*names):
        return _col(list(df.columns), list(names))

    date_col = col("Date", "Bill Date", "Invoice Date")
    sales_col = col("GrossAmount", "Gross Amount", "Sales Amount")
    profit_col = col("Profit")
    taxable_col = col("TaxableAmount", "Taxable Amount")
    product_col = col("Product", "Item Name")
    category_col = col("Category")
    party_type_col = col("PartyType", "Party Type")
    state_col = col("PartyState", "Party State", "State")
    payment_col = col("PaymentMode", "Payment Mode")

    def numeric(frame, name):
        return pd.to_numeric(frame[name], errors="coerce").fillna(0.0)

    # TARGETED FIX: dealer with highest billing + that dealer's top category.
    party_name_col = col("PartyName", "Party Name", "Customer Name")
    compound_dealer_category = (
        bool(re.search(r"\bb2b\s+dealers?\b", q, re.I))
        and bool(re.search(r"\b(highest|maximum|max|top|largest|most)\b", q, re.I))
        and bool(re.search(r"\b(gross\s+billing|billing|sales|revenue)\b", q, re.I))
        and bool(re.search(r"\b(top\s+product\s+category|product\s+category|category)\b", q, re.I))
        and bool(re.search(r"\band\b", q, re.I))
    )

    compound_qtr = re.search(
        r"\bQ([1-4])\s*(?:of\s*)?FY\s*(20\d{2})\s*[-/]\s*(\d{2,4})\b",
        q, re.I
    )

    if (
        compound_dealer_category and compound_qtr
        and date_col and sales_col and party_type_col
        and state_col and party_name_col and category_col
    ):
        quarter = int(compound_qtr.group(1))
        fy_start_year = int(compound_qtr.group(2))
        suffix = compound_qtr.group(3)
        fy_end_year = (
            int(suffix) if len(suffix) == 4
            else (fy_start_year // 100) * 100 + int(suffix)
        )
        if fy_end_year <= fy_start_year:
            fy_end_year += 100

        start_month = 4 + 3 * (quarter - 1)
        start_year = fy_start_year
        if start_month > 12:
            start_month -= 12
            start_year += 1

        start = pd.Timestamp(start_year, start_month, 1)
        end = start + pd.DateOffset(months=3)

        work = df.copy()
        work[date_col] = _to_dt(work[date_col])
        work = work.dropna(subset=[date_col])
        work = work[
            (work[date_col] >= start) & (work[date_col] < end)
        ].copy()

        actual_party = work[party_type_col].astype(str).str.strip().str.casefold()
        work = work[actual_party == "b2b dealer"].copy()

        states = sorted(
            df[state_col].dropna().astype(str).str.strip().unique(),
            key=len, reverse=True
        )
        requested_state = next(
            (v for v in states if v and re.search(re.escape(v), q, re.I)),
            None
        )
        if requested_state:
            work = work[
                work[state_col].astype(str).str.strip().str.casefold()
                == requested_state.casefold()
            ].copy()

        if work.empty:
            return _out(
                "No matching B2B Dealer records were found for the requested state and quarter.",
                table=[], table_rows=0, filtered_rows=0
            )

        work["__gross__"] = numeric(work, sales_col)
        dealer_totals = (
            work.groupby(work[party_name_col].astype(str).str.strip())["__gross__"]
            .sum().sort_values(ascending=False)
        )

        if dealer_totals.empty:
            return None

        winner = str(dealer_totals.index[0])
        winner_billing = float(dealer_totals.iloc[0])
        winner_rows = work[
            work[party_name_col].astype(str).str.strip() == winner
        ].copy()

        category_totals = (
            winner_rows.groupby(winner_rows[category_col].astype(str).str.strip())["__gross__"]
            .sum().sort_values(ascending=False)
        )
        if category_totals.empty:
            return _out(
                "%s generated %s gross billing, but no product category is available."
                % (winner, _fmt("sales", winner_billing)),
                table=[], table_rows=0, filtered_rows=len(winner_rows)
            )

        top_category = str(category_totals.index[0])
        category_billing = float(category_totals.iloc[0])
        period = "Q%d FY%d-%02d" % (quarter, fy_start_year, fy_end_year % 100)

        records = [
            {"Dealer": winner, "Gross Billing": winner_billing},
            {"Top Product Category": top_category, "Category Gross Billing": category_billing},
        ]
        answer = (
            "Highest B2B Dealer in %s: %s\n"
            "Dealer gross billing: %s\n"
            "Top product category for this dealer: %s\n"
            "Category gross billing: %s\n"
            "Financial period: %s"
        ) % (
            requested_state or "the requested state",
            winner, _fmt("sales", winner_billing),
            top_category, _fmt("sales", category_billing), period
        )
        return _out(
            answer, table=records, table_rows=len(records),
            filtered_rows=int(len(winner_rows)),
            aggregate_column=sales_col,
            aggregate_function="dealer_then_category_rank",
            group_by=party_name_col,
            period_label=period
        )

    # TARGETED FIX: top N products by total profit inside a named category.
    top_n_match = re.search(r"\btop\s+(\d+)\b", q, re.I)
    asks_products = bool(re.search(r"\bproducts?\b", q, re.I))
    asks_profit = bool(re.search(r"\b(net\s+)?profit\b", q, re.I))
    asks_rank = bool(re.search(r"\b(top|highest|most|largest)\b", q, re.I))

    if (
        top_n_match and asks_products and asks_profit and asks_rank
        and category_col and product_col and profit_col
    ):
        available_categories = sorted(
            df[category_col].dropna().astype(str).str.strip().unique(),
            key=len, reverse=True
        )
        requested_category = next(
            (
                value for value in available_categories
                if value and re.search(re.escape(value), q, re.I)
            ),
            None
        )

        if requested_category:
            n = max(1, min(int(top_n_match.group(1)), 20))
            work = df[
                df[category_col].astype(str).str.strip().str.casefold()
                == requested_category.casefold()
            ].copy()
            work["__profit__"] = numeric(work, profit_col)

            ranked = (
                work.groupby(work[product_col].astype(str).str.strip())["__profit__"]
                .sum().sort_values(ascending=False).head(n)
            )
            records = [
                {"Rank": i + 1, "Product": str(name), "Total Net Profit": float(value)}
                for i, (name, value) in enumerate(ranked.items())
            ]
            display = [
                [r["Rank"], r["Product"], _fmt("profit", r["Total Net Profit"])]
                for r in records
            ]
            answer = _table(
                "Top %d products by total net profit in %s"
                % (n, requested_category),
                ["Rank", "Product", "Total Net Profit"], display
            )
            if not records:
                answer = "No products with profit data were found in category %s." % requested_category

            return _out(
                answer, table=records, table_rows=len(records),
                filtered_rows=int(len(work)),
                aggregate_column=profit_col,
                aggregate_function="group_rank",
                group_by=product_col,
                scope_notes=["Category filter applied: %s." % requested_category]
            )

    # STATE_RANKING_AND_PAYMENT_MODE_FY_QUARTER_V1
    # Generic state sales ranking and payment-mode transaction ranking.

    fy_quarter_match = re.search(
        r"\bQ([1-4])\s*(?:of\s*)?FY\s*(20\d{2})\s*[-/]\s*(\d{2,4})\b",
        q,
        re.I,
    )

    wants_state_ranking = (
        bool(re.search(
            r"\b(?:highest|maximum|max|top|largest|most)\b", q
        ))
        and bool(re.search(r"\bstates?\b", q))
        and bool(re.search(
            r"\b(?:gross\s+billing|billing|sales|revenue|turnover)\b", q
        ))
    )

    wants_payment_ranking = (
        bool(re.search(
            r"\b(?:highest|maximum|max|most|top)\b", q
        ))
        and bool(re.search(r"\bpayment\s+modes?\b", q))
        and bool(re.search(
            r"\b(?:transactions?|invoices?)\b", q
        ))
    )

    if (
        (wants_state_ranking or wants_payment_ranking)
        and fy_quarter_match
        and date_col
        and party_type_col
        and state_col
    ):
        quarter = int(fy_quarter_match.group(1))
        fy_start_year = int(fy_quarter_match.group(2))
        suffix = fy_quarter_match.group(3)

        fy_end_year = (
            int(suffix)
            if len(suffix) == 4
            else (fy_start_year // 100) * 100 + int(suffix)
        )
        if fy_end_year <= fy_start_year:
            fy_end_year += 100

        start_month = 4 + 3 * (quarter - 1)
        start_year = fy_start_year

        if start_month > 12:
            start_month -= 12
            start_year += 1

        quarter_start = pd.Timestamp(start_year, start_month, 1)
        quarter_end = quarter_start + pd.DateOffset(months=3)

        work = df.copy()
        work[date_col] = _to_dt(work[date_col])
        work = work.dropna(subset=[date_col])

        work = work[
            (work[date_col] >= quarter_start)
            & (work[date_col] < quarter_end)
        ].copy()

        # Normalize Retail / Retail Customer and other party types.
        party_aliases = {
            "retail": "retail customer",
            "retail customer": "retail customer",
            "retail customers": "retail customer",
            "b2b": "b2b dealer",
            "b2b dealer": "b2b dealer",
            "b2b dealers": "b2b dealer",
            "wholesale": "wholesale distributor",
            "wholesale distributor": "wholesale distributor",
            "wholesale distributors": "wholesale distributor",
            "online": "online marketplace buyer",
            "online marketplace buyer": "online marketplace buyer",
            "online marketplace buyers": "online marketplace buyer",
        }

        party_match = re.search(
            r"\b(retail\s+customers?|b2b\s+dealers?|b2b|"
            r"wholesale\s+distributors?|wholesale|"
            r"online\s+marketplace\s+buyers?|online)\b",
            q,
            re.I,
        )

        if party_match:
            requested_party = re.sub(
                r"\s+", " ", party_match.group(1).strip().casefold()
            )
            requested_party = party_aliases.get(
                requested_party, requested_party
            )

            actual_party = (
                work[party_type_col]
                .astype(str)
                .str.strip()
                .str.casefold()
            )
            work = work[
                actual_party == requested_party
            ].copy()

        # Resolve state against the complete source dataset.
        available_states = sorted(
            df[state_col].dropna().astype(str).str.strip().unique(),
            key=len,
            reverse=True,
        )

        requested_state = next(
            (
                value for value in available_states
                if value and re.search(re.escape(value), q, re.I)
            ),
            None,
        )

        if requested_state:
            work = work[
                work[state_col].astype(str).str.strip().str.casefold()
                == requested_state.casefold()
            ].copy()

        if work.empty:
            return _out(
                "No matching records were found for the requested "
                "party type, state and financial quarter.",
                table=[],
                table_rows=0,
                filtered_rows=0,
                period_label="Q%d FY%d-%02d" % (
                    quarter, fy_start_year, fy_end_year % 100
                ),
            )

        period_name = "Q%d FY%d-%02d" % (
            quarter, fy_start_year, fy_end_year % 100
        )

        if wants_state_ranking:
            if not sales_col:
                return _out(
                    "Gross sales amount column is unavailable.",
                    table=[],
                    table_rows=0,
                )

            work["__gross_sales__"] = numeric(work, sales_col)

            grouped = (
                work.groupby(
                    work[state_col].astype(str).str.strip()
                )["__gross_sales__"]
                .sum()
                .sort_values(ascending=False)
            )

            if grouped.empty:
                return _out(
                    "No state-wise sales data is available.",
                    table=[],
                    table_rows=0,
                )

            winner_state = str(grouped.index[0])
            winner_sales = float(grouped.iloc[0])
            total_sales = float(grouped.sum())
            share = (
                winner_sales / total_sales * 100
                if total_sales else 0.0
            )

            records = [
                {
                    "State": str(state),
                    "Gross Billing": float(value),
                    "Share %": (
                        float(value) / total_sales * 100
                        if total_sales else 0.0
                    ),
                }
                for state, value in grouped.items()
            ]

            display = [
                [r["State"], _fmt("sales", r["Gross Billing"]),
                 _fmt("share", r["Share %"])]
                for r in records
            ]

            answer = _table(
                "State-wise gross billing",
                ["State", "Gross Billing", "Share %"],
                display,
            )

            answer = (
                "Highest state: %s\n"
                "Gross billing: %s\n"
                "Share of filtered billing: %s\n"
                "Financial period: %s\n\n"
            ) % (
                winner_state,
                _fmt("sales", winner_sales),
                _fmt("share", share),
                period_name,
            ) + answer

            return _out(
                answer,
                table=records,
                table_rows=len(records),
                filtered_rows=int(len(work)),
                aggregate_column=sales_col,
                aggregate_function="group_rank",
                group_by=state_col,
                period_label=period_name,
                scope_notes=[
                    "Party type and financial quarter filters applied.",
                    "Gross billing calculated using %s." % sales_col,
                ],
                chart_spec={
                    "type": "bar",
                    "x": "State",
                    "series": ["Gross Billing"],
                    "interactive": True,
                    "data": records,
                },
            )

        if wants_payment_ranking:
            if not payment_col:
                return _out(
                    "Payment mode column is unavailable.",
                    table=[],
                    table_rows=0,
                )

            invoice_col = col("InvoiceNo", "Invoice No", "Invoice Number")

            if not invoice_col:
                return _out(
                    "Invoice number column is unavailable; "
                    "unique transaction count cannot be calculated.",
                    table=[],
                    table_rows=0,
                )

            work["__payment_mode__"] = (
                work[payment_col].astype(str).str.strip()
            )

            grouped = (
                work.groupby("__payment_mode__")[invoice_col]
                .nunique()
                .sort_values(ascending=False)
            )

            records = [
                {
                    "Payment Mode": str(mode),
                    "Transactions": int(count),
                }
                for mode, count in grouped.items()
            ]

            display = [
                [r["Payment Mode"], "{:,}".format(r["Transactions"])]
                for r in records
            ]

            if not records:
                return _out(
                    "No payment-mode transactions were found.",
                    table=[],
                    table_rows=0,
                )

            answer = _table(
                "Payment mode transaction ranking",
                ["Payment Mode", "Unique Transactions"],
                display,
            )

            answer = (
                "Highest payment mode: %s (%s unique transactions)\n"
                "Financial period: %s\n\n"
            ) % (
                records[0]["Payment Mode"],
                "{:,}".format(records[0]["Transactions"]),
                period_name,
            ) + answer

            return _out(
                answer,
                table=records,
                table_rows=len(records),
                filtered_rows=int(len(work)),
                aggregate_column=invoice_col,
                aggregate_function="group_rank",
                group_by=payment_col,
                period_label=period_name,
                scope_notes=[
                    "Transaction count uses unique invoice numbers.",
                    "Party type, state and financial quarter filters applied.",
                ],
                chart_spec={
                    "type": "bar",
                    "x": "Payment Mode",
                    "series": ["Transactions"],
                    "interactive": True,
                    "data": records,
                },
            )

    def make_table(title, headers, records, display_rows, chart=None, **extra):
        answer = _table(title, headers, display_rows)
        return _out(answer, table=records, table_rows=len(records),
                    filtered_rows=int(extra.pop("filtered_rows", len(df))),
                    chart_spec=chart, **extra)


    # CATEGORY_METRIC_COMPARISON_V1
    # Compare explicitly named categories using aggregated financial ratios.
    markup_margin_compare = (
        bool(re.search(r"\b(compare|comparison|versus|vs\.?|difference)\b", q, re.I))
        and bool(re.search(
            r"\bmarkup\s+(?:on|over|against)\s+cost\b", q, re.I
        ))
        and bool(re.search(r"\bprofit[\s-]*margin\b", q, re.I))
    )

    if markup_margin_compare:
        compare_category_col = category_col or col("Category")
        compare_profit_col = profit_col or col("Profit")
        compare_cost_col = col("Cost")
        compare_taxable_col = col(
            "TaxableAmount", "Taxable Amount"
        )

        if all([
            compare_category_col,
            compare_profit_col,
            compare_cost_col,
            compare_taxable_col,
        ]):
            available_categories = sorted(
                df[compare_category_col]
                .dropna()
                .astype(str)
                .str.strip()
                .unique(),
                key=len,
                reverse=True,
            )

            selected_categories = []
            for candidate in available_categories:
                if not candidate:
                    continue

                category_pattern = (
                    r"(?<![a-z0-9])"
                    + re.escape(candidate)
                    + r"(?![a-z0-9])"
                )

                if re.search(category_pattern, q, re.I):
                    selected_categories.append(candidate)

            if len(selected_categories) >= 2:
                work = df.copy()

                work["__compare_profit__"] = numeric(
                    work, compare_profit_col
                )
                work["__compare_cost__"] = numeric(
                    work, compare_cost_col
                )
                work["__compare_gross__"] = numeric(
                    work, compare_taxable_col
                )

                category_values = (
                    work[compare_category_col]
                    .astype(str)
                    .str.strip()
                    .str.casefold()
                )

                work = work[
                    category_values.isin(
                        [x.casefold() for x in selected_categories]
                    )
                ].copy()

                records = []
                display = []

                for category in selected_categories:
                    category_rows = work[
                        work[compare_category_col]
                        .astype(str)
                        .str.strip()
                        .str.casefold()
                        == category.casefold()
                    ]

                    if category_rows.empty:
                        continue

                    total_profit = float(
                        category_rows["__compare_profit__"].sum()
                    )
                    total_cost = float(
                        category_rows["__compare_cost__"].sum()
                    )
                    taxable_amount = float(
                        category_rows["__compare_gross__"].sum()
                    )

                    markup_pct = (
                        total_profit / total_cost * 100
                        if total_cost != 0 else None
                    )
                    margin_pct = (
                        total_profit / taxable_amount * 100
                        if taxable_amount != 0 else None
                    )

                    record = {
                        "Category": category,
                        "Total Profit": total_profit,
                        "Total Cost": total_cost,
                        "Taxable Amount": taxable_amount,
                        "Markup on Cost %": markup_pct,
                        "Profit Margin %": margin_pct,
                    }
                    records.append(record)

                    display.append([
                        category,
                        _fmt("profit", total_profit),
                        _fmt("sales", total_cost),
                        _fmt("sales", taxable_amount),
                        "-" if markup_pct is None
                        else _fmt("share", markup_pct),
                        "-" if margin_pct is None
                        else _fmt("share", margin_pct),
                    ])

                if records:
                    answer = _table(
                        "Category-wise Markup on Cost and Profit Margin",
                        [
                            "Category",
                            "Total Profit",
                            "Total Cost",
                            "Taxable Amount",
                            "Markup on Cost %",
                            "Profit Margin %",
                        ],
                        display,
                    )

                    answer += (
                        "\n\n- Markup on Cost = Total Profit / Total Cost * 100"
                        "\n- Profit Margin = Total Profit / Total Taxable Amount * 100"
                        "\n- Ratios are calculated from category-level totals."
                    )

                    difference_request = bool(
                        re.search(r"\bdifference\b", q, re.I)
                    )

                    if difference_request and len(records) >= 2:
                        first = records[0]
                        second = records[1]

                        answer += "\n\nDifference between categories:"

                        for metric_name in [
                            "Markup on Cost %",
                            "Profit Margin %",
                        ]:
                            first_value = first.get(metric_name)
                            second_value = second.get(metric_name)

                            if first_value is None or second_value is None:
                                continue

                            difference_pp = abs(
                                second_value - first_value
                            )

                            if first_value > second_value:
                                higher_category = first["Category"]
                            elif second_value > first_value:
                                higher_category = second["Category"]
                            else:
                                higher_category = "Both categories are equal"

                            answer += (
                                "\n- %s: %.2f percentage points; higher: %s."
                                % (
                                    metric_name,
                                    difference_pp,
                                    higher_category,
                                )
                            )

                    return _out(
                        answer,
                        table=records,
                        table_rows=len(records),
                        filtered_rows=int(len(work)),
                        aggregate_function="category_ratio_comparison",
                        group_by=compare_category_col,
                        period_label="Entire uploaded dataset",
                        scope_notes=[
                            "Categories: " + ", ".join(
                                r["Category"] for r in records
                            ),
                            "Markup uses total Profit divided by total Cost.",
                            "Profit margin uses total Profit divided by total TaxableAmount.",
                        ],
                        chart_spec={
                            "type": "bar",
                            "x": "Category",
                            "series": [
                                "Markup on Cost %",
                                "Profit Margin %",
                            ],
                            "interactive": True,
                            "data": records,
                        },
                    )

    # 1) Highest calendar month, then top N categories within that month.
    highest_month_request = (
        bool(re.search(r"\b(highest|maximum|max|largest|biggest|top)\b", q))
        and bool(re.search(r"\bmonth\b", q))
        and bool(re.search(r"\b(categories|category)\b", q))
        and bool(re.search(r"\b(sales|revenue|gross)\b", q))
        and bool(re.search(r"\b(which|what|give|show|find|top)\b", q))
    )
    if highest_month_request and date_col and sales_col and category_col:
        work = df.copy()
        work[date_col] = pd.to_datetime(work[date_col], errors="coerce")
        work[sales_col] = numeric(work, sales_col)
        work = work.dropna(subset=[date_col])
        if not work.empty:
            monthly = work.groupby(work[date_col].dt.to_period("M"))[sales_col].sum()
            if not monthly.empty:
                peak_period = monthly.idxmax()
                peak_sales = float(monthly.loc[peak_period])
                month_rows = work[work[date_col].dt.to_period("M") == peak_period]
                top_match = re.search(r"\btop\s+(\d+)\b", q)
                n = int(top_match.group(1)) if top_match else 2
                n = max(1, min(n, 20))
                cats = (month_rows.groupby(month_rows[category_col].astype(str))[sales_col]
                        .sum().sort_values(ascending=False).head(n))
                records = [{"Category": str(k), "Sales": float(v)} for k, v in cats.items()]
                display = [[i + 1, r["Category"], _fmt("sales", r["Sales"])]
                           for i, r in enumerate(records)]
                answer = _table(
                    "Highest sales month and top %d categories" % n,
                    ["#", "Category", "Sales"], display
                )
                answer = (
                    "Highest sales month: %s (%s)\n\n" %
                    (peak_period.strftime("%B %Y"), _fmt("sales", peak_sales))
                ) + answer
                chart_rows = records
                return _out(
                    answer, table=records, table_rows=len(records),
                    filtered_rows=int(len(month_rows)),
                    period_label=peak_period.strftime("%b %Y"),
                    highest_month=peak_period.strftime("%Y-%m"),
                    highest_month_sales=peak_sales,
                    chart_spec={"type": "bar", "x": "Category",
                                "series": ["Sales"], "interactive": True,
                                "data": chart_rows}
                )

    # Parse FY2025-26 into the starting year 2025 and ending year 2026.
    fy_match = re.search(r"\bfy\s*(20\d{2})\s*[-/]\s*(\d{2,4})\b", q)
    fy_start = int(fy_match.group(1)) if fy_match else None
    if fy_match:
        suffix = fy_match.group(2)
        fy_end = int(suffix) if len(suffix) == 4 else (fy_start // 100) * 100 + int(suffix)
        if fy_end <= fy_start:
            fy_end += 100
    # PRODUCT_SALES_FY_QUARTER_COMPARISON_V2
    # Compare one exact product across any two explicitly named financial quarters.
    fy_quarter_refs = list(re.finditer(
        r"\bQ([1-4])\s*(?:of\s*)?FY\s*(20\d{2})\s*[-/]\s*(\d{2,4})\b",
        q,
        flags=re.IGNORECASE,
    ))

    product_quarter_comparison = (
        len(fy_quarter_refs) >= 2
        and bool(re.search(r"\b(compare|between|versus|vs)\b", q))
        and bool(re.search(r"\b(sales|revenue|gross|turnover)\b", q))
    )

    if product_quarter_comparison and date_col and sales_col and product_col:
        first_ref, second_ref = fy_quarter_refs[:2]

        def _fy_ref(ref):
            quarter = int(ref.group(1))
            fy_start_year = int(ref.group(2))
            suffix = ref.group(3)
            fy_end_year = (
                int(suffix) if len(suffix) == 4
                else (fy_start_year // 100) * 100 + int(suffix)
            )
            if fy_end_year <= fy_start_year:
                fy_end_year += 100
            return quarter, fy_start_year, fy_end_year

        first_spec = _fy_ref(first_ref)
        second_spec = _fy_ref(second_ref)

        # Match the longest exact product name from the uploaded data.
        query_product = None
        available_products = sorted(
            df[product_col].dropna().astype(str).str.strip().unique(),
            key=len,
            reverse=True,
        )
        for product_name in available_products:
            if product_name and re.search(re.escape(product_name.casefold()), q.casefold()):
                query_product = product_name
                break

        # Typo-tolerant fallback: compare product-name-sized token windows,
        # but accept only a clear high-confidence winner to avoid wrong entities.
        if not query_product:
            query_tokens = re.findall(r"[a-z0-9]+", q.casefold())
            candidates = []
            for product_name in available_products:
                product_tokens = re.findall(r"[a-z0-9]+", product_name.casefold())
                if not product_tokens:
                    continue
                n = len(product_tokens)
                best_score = 0.0
                for width in (max(1, n - 1), n, n + 1):
                    for i in range(max(0, len(query_tokens) - width + 1)):
                        phrase = "".join(query_tokens[i:i + width])
                        target = "".join(product_tokens)
                        score = difflib.SequenceMatcher(None, phrase, target).ratio()
                        best_score = max(best_score, score)
                candidates.append((best_score, product_name))
            candidates.sort(reverse=True)
            if candidates and candidates[0][0] >= 0.84:
                runner_up = candidates[1][0] if len(candidates) > 1 else 0.0
                if candidates[0][0] - runner_up >= 0.025:
                    query_product = candidates[0][1]

        if query_product:
            work = df.copy()
            work[date_col] = _to_dt(work[date_col])
            work["__sales__"] = numeric(work, sales_col)
            work["__product__"] = work[product_col].astype(str).str.strip().str.casefold()
            product_rows = work[
                work["__product__"] == query_product.casefold()
            ].dropna(subset=[date_col]).copy()

            if not product_rows.empty:
                quarter_results = []
                for quarter, fy_start_year, fy_end_year in (first_spec, second_spec):
                    start_month = 4 + 3 * (quarter - 1)
                    start_year = fy_start_year
                    if start_month > 12:
                        start_month -= 12
                        start_year += 1
                    quarter_start = pd.Timestamp(start_year, start_month, 1)
                    quarter_end = quarter_start + pd.DateOffset(months=3)
                    quarter_rows = product_rows[
                        (product_rows[date_col] >= quarter_start)
                        & (product_rows[date_col] < quarter_end)
                    ]
                    quarter_results.append({
                        "Quarter": "Q%d FY%d-%02d" % (quarter, fy_start_year, fy_end_year % 100),
                        "Sales Revenue": float(quarter_rows["__sales__"].sum()),
                        "Transactions": int(len(quarter_rows)),
                        "Start Date": quarter_start.strftime("%Y-%m-%d"),
                        "End Date": (quarter_end - pd.Timedelta(days=1)).strftime("%Y-%m-%d"),
                    })

                first_sales = quarter_results[0]["Sales Revenue"]
                second_sales = quarter_results[1]["Sales Revenue"]
                difference = second_sales - first_sales
                change_pct = (difference / first_sales * 100) if first_sales else None

                records = [
                    {"Product": query_product, **quarter_results[0]},
                    {"Product": query_product, **quarter_results[1]},
                ]
                display = [
                    [row["Quarter"], _fmt("sales", row["Sales Revenue"]),
                     "{:,}".format(row["Transactions"])]
                    for row in quarter_results
                ]
                answer = _table(
                    "Product sales revenue: financial quarter comparison",
                    ["Financial Quarter", "Sales Revenue", "Transactions"],
                    display,
                )
                answer += (
                    "\n\n- Product: %s" % query_product
                    + "\n- Comparison: %s vs %s" % (quarter_results[1]["Quarter"], quarter_results[0]["Quarter"])
                    + "\n- Revenue difference: %s" % _fmt("sales", difference)
                    + "\n- Percentage change: %s" % (
                        "-" if change_pct is None else _fmt("pct", change_pct)
                    )
                )
                return _out(
                    answer,
                    table=records,
                    table_rows=len(records),
                    filtered_rows=int(len(product_rows)),
                    period_label="%s vs %s" % (quarter_results[0]["Quarter"], quarter_results[1]["Quarter"]),
                    scope_notes=[
                        "Product: " + query_product,
                        "Financial quarters use April–June, July–September, October–December, and January–March.",
                    ],
                    chart_spec={
                        "type": "bar",
                        "x": "Quarter",
                        "series": ["Sales Revenue"],
                        "interactive": True,
                        "data": [
                            {"Quarter": row["Quarter"], "Sales Revenue": row["Sales Revenue"]}
                            for row in records
                        ],
                    },
                )
    # 2) All four financial-year quarters, with sequential QoQ movement.
    qoq_request = (
        bool(re.search(r"\bqoq\b|quarter[\s-]*over[\s-]*quarter", q))
        and bool(re.search(r"\b(all\s+)?4\s+quarters?\b|four\s+quarters?", q))
        and bool(re.search(r"\b(gross\s+)?sales\b", q))
        and bool(re.search(r"\bb2b\s+dealers?\b", q))
    )
    if qoq_request and fy_start and date_col and sales_col and party_type_col:
        work = df.copy()
        work[date_col] = pd.to_datetime(work[date_col], errors="coerce")
        work[sales_col] = numeric(work, sales_col)
        work = work[
            (work[date_col] >= pd.Timestamp(fy_start, 4, 1)) &
            (work[date_col] < pd.Timestamp(fy_end, 4, 1)) &
            (work[party_type_col].astype(str).str.strip().str.casefold() == "b2b dealer")
        ].copy()
        if not work.empty:
            work["__fy_quarter__"] = ((work[date_col].dt.month - 4) % 12) // 3 + 1
            totals = work.groupby("__fy_quarter__")[sales_col].sum()
            records, display = [], []
            previous = None
            for quarter in range(1, 5):
                value = float(totals.get(quarter, 0.0))
                change = None if previous is None or previous == 0 else (value - previous) / previous * 100
                records.append({
                    "Quarter": "Q%d FY%d-%02d" % (quarter, fy_start, fy_end % 100),
                    "Sales": value,
                    "QoQ Change %": change
                })
                display.append([
                    "Q%d FY%d-%02d" % (quarter, fy_start, fy_end % 100),
                    _fmt("sales", value),
                    "-" if change is None else _fmt("pct", change)
                ])
                previous = value
            answer = _table(
                "B2B Dealer gross sales — financial-year QoQ",
                ["Financial quarter", "Gross Sales", "QoQ Change"], display
            )
            answer += "\n- PartyType: B2B Dealer"
            answer += "\n- Financial year: %d-%02d (April to March)" % (fy_start, fy_end % 100)

            declines = [
                row for row in records
                if row["QoQ Change %"] is not None and row["QoQ Change %"] < 0
            ]
            if declines:
                worst_drop = min(declines, key=lambda row: row["QoQ Change %"])
                previous_index = records.index(worst_drop) - 1
                previous_sales = records[previous_index]["Sales"]
                drop_amount = worst_drop["Sales"] - previous_sales
                answer += (
                    "\n- Highest revenue drop: %s"
                    " (%s; decrease of %s vs preceding quarter)"
                    % (
                        worst_drop["Quarter"],
                        _fmt("pct", worst_drop["QoQ Change %"]),
                        _fmt("sales", abs(drop_amount)),
                    )
                )

            return _out(
                answer, table=records, table_rows=4,
                filtered_rows=int(len(work)),
                period_label="FY%d-%02d" % (fy_start, fy_end % 100),
                scope_notes=["PartyType: B2B Dealer", "Financial year: April to March"],
                chart_spec={"type": "line", "x": "Quarter",
                            "series": ["Sales"], "interactive": True,
                            "data": records}
            )

    # 3) GST components, combined CGST+SGST and contribution percentages.
    gst_compare = (
        bool(re.search(r"\bigst\b", q)) and bool(re.search(r"\bcgst\b", q))
        and bool(re.search(r"\bsgst\b", q))
        and bool(re.search(r"\b(compare|versus|vs|total|collected|gst)\b", q))
        and not bool(re.search(
            r"\bratio\b|\bpercentage\b|\bpercent\b|\bshare\b", q
        ))
    )
    if gst_compare:
        igst_col, cgst_col, sgst_col = col("IGST"), col("CGST"), col("SGST")
        if igst_col and cgst_col and sgst_col:
            igst = float(numeric(df, igst_col).sum())
            cgst = float(numeric(df, cgst_col).sum())
            sgst = float(numeric(df, sgst_col).sum())
            combined = cgst + sgst
            total_col = col("TotalGST", "Total GST")
            total = float(numeric(df, total_col).sum()) if total_col else igst + combined
            # Prefer component sum if a stored total is inconsistent.
            component_total = igst + combined
            if abs(total - component_total) > max(0.02, abs(component_total) * 1e-6):
                total = component_total
            records = [
                {"Metric": "IGST", "Amount": igst, "Share %": igst / total * 100 if total else None},
                {"Metric": "CGST", "Amount": cgst, "Share %": cgst / total * 100 if total else None},
                {"Metric": "SGST", "Amount": sgst, "Share %": sgst / total * 100 if total else None},
                {"Metric": "CGST + SGST", "Amount": combined, "Share %": combined / total * 100 if total else None},
                {"Metric": "Total GST", "Amount": total, "Share %": 100.0 if total else None},
            ]
            display = [[r["Metric"], _fmt("gst", r["Amount"]),
                        "-" if r["Share %"] is None else _fmt("share", r["Share %"])]
                       for r in records]
            answer = _table("GST collection comparison", ["Metric", "Amount", "Share of GST"], display)
            return _out(answer, table=records, table_rows=len(records),
                        filtered_rows=int(len(df)), total_value=total,
                        totals={"IGST": igst, "CGST": cgst, "SGST": sgst,
                                "CGST_SGST_Combined": combined, "GST": total})

    # 4) Cash reliance = cash sales / all sales for each PartyType.
    cash_reliance = (
        bool(re.search(r"\bcash\b", q))
        and bool(re.search(r"\breliance\b|\bdependen(?:ce|t)\b|\bshare\b|\bpercentage\b|\bpercent\b", q))
        and bool(re.search(r"\bparty[\s_-]*type\b", q))
    )
    if cash_reliance and sales_col and party_type_col and payment_col:
        work = df.copy()
        work[sales_col] = numeric(work, sales_col)
        work["__party_type__"] = work[party_type_col].astype(str).str.strip()
        totals = work.groupby("__party_type__")[sales_col].sum()
        cash = work[work[payment_col].astype(str).str.strip().str.casefold() == "cash"]
        cash_totals = cash.groupby("__party_type__")[sales_col].sum()
        records, display = [], []
        for party, total_sales in totals.items():
            cash_sales = float(cash_totals.get(party, 0.0))
            total_sales = float(total_sales)
            pct = cash_sales / total_sales * 100 if total_sales else None
            records.append({"PartyType": str(party), "Cash Sales": cash_sales,
                            "Total Sales": total_sales, "Cash Reliance %": pct})
        records.sort(key=lambda r: (r["Cash Reliance %"] is not None,
                                    r["Cash Reliance %"] or -1), reverse=True)
        for r in records:
            display.append([r["PartyType"], _fmt("sales", r["Cash Sales"]),
                            _fmt("sales", r["Total Sales"]),
                            "-" if r["Cash Reliance %"] is None else _fmt("share", r["Cash Reliance %"])])
        answer = _table("Cash reliance by PartyType",
                        ["PartyType", "Cash Sales", "Total Sales", "Cash Reliance %"], display)
        return _out(answer, table=records, table_rows=len(records),
                    filtered_rows=int(len(df)),
                    chart_spec={"type": "bar", "x": "PartyType",
                                "series": ["Cash Reliance %"], "interactive": True,
                                "data": records})

    # 5A) Product sales decrease only between FY quarters.
    product_sales_decrease_only = (
        bool(re.search(r"\bproducts?\b", q))
        and bool(re.search(r"\b(sales?|revenue|turnover|gross)\b", q))
        and bool(re.search(
            r"\b(decreas\w*|declin\w*|drop\w*|fall\w*|down|reduc\w*)\b", q
        ))
        and bool(re.search(r"\bq1\b", q))
        and bool(re.search(r"\bq2\b", q))
        and not bool(re.search(r"profit[\s-]*margin", q))
    )

    if product_sales_decrease_only and fy_start and date_col and sales_col and product_col:
        work = df.copy()
        work[date_col] = pd.to_datetime(work[date_col], errors="coerce")
        work[sales_col] = numeric(work, sales_col)

        start = pd.Timestamp(fy_start, 4, 1)
        end = pd.Timestamp(fy_end, 4, 1)

        work = work[
            (work[date_col] >= start) &
            (work[date_col] < end)
        ].copy()

        work["__fy_quarter__"] = (
            ((work[date_col].dt.month - 4) % 12) // 3 + 1
        )
        work = work[work["__fy_quarter__"].isin([1, 2])]

        grouped = work.groupby([product_col, "__fy_quarter__"]).agg(
            Sales=(sales_col, "sum")
        )

        records = []

        for product in sorted(work[product_col].dropna().astype(str).unique()):
            p1 = grouped.loc[(product, 1)] if (product, 1) in grouped.index else None
            p2 = grouped.loc[(product, 2)] if (product, 2) in grouped.index else None

            if p1 is None or p2 is None:
                continue

            s1 = float(p1["Sales"])
            s2 = float(p2["Sales"])

            # Only products with lower Q2 sales.
            if s1 > 0 and s2 < s1:
                change = s2 - s1
                change_pct = (change / s1) * 100

                records.append({
                    "Product": product,
                    "Q1 Sales": s1,
                    "Q2 Sales": s2,
                    "Sales Change": change,
                    "Sales Change %": change_pct
                })

        records.sort(key=lambda r: r["Sales Change %"])

        display = [
            [
                r["Product"],
                _fmt("sales", r["Q1 Sales"]),
                _fmt("sales", r["Q2 Sales"]),
                ("-" if r["Sales Change"] < 0 else "+") +
                _fmt("sales", abs(r["Sales Change"])),
                _fmt("pct", r["Sales Change %"])
            ]
            for r in records
        ]

        answer = _table(
            "Products with decreased sales: Q1 vs Q2 FY%d-%02d"
            % (fy_start, fy_end % 100),
            ["Product", "Q1 Sales", "Q2 Sales", "Sales Change", "Sales Change %"],
            display
        )

        return _out(
            answer,
            table=records,
            table_rows=len(records),
            filtered_rows=int(len(work)),
            period_label="Q1 vs Q2 FY%d-%02d" % (fy_start, fy_end % 100),
            chart_spec={
                "type": "bar",
                "x": "Product",
                "series": ["Q1 Sales", "Q2 Sales"],
                "interactive": True,
                "data": records
            }
        )

    # 5) Product sales decrease + profit-margin increase between FY quarters.
    product_margin_compare = (
        bool(re.search(r"\bproducts?\b", q))
        and bool(re.search(r"\b(sales?|revenue|turnover|gross)\b", q))
        and bool(re.search(r"\b(decreas\w*|declin\w*|drop\w*|fall\w*|down)\b", q))
        and bool(re.search(r"profit[\s-]*margin", q))
        and bool(re.search(r"\b(increas\w*|improv\w*|ris\w*|higher)\b", q))
        and bool(re.search(r"\bq1\b", q))
        and bool(re.search(r"\bq2\b", q))
    )
    if product_margin_compare and fy_start and date_col and sales_col and profit_col and taxable_col and product_col:
        work = df.copy()
        work[date_col] = pd.to_datetime(work[date_col], errors="coerce")
        for c_name in (sales_col, profit_col, taxable_col):
            work[c_name] = numeric(work, c_name)
        start = pd.Timestamp(fy_start, 4, 1)
        end = pd.Timestamp(fy_end, 4, 1)
        work = work[(work[date_col] >= start) & (work[date_col] < end)].copy()
        work["__fy_quarter__"] = ((work[date_col].dt.month - 4) % 12) // 3 + 1
        work = work[work["__fy_quarter__"].isin([1, 2])]
        grouped = work.groupby([product_col, "__fy_quarter__"]).agg(
            Sales=(sales_col, "sum"),
            Profit=(profit_col, "sum"),
            Taxable=(taxable_col, "sum")
        )
        records = []
        for product in sorted(work[product_col].dropna().astype(str).unique()):
            p1 = grouped.loc[(product, 1)] if (product, 1) in grouped.index else None
            p2 = grouped.loc[(product, 2)] if (product, 2) in grouped.index else None
            if p1 is None or p2 is None:
                continue
            s1, s2 = float(p1["Sales"]), float(p2["Sales"])
            m1 = float(p1["Profit"] / p1["Taxable"] * 100) if p1["Taxable"] else None
            m2 = float(p2["Profit"] / p2["Taxable"] * 100) if p2["Taxable"] else None
            if m1 is not None and m2 is not None and s2 < s1 and m2 > m1:
                records.append({
                    "Product": product,
                    "Q1 Sales": s1, "Q2 Sales": s2,
                    "Sales Change %": ((s2 - s1) / s1 * 100) if s1 else None,
                    "Q1 Profit Margin %": m1, "Q2 Profit Margin %": m2,
                    "Margin Change pp": m2 - m1
                })
        records.sort(key=lambda r: (r["Margin Change pp"], -r["Sales Change %"]), reverse=True)
        display = [[r["Product"], _fmt("sales", r["Q1 Sales"]),
                    _fmt("sales", r["Q2 Sales"]), _fmt("pct", r["Sales Change %"]),
                    _fmt("share", r["Q1 Profit Margin %"]),
                    _fmt("share", r["Q2 Profit Margin %"]),
                    _fmt("pct", r["Margin Change pp"])]
                   for r in records]
        answer = _table(
            "Products with lower sales but higher profit margin",
            ["Product", "Q1 Sales", "Q2 Sales", "Sales Change",
             "Q1 Margin", "Q2 Margin", "Margin Change (pp)"], display
        )
        answer += "\n- Financial year: FY%d-%02d (April to March)" % (fy_start, fy_end % 100)
        answer += "\n- Profit margin calculated as total Profit / total TaxableAmount × 100"
        return _out(
            answer, table=records, table_rows=len(records),
            filtered_rows=int(len(work)),
            period_label="Q1 vs Q2 FY%d-%02d" % (fy_start, fy_end % 100),
            chart_spec={"type": "bar", "x": "Product",
                        "series": ["Q1 Sales", "Q2 Sales"], "interactive": True,
                        "data": records}
        )



    # CATEGORY_PROFIT_FY_QUARTER_GENERIC_V1
    # Handles one or two explicitly requested financial quarters.
    category_profit_request = (
        bool(re.search(r"\bprofit\b", q))
        and bool(re.search(r"\bcategory\b", q))
        and bool(re.search(r"\bq[1-4]\b", q))
        and bool(re.search(r"\bfy\s*20\d{2}\s*[-/]\s*\d{2,4}\b", q))
    )

    if category_profit_request and date_col and profit_col and category_col:
        refs = list(re.finditer(
            r"\bQ([1-4])\s*(?:of\s*)?FY\s*(20\d{2})\s*[-/]\s*(\d{2,4})\b",
            q, re.I
        ))

        available_categories = sorted(
            df[category_col].dropna().astype(str).str.strip().unique(),
            key=len,
            reverse=True
        )
        selected_category = None
        for candidate in available_categories:
            if candidate and re.search(re.escape(candidate), q, re.I):
                selected_category = candidate
                break

        if selected_category and refs:
            work = df.copy()
            work[date_col] = _to_dt(work[date_col])
            work["__profit__"] = numeric(work, profit_col)
            work["__category__"] = (
                work[category_col].astype(str).str.strip().str.casefold()
            )
            work = work[
                work["__category__"] == selected_category.casefold()
            ].dropna(subset=[date_col]).copy()

            quarter_specs = []
            for ref in refs[:2]:
                quarter = int(ref.group(1))
                fy_year = int(ref.group(2))
                suffix = ref.group(3)
                end_year = (
                    int(suffix) if len(suffix) == 4
                    else (fy_year // 100) * 100 + int(suffix)
                )
                if end_year <= fy_year:
                    end_year += 100

                month = 4 + 3 * (quarter - 1)
                year = fy_year
                if month > 12:
                    month -= 12
                    year += 1

                start = pd.Timestamp(year, month, 1)
                end = start + pd.DateOffset(months=3)
                quarter_specs.append((
                    "Q%d FY%d-%02d" % (quarter, fy_year, end_year % 100),
                    start, end
                ))

            results = []
            for label, start, end in quarter_specs:
                selected = work[
                    (work[date_col] >= start) & (work[date_col] < end)
                ]
                results.append({
                    "Financial Quarter": label,
                    "Category": selected_category,
                    "Total Profit": float(selected["__profit__"].sum()),
                    "Transactions": int(len(selected)),
                })

            if len(refs) >= 2 and bool(re.search(
                r"\b(compare|comparison|versus|vs|change)\b", q
            )):
                if any(row["Transactions"] == 0 for row in results):
                    return _out(
                        "Insufficient matching records to compare both requested financial quarters.",
                        table=results,
                        table_rows=len(results),
                        filtered_rows=int(len(work)),
                        scope_notes=["Category: " + selected_category]
                    )

                first = results[0]["Total Profit"]
                second = results[1]["Total Profit"]
                difference = second - first
                pct = (difference / first * 100) if first else None

                display = [
                    [r["Financial Quarter"], _fmt("sales", r["Total Profit"]),
                     "{:,}".format(r["Transactions"])]
                    for r in results
                ]
                answer = _table(
                    "Category profit: financial-quarter comparison",
                    ["Financial Quarter", "Total Profit", "Transactions"],
                    display
                )
                answer += (
                    "\n\n- Category: " + selected_category
                    + "\n- Profit difference: " + _fmt("sales", difference)
                    + "\n- Percentage change: "
                    + ("Not calculable because the first quarter profit is zero."
                       if pct is None else _fmt("pct", pct))
                )
            else:
                r = results[0]
                if r["Transactions"] == 0:
                    return _out(
                        "Information is not available in the uploaded file for "
                        + selected_category + " in " + r["Financial Quarter"] + ".",
                        table=[],
                        table_rows=0,
                        filtered_rows=0,
                        scope_notes=["Category: " + selected_category]
                    )

                display = [[
                    r["Financial Quarter"],
                    _fmt("sales", r["Total Profit"]),
                    "{:,}".format(r["Transactions"])
                ]]
                answer = _table(
                    "Category profit for financial quarter",
                    ["Financial Quarter", "Total Profit", "Transactions"],
                    display
                )
                answer += "\n- Category: " + selected_category

            return _out(
                answer,
                table=results,
                table_rows=len(results),
                filtered_rows=int(len(work)),
                period_label=" vs ".join(r["Financial Quarter"] for r in results),
                scope_notes=[
                    "Category: " + selected_category,
                    "Financial quarters follow April to March."
                ],
                chart_spec={
                    "type": "bar",
                    "x": "Financial Quarter",
                    "series": ["Total Profit"],
                    "interactive": True,
                    "data": results
                }
            )

    # GST_FILTERED_RATIO_GENERIC_V1
    gst_ratio_request = (
        bool(re.search(r"\bigst\b", q))
        and bool(re.search(r"\btotal\s+tax\b|\bcgst\b", q))
        and bool(re.search(r"\bratio\b|\bpercentage\b|\bpercent\b|\bshare\b", q))
    )

    if gst_ratio_request:
        igst_col = col("IGST")
        cgst_col = col("CGST")
        sgst_col = col("SGST")

        if not all([igst_col, cgst_col, sgst_col]):
            return _out(
                "Required IGST, CGST or SGST columns are unavailable in the uploaded dataset.",
                table=[],
                table_rows=0
            )

        work = df.copy()

        # Apply exact PartyType filter when the query names one.
        if party_type_col:
            party_match = re.search(
                r"\b(retail\s+customer|b2b\s+dealer|wholesale\s+distributor|online\s+marketplace\s+buyer)s?\b",
                q, re.I
            )
            if party_match:
                wanted_party = re.sub(r"\s+", " ", party_match.group(1)).casefold()
                actual_party = work[party_type_col].astype(str).str.strip().str.casefold()
                work = work[actual_party == wanted_party]

        # Apply exact state filter when the query names a state.
        if state_col:
            states = sorted(
                df[state_col].dropna().astype(str).str.strip().unique(),
                key=len,
                reverse=True
            )
            wanted_state = next(
                (v for v in states if v and re.search(re.escape(v), q, re.I)),
                None
            )
            if wanted_state:
                work = work[
                    work[state_col].astype(str).str.strip().str.casefold()
                    == wanted_state.casefold()
                ]
            elif re.search(
                r"\b(andhra pradesh|arunachal pradesh|assam|bihar|chhattisgarh|"
                r"goa|gujarat|haryana|himachal pradesh|jharkhand|karnataka|"
                r"kerala|madhya pradesh|maharashtra|manipur|meghalaya|mizoram|"
                r"nagaland|odisha|punjab|rajasthan|sikkim|tamil nadu|telangana|"
                r"tripura|uttar pradesh|uttarakhand|west bengal)\b", q, re.I
            ):
                work = work.iloc[0:0]

        if work.empty:
            return _out(
                "No matching records were found for the requested PartyType and State. "
                "The IGST-to-total-tax ratio cannot be calculated.",
                table=[],
                table_rows=0,
                filtered_rows=0
            )

        igst = float(numeric(work, igst_col).sum())
        cgst = float(numeric(work, cgst_col).sum())
        sgst = float(numeric(work, sgst_col).sum())
        total_tax = igst + cgst + sgst

        if total_tax == 0:
            return _out(
                "Matching records exist, but total tax is zero. The ratio cannot be calculated.",
                table=[],
                table_rows=0,
                filtered_rows=int(len(work))
            )

        ratio = igst / total_tax * 100
        records = [{
            "IGST": igst,
            "CGST": cgst,
            "SGST": sgst,
            "Total Tax": total_tax,
            "IGST to Total Tax %": ratio
        }]
        display = [[
            _fmt("gst", igst),
            _fmt("gst", cgst),
            _fmt("gst", sgst),
            _fmt("gst", total_tax),
            _fmt("share", ratio)
        ]]
        answer = _table(
            "IGST share of total tax",
            ["IGST", "CGST", "SGST", "Total Tax", "IGST / Total Tax"],
            display
        )
        return _out(
            answer,
            table=records,
            table_rows=1,
            filtered_rows=int(len(work)),
            scope_notes=["Ratio = IGST / (IGST + CGST + SGST) × 100"]
        )

    # HIGHEST_MONTHLY_IGST_GENERIC_V1
    highest_igst_month_request = (
        bool(re.search(r"\bigst\b", q))
        and bool(re.search(r"\b(highest|maximum|max|largest|most)\b", q))
        and bool(re.search(r"\bmonth\b", q))
    )

    if highest_igst_month_request and date_col:
        igst_col = col("IGST")
        if not igst_col:
            return _out("IGST column is unavailable in the uploaded dataset.", table=[])

        work = df.copy()

        if party_type_col:
            party_match = re.search(
                r"\b(retail\s+customer|b2b\s+dealer|wholesale\s+distributor|online\s+marketplace\s+buyer)s?\b",
                q, re.I
            )
            if party_match:
                wanted_party = re.sub(r"\s+", " ", party_match.group(1)).casefold()
                work = work[
                    work[party_type_col].astype(str).str.strip().str.casefold()
                    == wanted_party
                ]

        if state_col:
            states = sorted(
                df[state_col].dropna().astype(str).str.strip().unique(),
                key=len,
                reverse=True
            )
            wanted_state = next(
                (v for v in states if v and re.search(re.escape(v), q, re.I)),
                None
            )
            if wanted_state:
                work = work[
                    work[state_col].astype(str).str.strip().str.casefold()
                    == wanted_state.casefold()
                ]
            elif re.search(
                r"\b(andhra pradesh|arunachal pradesh|assam|bihar|chhattisgarh|"
                r"goa|gujarat|haryana|himachal pradesh|jharkhand|karnataka|"
                r"kerala|madhya pradesh|maharashtra|manipur|meghalaya|mizoram|"
                r"nagaland|odisha|punjab|rajasthan|sikkim|tamil nadu|telangana|"
                r"tripura|uttar pradesh|uttarakhand|west bengal)\b", q, re.I
            ):
                work = work.iloc[0:0]

        work[date_col] = _to_dt(work[date_col])
        work["__igst__"] = numeric(work, igst_col)
        work = work.dropna(subset=[date_col])

        if work.empty:
            return _out(
                "No matching records were found for the requested PartyType and State. "
                "The highest IGST month cannot be determined.",
                table=[],
                table_rows=0,
                filtered_rows=0
            )

        monthly = work.groupby(work[date_col].dt.to_period("M"))["__igst__"].sum()
        if monthly.empty:
            return _out("No monthly IGST data is available.", table=[], table_rows=0)

        peak = monthly.idxmax()
        peak_value = float(monthly.loc[peak])
        records = [{
            "Month": peak.strftime("%B %Y"),
            "IGST": peak_value
        }]
        answer = _table(
            "Month with highest IGST collection",
            ["Calendar Month", "IGST"],
            [[peak.strftime("%B %Y"), _fmt("gst", peak_value)]]
        )
        return _out(
            answer,
            table=records,
            table_rows=1,
            filtered_rows=int(len(work)),
            period_label=peak.strftime("%B %Y"),
            highest_month=peak.strftime("%Y-%m")
        )


    # SKU_GROSS_REVENUE_WITH_MARGIN_THRESHOLD_V1
    # Rank individual products by aggregated gross revenue after applying
    # a profit-margin threshold. No product names are hardcoded.
    margin_threshold_match = re.search(
        r"\b(?:below|less\s+than|under|<)\s*(\d+(?:\.\d+)?)\s*%?",
        q,
        re.I,
    )

    sku_margin_rank_request = (
        bool(re.search(r"\b(?:sku|products?|items?)\b", q))
        and bool(re.search(
            r"\b(?:highest|greatest|maximum|largest|top)\b", q
        ))
        and bool(re.search(
            r"\b(?:gross\s+revenue|gross\s+sales|revenue|sales)\b", q
        ))
        and bool(re.search(r"\bprofit[\s-]*margin\b", q))
        and margin_threshold_match is not None
    )

    qty_col = col("Qty", "Quantity", "Units")

    if (
        sku_margin_rank_request
        and product_col
        and sales_col
        and profit_col
        and qty_col
    ):
        threshold = float(margin_threshold_match.group(1))

        work = df[
            [product_col, sales_col, profit_col, qty_col]
        ].copy()

        work["__product_key__"] = (
            work[product_col].astype(str).str.strip().str.casefold()
        )
        work["__gross__"] = numeric(work, sales_col)
        work["__profit__"] = numeric(work, profit_col)
        work["__qty__"] = numeric(work, qty_col)

        work = work[
            work["__product_key__"].ne("")
            & work["__product_key__"].ne("nan")
        ].copy()

        grouped = work.groupby("__product_key__", as_index=False).agg(
            Product=(product_col, "first"),
            GrossRevenue=("__gross__", "sum"),
            TotalProfit=("__profit__", "sum"),
            UnitsSold=("__qty__", "sum"),
        )

        grouped["ProfitMarginPct"] = (
            grouped["TotalProfit"]
            .div(grouped["GrossRevenue"].where(grouped["GrossRevenue"] != 0))
            * 100
        )

        eligible = grouped[
            grouped["ProfitMarginPct"].notna()
            & (grouped["GrossRevenue"] > 0)
            & (grouped["ProfitMarginPct"] < threshold)
        ].copy()

        if eligible.empty:
            answer = (
                "No SKU matched the requested profit-margin condition "
                f"(below {threshold:g}%)."
            )
            return _out(
                answer,
                table=[],
                table_rows=0,
                filtered_rows=int(len(df)),
                scope_notes=[
                    f"Profit margin = total Profit / total GrossAmount * 100",
                    f"Required margin: below {threshold:g}%",
                ],
            )

        eligible = eligible.sort_values(
            ["GrossRevenue", "Product"],
            ascending=[False, True],
            kind="stable",
        )

        winner = eligible.iloc[0]
        product_name = str(winner["Product"]).strip()
        gross_revenue = float(winner["GrossRevenue"])
        total_profit = float(winner["TotalProfit"])
        margin_pct = float(winner["ProfitMarginPct"])
        units_sold = float(winner["UnitsSold"])
        average_price = (
            gross_revenue / units_sold if units_sold else None
        )

        record = {
            "Product": product_name,
            "Gross Revenue": gross_revenue,
            "Total Profit": total_profit,
            "Profit Margin %": margin_pct,
            "Units Sold": units_sold,
            "Average Selling Price": average_price,
        }

        display = [[
            product_name,
            _fmt("sales", gross_revenue),
            _fmt("sales", total_profit),
            _fmt("share", margin_pct),
            "{:,.0f}".format(units_sold),
            "-" if average_price is None else _fmt("sales", average_price),
        ]]

        answer = (
            f"Top SKU: {product_name}\n\n"
            + _table(
                "Highest gross-revenue SKU below the profit-margin threshold",
                [
                    "Product",
                    "Gross Revenue",
                    "Total Profit",
                    "Profit Margin",
                    "Units Sold",
                    "Average Selling Price",
                ],
                display,
            )
            + "\n- Margin calculated as total Profit / total GrossAmount * 100."
            + f"\n- Eligibility condition: profit margin below {threshold:g}%."
        )

        return _out(
            answer,
            table=[record],
            table_rows=1,
            filtered_rows=int(len(df)),
            aggregate_column=sales_col,
            aggregate_function="group_rank",
            group_by=product_col,
            period_label="Entire uploaded dataset",
            scope_notes=[
                "Products grouped by normalized SKU/product name.",
                "Gross revenue and profit aggregated before calculating margin.",
                f"Profit margin threshold: below {threshold:g}%.",
            ],
            chart_spec={
                "type": "bar",
                "x": "Product",
                "series": ["Gross Revenue"],
                "interactive": True,
                "data": [{
                    "Product": product_name,
                    "Gross Revenue": gross_revenue,
                }],
            },
        )

    return None



_handle_core = handle


def handle(question, df, skip_entity=False):
    # Run narrowly-scoped deterministic fixes before the generic analytics engine.
    out = _handle_targeted_sales_gst_fy_queries(question, df)
    if out is None:
        out = _handle_core(question, df, skip_entity)
    if out is None:
        return None

    result = out.setdefault("result", {})
    result.setdefault("operation", "engine")

    # Keep aggregate metadata consistent with the actual result.
    result_column = result.get("aggregate_column")

    # Resolve source column from the metric explicitly requested.
    question_text = str(question or "").lower()

    # A multi-metric request has no single aggregate source column.
    # Keep metadata aligned with the actual two-or-more metrics returned.
    asks_sales = bool(re.search(r"\b(?:sales?|revenue|turnover)\b", question_text))
    asks_profit = bool(re.search(r"\b(?:profit|munafa)\b", question_text))
    asks_quantity = bool(re.search(r"\b(?:quantity|qty|units)\b", question_text))
    requested_metric_count = sum((asks_sales, asks_profit, asks_quantity))
    if requested_metric_count >= 2:
        result["aggregate_column"] = None
        result["aggregate_function"] = "multi"
        result["aggregate_metrics"] = [
            name for name, requested in (
                ("GrossAmount", asks_sales),
                ("Profit", asks_profit),
                ("Qty", asks_quantity),
            ) if requested
        ]
        out["aggregate_column"] = None
        out["aggregate_function"] = "multi"
        out["aggregate_metrics"] = list(result["aggregate_metrics"])
        result_column = None

    if re.search(
        r"\b(?:total\s+invoice\s+with\s+gst|"
        r"invoice\s+(?:value|amount|total)\s+with\s+gst)\b",
        question_text,
    ):
        result_column = "InvoiceTotal"
    elif re.search(
        r"\b(?:gst\s+amount|total\s+gst|gst\s+total)\b",
        question_text,
    ):
        result_column = "TotalGST"

    if result_column:
        result["aggregate_column"] = result_column
        out["aggregate_column"] = result_column
        out["aggregate_function"] = "sum"
        result["aggregate_function"] = "sum"

    # Invoice totals must not inherit stale GST metadata.
    if (
        result.get("aggregate_column") == "InvoiceTotal"
        and result.get("operation") == "engine"
    ):
        out["aggregate_column"] = "InvoiceTotal"
        out["aggregate_function"] = "sum"


    # Preserve the actual source column for invoice totals.
    if re.search(
        r"\b(?:total\s+invoice\s+with\s+gst|"
        r"invoice\s+(?:value|amount|total)\s+with\s+gst)\b",
        question,
        re.IGNORECASE,
    ):
        result["aggregate_column"] = "InvoiceTotal"
        out["aggregate_column"] = "InvoiceTotal"
        out["aggregate_function"] = "sum"


    table = result.get("table")
    if isinstance(table, list):
        result.setdefault("table_rows", len(table))

    # Only derive a scalar when the result unambiguously contains one total.
    # Normalize the financial-year QoQ heading even if an upstream text
    # normalizer accidentally removes the separating whitespace.
    if isinstance(out.get("answer"), str):
        out["answer"] = re.sub(
            r"financial-year\s*QoQ",
            "financial-year QoQ",
            out["answer"],
            flags=re.IGNORECASE,
        )

    # The public answer is the canonical formatted text. Keep the nested
    # engine_answer in sync so report consumers do not show stale labels
    # such as "TotalProfit" when the chat answer correctly says "Total Profit".
    if isinstance(out.get("answer"), str):
        result["engine_answer"] = out["answer"]

    if result.get("value") is None:
        totals = result.get("totals")
        if isinstance(totals, dict) and len(totals) == 1:
            result["value"] = next(iter(totals.values()))
        elif result.get("total_value") is not None and result.get("chart_spec", {}).get("type") == "pie":
            result["value"] = result["total_value"]

    if result.get("total_value") is None and result.get("value") is not None:
        result["total_value"] = result["value"]

    # Create a chart only from a usable structured table.
    if not result.get("chart_spec") and isinstance(table, list) and len(table) > 1:
        first = next((row for row in table if isinstance(row, dict)), None)
        if first:
            numeric_keys = [
                key for key, value in first.items()
                if isinstance(value, (int, float)) and not isinstance(value, bool)
            ]
            x_key = next((key for key in first if key not in numeric_keys), None)
            if x_key and numeric_keys:
                result["chart_spec"] = {
                    "type": "bar",
                    "x": x_key,
                    "series": numeric_keys,
                    "interactive": True,
                    "data": table,
                }

    try:
        _q, fixes = _fix_typos(
            str(question or "").lower().replace("\u2019", "'"), df
        )
    except Exception:
        fixes = []

    if fixes:
        note = "Interpreted as: " + ", ".join("%s → %s" % f for f in fixes)
        out["answer"] += "\n- " + note
        result["engine_answer"] = out["answer"]
        result["spelling_fixes"] = [
            {"from": a, "to": b} for a, b in fixes
        ]

    return out




_ALT_CACHE = {}


def _all_dataset_ids(current_id=None):
    import graph.dynamic_nodes as dn
    for name in dir(dn):
        low = name.lower()
        if "dataset" in low and any(k in low for k in ("list", "all", "fetch")) and callable(getattr(dn, name)):
            try:
                res = getattr(dn, name)()
            except Exception:
                continue
            if isinstance(res, (list, tuple)):
                ids = [int(r["id"]) for r in res if isinstance(r, dict) and r.get("id") is not None]
                if ids:
                    return ids
    if current_id is not None:
        return list(range(max(1, int(current_id) - 15), int(current_id) + 16))
    return []


def _frame(did):
    from graph.dynamic_nodes import load_dataset_rows
    rows = load_dataset_rows(int(did))
    rows = [(r.get("row_data") or r.get("data") or r) if isinstance(r, dict) else r for r in rows]
    return pd.DataFrame(rows)


def _alt_frame(q, current_id):
    met = _metric(q)
    if not met:
        return None
    key = (tuple(m[1] for m in met), current_id)
    if key in _ALT_CACHE:
        return _ALT_CACHE[key]
    best, best_score = None, -1
    for did in _all_dataset_ids(current_id):
        if did == current_id:
            continue
        try:
            f = _frame(did)
        except Exception:
            continue
        if f is None or f.empty:
            continue
        score = sum(1 for m in met if _col(list(f.columns), m[2]))
        if score == len(met) and (best is None or score > best_score or (score == best_score and len(f) > len(best))):
            best, best_score = f, score
    _ALT_CACHE[key] = best
    return best


def _defer_to_engine(question):
    """Invoice-count questions that also ask for another metric are left to the older dynamic query engine
    (this was added in the user's own version of the module and is kept as-is)."""
    # EXPLICIT_DERIVED_FORMULA_DEFER_V1:
    # Explicit derived formulas must use the universal semantic planner.
    explicit_derived_formula = bool(
        re.search(
            r"\b(?:average\s+invoice\s+value|"
            r"quantity[\s-]+weighted|weighted\s+average)\b",
            question or "",
            re.IGNORECASE,
        )
    )

    if explicit_derived_formula:
        return True

    if average_cue and discount_percentage_cue:
        return True

    return has_invoice_count and has_other_metric and needs_engine


def _run_full(state):
    """returns (out, corrected_question_or_None). corrected_question is set when misspelt words were repaired,
    so the older pipeline can use the repaired text if this module has no answer."""
    q = state.get("original_question") or state.get("question") or ""
    if _defer_to_engine(q):
        return None, None
    ds = state.get("dataset") or {}
    did = state.get("dataset_id") or ds.get("id")
    rows = state.get("rows") or []
    print(
        "[EXTRA DEBUG] STATE ROWS:",
        len(rows),
        "| DATASET ID:",
        did,
        "| DATASET TYPE:",
        state.get("dataset_type"),
    )
    if not rows and did is not None:
        from graph.dynamic_nodes import load_dataset_rows
        rows = load_dataset_rows(int(did))
    rows = [
        (r.get("row_data") or r.get("data") or r)
        if isinstance(r, dict) else r
        for r in rows
    ]

    # Convert loaded dataset rows into DataFrame
    frame = pd.DataFrame(rows)

    qlow = str(q).lower()
    corrected = None
    if not frame.empty:
        try:
            fixed, fixes = _fix_typos(qlow.replace("\u2019", "'"), frame)
            if fixes:
                corrected = fixed
        except Exception:
            corrected = None
    met = _metric(qlow if corrected is None else corrected)
    out = None
    if met and not frame.empty and any(not _col(list(frame.columns), m[2]) for m in met):
        alt = _alt_frame(qlow if corrected is None else corrected, int(did) if did is not None else None)
        if alt is not None:
            out = handle(q, alt)
            return out, corrected
    out = handle(q, frame)
    return out, corrected


def run(state):
    return _run_full(state)[0]


def _with_corrected(state, corrected):
    if not corrected:
        return state
    new = dict(state)
    new["question"] = corrected
    if state.get("original_question"):
        new["original_question"] = corrected
    return new


def wrap_planner(fn):
    def inner(state):
        try:
            out, corrected = _run_full(state)
        except Exception as exc:
            print("[EXTRA PLANNER-SKIP ERROR]", type(exc).__name__, exc)
            out, corrected = None, None
        if out is None:
            return fn(_with_corrected(state, corrected))
        plan = {"status": "OK", "operation": "engine", "filters": [],
                "reason": "Deterministic analytics_extra (LLM skipped)"}
        return {**state, "query_plan": plan, "result": out["result"], "error": None}
    return inner


def wrap_extra(fn):
    def inner(state):
        r = state.get("result")
        if isinstance(r, dict) and r.get("engine_answer"):
            return state
        try:
            out, corrected = _run_full(state)
        except Exception as exc:
            print("[EXTRA ERROR]", type(exc).__name__, exc)
            out, corrected = None, None
        if out is None:
            return fn(_with_corrected(state, corrected))
        return {**state, "result": out["result"], "error": None}
    return inner


# UNIVERSAL_SCOPED_ENGINE_V2: run the exact-scope engine before the older handlers in this module.
_handle_before_universal = handle


def handle(question, df, skip_entity=False):
    # CATEGORY_METRIC_COMPARISON_V1:
    # Run the verified category comparison before universal entity filtering.
    try:
        targeted = _handle_targeted_sales_gst_fy_queries(question, df)
        if targeted is not None:
            return targeted
    except Exception as exc:
        print("[CATEGORY-METRIC-COMPARISON-SKIP]", type(exc).__name__, exc)

    try:
        from services.semantic_query_service import _uq_universal_core, _clean
        core = _uq_universal_core(_clean(df), question)
        if core:
            res = {"operation": "engine", "engine_answer": core["answer"], "table": core["rows"],
                   "table_rows": len(core["rows"]), "filtered_rows": core["filtered_rows"],
                   "scope_notes": core["scope_notes"], "period_label": core["period_label"]}
            if core.get("chart_spec"):
                res["chart_spec"] = core["chart_spec"]
            return {"answer": core["answer"], "result": res}
    except Exception as exc:
        print("[UNIVERSAL-SCOPE-SKIP]", type(exc).__name__, exc)
    return _handle_before_universal(question, df, skip_entity)